# {{ ansible_managed }}
[Unit]
Description=Finalize deferred encrypted-swap activation (drop plaintext backing swap)
# After swap.target so both boot-race contenders have been attempted. No
# mapper-exists condition: the recovery arm must run precisely when cryptsetup
# lost the race; the unit gates itself on the crypttab entry below.
ConditionPathExists=/etc/crypttab
After=swap.target systemd-cryptsetup@{{ encrypted_swap_mapper_name }}.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/encrypted-swap-finalize.sh

[Install]
WantedBy=multi-user.target
