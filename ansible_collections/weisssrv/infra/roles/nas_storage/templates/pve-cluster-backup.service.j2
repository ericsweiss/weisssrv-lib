# {{ ansible_managed }}
[Unit]
Description=Archive /etc/pve (PVE cluster identity) into the offsite-eligible landing zone
# Ordering ONLY. `Wants=` does not fail this unit when the mount job fails, and
# the timer's Persistent=true fires a missed run on boot. The fail-closed check
# is a `mountpoint -q` in the script, deliberately NOT ConditionPathIsMountPoint=:
# a failed Condition skips ExecStart, so no textfile metric is written and the
# success gauge never flips to 0. The script guard exits non-zero AND records it.
After=zfs.target zfs-mount.service zfs-mount-encrypted.service
Wants=zfs-mount-encrypted.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pve-cluster-backup.sh
# Tiny job, but kept as deferential as every other nightly so it can never
# compete with the archive/offsite chain.
Nice={{ nas_storage_pve_cluster_backup_nice }}
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=20
IOWeight=20
# /etc/pve is a FUSE mount and the destination is on ZFS; a private mount
# namespace (ProtectSystem/PrivateTmp) would hide both — same constraint as
# media-mover.service.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
