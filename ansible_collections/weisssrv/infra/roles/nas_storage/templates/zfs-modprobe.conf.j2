# {{ ansible_managed }}
# ZFS kernel module parameters (managed by the nas_storage role).
#
# zfs_arc_max caps the ARC in bytes. It is a load-time module parameter, and
# the data pools import from the initramfs at early boot, so the value is baked
# into the initramfs (update-initramfs handler) — otherwise the ARC would grow
# to the ~half-RAM default before this file is read and swap-thrash the pinned
# guests on a memory-over-committed host.
options zfs zfs_arc_max={{ nas_storage_zfs_arc_max_bytes }}
