# {{ ansible_managed }}
# All drives explicitly listed - no DEVICESCAN, which aborts long self-tests on
# standby drives. smartd.yml fails the deploy on an unmonitored pool member.

{% for group in nas_storage_smartd_disk_groups | default([]) %}
{% if group.disks | default([]) | length > 0 %}
# {{ group.name }}
{% for disk in group.disks %}
{{ disk }} -a{% if group.ata | default(true) %} -o on -S on{% endif %} -s {{ group.schedule }}{% if group.extra_flags is defined %} {{ group.extra_flags }}{% endif %} -m root
{% endfor %}

{% endif %}
{% endfor %}
