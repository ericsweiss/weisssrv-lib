# {{ ansible_managed }}
[Unit]
Description=Replicate ZFS datasets to archive pool
# Ordered after both ZFS mount passes. Best-effort tidiness, not correctness:
# raw `zfs send -w` needs neither key nor mount, and the script probes each
# source for presence before replicating.
After=zfs-mount.service zfs-mount-encrypted.service
{% if nas_storage_archive_backup_on_success_units | default([]) | length > 0 %}
# Hands off to the offsite backup on a successful run (systemd >= 249).
OnSuccess={{ nas_storage_archive_backup_on_success_units | join(' ') }}
{% endif %}

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/archive-backupctl run
