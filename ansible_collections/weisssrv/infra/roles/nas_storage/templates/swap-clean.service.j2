# {{ ansible_managed }}
[Unit]
Description=Reset accumulated NAS swap (near-capacity host)
After=zfs.target zfs-mount.service

[Service]
Type=oneshot
# Start: above the sum of the stop-guest timeouts plus swapoff and the restarts.
# Stop: the EXIT trap's budget to restart every stopped guest and restore ARC.
TimeoutStartSec={{ nas_storage_swap_clean_service_timeout }}
TimeoutStopSec={{ nas_storage_swap_clean_stop_timeout }}
KillMode=mixed
# Low priority — memory hygiene, never urgent. Same load-shaping as media-mover.
Nice={{ nas_storage_swap_clean_nice }}
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=20
IOWeight=20
# No mount-namespace hardening: the script writes /sys/module/zfs/parameters and
# calls swapoff/swapon.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
ExecStart=/usr/local/sbin/swap-clean.sh
{% if nas_storage_zfs_arc_max_bytes | default('') | string | length > 0 %}
# Restores the ARC cap even when the script is SIGKILLed, which its EXIT trap
# cannot cover. `-` so a failure here never marks the unit failed.
ExecStopPost=-/bin/sh -c '[ -w /sys/module/zfs/parameters/zfs_arc_max ] && echo {{ nas_storage_zfs_arc_max_bytes }} > /sys/module/zfs/parameters/zfs_arc_max'
{% endif %}
