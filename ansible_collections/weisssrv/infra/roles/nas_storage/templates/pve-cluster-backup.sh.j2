#!/usr/bin/env bash
# {{ ansible_managed }}
# Nightly tar of /etc/pve (pmxcfs) into the offsite-eligible landing zone;
# vzdump covers guests, not the cluster filesystem. Key material: 0700/0600.
set -Eeuo pipefail
export LC_ALL=C
SRC={{ nas_storage_pve_cluster_backup_src | quote }}
DEST_DIR={{ (nas_storage_backup_apps_base ~ '/pve-cluster') | quote }}
# The dataset that must be MOUNTED before anything is written under it, and
# whether to enforce that (0 only where the path is not a mount by design).
BACKUPS_MOUNT={{ nas_storage_backup_apps_base | dirname | quote }}
REQUIRE_MOUNT={{ '1' if (nas_storage_backup_require_mounted_dataset | default(true) | bool) else '0' }}
# Same question on the SOURCE side: /etc/pve is the pmxcfs FUSE mountpoint.
REQUIRE_SRC_MOUNT={{ '1' if (nas_storage_pve_cluster_backup_require_src_mount | default(true) | bool) else '0' }}
KEEP={{ nas_storage_pve_cluster_backup_keep | int }}
PROM_DIR={{ nas_storage_backup_artifact_metrics_dir | quote }}
METRICS_LIB={{ nas_storage_pve_cluster_backup_lib_path | quote }}
# Files (relative to SRC) that must be INSIDE the archive before it is published
# — the content half of the two mount guards below. See
# nas_storage_pve_cluster_backup_required_files.
REQUIRED_FILES=(
{% for required in nas_storage_pve_cluster_backup_required_files %}
  {{ required | quote }}
{% endfor %}
)
{% raw %}
PROM_FILE="${PROM_DIR}/pve_cluster_backup.prom"
# tar stores paths relative to /, and the required-files check matches them
# exactly. Derived once so the two cannot disagree over a trailing slash.
SRC_REL="${SRC#/}"
SRC_REL="${SRC_REL%/}"

log() { echo "[$(date -Is)] $*"; }

# Shared write_prom_metrics (deployed by the compose_app backup_lib task file):
# write_prom_metrics <prefix> <success> <duration> <size> <prom_file> [glob]
if [ ! -r "$METRICS_LIB" ]; then
  echo "pve-cluster-backup: metrics library $METRICS_LIB missing - re-run the nas_storage role" >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$METRICS_LIB"

run_success=0
run_size=0
# Cleared when the landing zone proves unreachable: sizing a shadow copy on the
# root fs would report a healthy artefact for a landing zone nothing can reach.
trust_existing_archives=1
_START_TS="$(date +%s)"

# The artefact glob is dropped once the landing zone proves unreachable: a stale
# shadow archive there must not be sized into a healthy-looking last_size_bytes.
cleanup() {
  local now
  now="$(date +%s)"
  if [ "$trust_existing_archives" -eq 1 ]; then
    write_prom_metrics pve_cluster_backup "$run_success" "$(( now - _START_TS ))" \
      "$run_size" "$PROM_FILE" "${DEST_DIR}/etc-pve-*.tar.gz"
  else
    write_prom_metrics pve_cluster_backup "$run_success" "$(( now - _START_TS ))" \
      "$run_size" "$PROM_FILE"
  fi
}
trap cleanup EXIT

mkdir -p "$PROM_DIR"

if [ ! -d "$SRC" ]; then
  log "source ${SRC} is absent — not a PVE cluster member; nothing to archive"
  exit 1
fi

# /etc/pve is FUSE: with pve-cluster down the path is an empty dir that tars into
# a valid archive of nothing, published as success while retention retires a real
# archive.
if [ "$REQUIRE_SRC_MOUNT" = "1" ] && ! mountpoint -q "$SRC"; then
  log "source ${SRC} is not a mounted pmxcfs — refusing to archive an empty mountpoint over the good archives"
  exit 1
fi

# An unmounted landing zone would shadow-write key material onto the root
# filesystem and still report success; those archives are then invisible to KEEP
# retention.
if [ "$REQUIRE_MOUNT" = "1" ] && ! mountpoint -q "$BACKUPS_MOUNT"; then
  # Distrust whatever is under DEST_DIR before the EXIT trap writes metrics: a
  # stale shadow archive there must not be sized into a healthy-looking
  # *_last_size_bytes and suppress the empty-landing-zone signal.
  trust_existing_archives=0
  log "landing zone ${BACKUPS_MOUNT} is not a mounted dataset — refusing to archive ${SRC} onto the root filesystem"
  exit 1
fi

# The landing dir must NOT be group/world readable: the archive contains
# /etc/pve/priv (cluster CA key, node certs, authkey).
mkdir -p "$DEST_DIR"
chown root:root "$DEST_DIR"
chmod 0700 "$DEST_DIR"

out="${DEST_DIR}/etc-pve-$(date +%Y%m%d-%H%M%S).tar.gz"
tmp="${out}.tmp"

# pmxcfs is FUSE: sizes change under tar and "file changed as we read it" is
# exit 1 with a valid archive, so only exit >1 is fatal. -C / with a relative
# path so the archive unpacks predictably.
rc=0
tar --warning=no-file-changed -czf "$tmp" -C / "${SRC_REL}" || rc=$?
if [ "$rc" -gt 1 ]; then
  log "tar failed (rc=${rc}) archiving ${SRC}"
  rm -f "$tmp"
  exit 1
fi

# A 0-byte or unreadable archive is a failure, not a success.
if [ ! -s "$tmp" ]; then
  log "produced an empty archive — refusing to publish it"
  rm -f "$tmp"
  exit 1
fi
if ! listing="$(tar -tzf "$tmp" 2>/dev/null)"; then
  log "produced an unreadable archive — refusing to publish it"
  rm -f "$tmp"
  exit 1
fi

# Valid framing is not a restorable backup: every declared cluster-identity file
# must be in the listing.
for required in "${REQUIRED_FILES[@]}"; do
  if ! grep -Fxq -- "${SRC_REL}/${required}" <<<"$listing"; then
    log "archive is missing required cluster identity file ${required} — refusing to publish it"
    rm -f "$tmp"
    exit 1
  fi
done

chmod 0600 "$tmp"
mv "$tmp" "$out"
run_size="$(stat -c %s "$out" 2>/dev/null || echo 0)"
log "wrote ${out} (${run_size} bytes)"

# Retention: keep the newest $KEEP archives. Names are timestamped (no spaces),
# so the glob + ls sort is safe.
# shellcheck disable=SC2012 # ls -t for mtime order; names are generated + safe
ls -t "${DEST_DIR}"/etc-pve-*.tar.gz 2>/dev/null | tail -n "+$(( KEEP + 1 ))" | while IFS= read -r old; do
  [ -n "$old" ] || continue
  rm -f -- "$old"
  log "pruned ${old}"
done

run_success=1
{% endraw %}
