#!/usr/bin/env bash
# {{ ansible_managed }}
# Nightly tar of /etc/pve (pmxcfs) into the offsite-eligible landing zone, so it
# rides the archive file walk out with the logical dumps.
#
# vzdump captures GUESTS, not the cluster filesystem: user.cfg (PVE
# users/ACLs/API tokens), corosync.conf and priv/ (cluster CA + key, node certs,
# authkey) live only here. Without this archive a total-cluster loss means
# rebuilding the cluster IDENTITY from scratch. pmxcfs is cluster-shared, so
# taking it from one node covers the cluster.
#
# The archive holds private key material, which is why the landing dir and every
# archive are root-only 0700/0600.
{% raw %}
set -Eeuo pipefail
export LC_ALL=C
{% endraw %}
SRC="{{ nas_storage_pve_cluster_backup_src }}"
DEST_DIR="{{ nas_storage_backup_apps_base }}/pve-cluster"
# The dataset that must be MOUNTED before anything is written under it, and
# whether to enforce that (0 only where the path is not a mount by design).
BACKUPS_MOUNT="{{ nas_storage_backup_apps_base | dirname }}"
REQUIRE_MOUNT={{ '1' if (nas_storage_backup_require_mounted_dataset | default(true) | bool) else '0' }}
# Same question on the SOURCE side: /etc/pve is the pmxcfs FUSE mountpoint.
REQUIRE_SRC_MOUNT={{ '1' if (nas_storage_pve_cluster_backup_require_src_mount | default(true) | bool) else '0' }}
KEEP="{{ nas_storage_pve_cluster_backup_keep }}"
PROM_DIR="{{ nas_storage_backup_artifact_metrics_dir | default(node_exporter_host_textfile_dir | default('/var/lib/node_exporter')) }}"
# Files (relative to SRC) that must be INSIDE the archive before it is published
# — the content half of the two mount guards below. See
# nas_storage_pve_cluster_backup_required_files.
REQUIRED_FILES=(
{% for required in nas_storage_pve_cluster_backup_required_files %}
  {{ required | quote }}
{% endfor %}
)
{% raw %}
PROM_FILE="${PROM_DIR}/pve_cluster_backup.prom"

log() { echo "[$(date -Is)] $*"; }

run_success=0
run_size=0
# Whether archives already in DEST_DIR may be sized when this run produced none.
# Cleared the moment the landing zone proves unreachable: everything under an
# unmounted mountpoint is a shadow copy on the root filesystem, so sizing it
# would report a healthy artefact for a landing zone nothing can reach — the
# exact state the empty-artifact alert exists to catch.
trust_existing_archives=1
_START_TS="$(date +%s)"

write_prom_metrics() {
  local ts tmp prev newest
  ts="$(date +%s)"
  tmp="${PROM_FILE}.$$"
  # Size the newest EXISTING archive, not just this run's own output: a
  # transient tar/chmod/mv failure would otherwise report 0 bytes while good
  # archives sit in the landing zone, firing the empty-artifact alert for a
  # fault this producer cannot have. run_success=0 stays the failure signal;
  # 0 bytes means what the alert says — no artefact exists at all.
  if [ "$run_size" -eq 0 ] && [ "$trust_existing_archives" -eq 1 ]; then
    # shellcheck disable=SC2012 # ls -t for mtime order; names are generated + safe
    newest="$(ls -1t "${DEST_DIR}"/etc-pve-*.tar.gz 2>/dev/null | head -1 || true)"
    if [ -n "$newest" ] && [ -f "$newest" ]; then
      run_size="$(stat -c %s "$newest" 2>/dev/null || echo 0)"
    fi
  fi
  {
    echo "# HELP pve_cluster_backup_last_run_success Whether the last /etc/pve archive run succeeded (1=success, 0=failure)"
    echo "# TYPE pve_cluster_backup_last_run_success gauge"
    echo "pve_cluster_backup_last_run_success ${run_success}"
    echo "# HELP pve_cluster_backup_last_run_duration_seconds Duration of the last /etc/pve archive run"
    echo "# TYPE pve_cluster_backup_last_run_duration_seconds gauge"
    echo "pve_cluster_backup_last_run_duration_seconds $(( ts - _START_TS ))"
    # Named *_backup_last_size_bytes so it inherits the empty-artifact alert:
    # a "successful" run that produced a 0-byte archive is a failure.
    echo "# HELP pve_cluster_backup_last_size_bytes Size of the most recent /etc/pve archive in bytes (0 = none)"
    echo "# TYPE pve_cluster_backup_last_size_bytes gauge"
    echo "pve_cluster_backup_last_size_bytes ${run_size}"
    # Preserve the last-known success timestamp on failure so staleness measures
    # time-since-last-success, not time-since-last-attempt.
    if [ "$run_success" -eq 1 ]; then
      echo "# HELP pve_cluster_backup_last_success_timestamp_seconds Unix timestamp of the last successful /etc/pve archive"
      echo "# TYPE pve_cluster_backup_last_success_timestamp_seconds gauge"
      echo "pve_cluster_backup_last_success_timestamp_seconds ${ts}"
    else
      prev="$(awk '/^pve_cluster_backup_last_success_timestamp_seconds/ {print $2}' "$PROM_FILE" 2>/dev/null || true)"
      if [ -n "$prev" ]; then
        echo "# HELP pve_cluster_backup_last_success_timestamp_seconds Unix timestamp of the last successful /etc/pve archive"
        echo "# TYPE pve_cluster_backup_last_success_timestamp_seconds gauge"
        echo "pve_cluster_backup_last_success_timestamp_seconds ${prev}"
      fi
    fi
  } > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
  mv "$tmp" "$PROM_FILE" 2>/dev/null || rm -f "$tmp"
}

cleanup() { write_prom_metrics; }
trap cleanup EXIT

mkdir -p "$PROM_DIR"

if [ ! -d "$SRC" ]; then
  log "source ${SRC} is absent — not a PVE cluster member; nothing to archive"
  exit 1
fi

# Fail closed on an unmounted SOURCE. /etc/pve is pmxcfs, a FUSE mount: with
# pve-cluster.service not running the path still EXISTS as an empty plain
# directory, and every check downstream passes on it — tar exits 0, the archive
# is valid gzip framing, `tar -tzf` reads it. That would publish ~112 bytes of
# nothing as the night's cluster-identity backup with success=1 and a non-zero
# size, while retention retires one real archive per night behind it.
if [ "$REQUIRE_SRC_MOUNT" = "1" ] && ! mountpoint -q "$SRC"; then
  log "source ${SRC} is not a mounted pmxcfs — refusing to archive an empty mountpoint over the good archives"
  exit 1
fi

# Fail closed on an unmounted landing zone: a pool root with mountpoint=none
# leaves the path a plain directory on the root filesystem, so the script would
# write /etc/pve — priv/ included — onto an unencrypted, unreplicated, never
# offsited path and still report success (the artefact collector reads the same
# shadowed directory). Those archives are then orphaned under the mountpoint
# once the dataset returns, invisible to the KEEP retention.
if [ "$REQUIRE_MOUNT" = "1" ] && ! mountpoint -q "$BACKUPS_MOUNT"; then
  # Distrust whatever is under DEST_DIR before the EXIT trap writes metrics: a
  # stale shadow archive there must not be sized into a healthy-looking
  # *_last_size_bytes and suppress the empty-landing-zone signal.
  trust_existing_archives=0
  log "landing zone ${BACKUPS_MOUNT} is not a mounted dataset — refusing to archive ${SRC} onto the root filesystem"
  exit 1
fi

# The landing dir must NOT be group/world readable: the archive contains
# /etc/pve/priv (cluster CA key, node certs, authkey).
mkdir -p "$DEST_DIR"
chown root:root "$DEST_DIR"
chmod 0700 "$DEST_DIR"

out="${DEST_DIR}/etc-pve-$(date +%Y%m%d-%H%M%S).tar.gz"
tmp="${out}.tmp"

# pmxcfs is a FUSE filesystem: file sizes can change under tar, and tar's "file
# changed as we read it" is exit 1 with a valid archive. Only a hard failure
# (exit >1) is fatal. -C / with a relative path so the archive unpacks
# predictably.
rc=0
tar --warning=no-file-changed -czf "$tmp" -C / "${SRC#/}" || rc=$?
if [ "$rc" -gt 1 ]; then
  log "tar failed (rc=${rc}) archiving ${SRC}"
  rm -f "$tmp"
  exit 1
fi

# A 0-byte or unreadable archive is a failure, not a success.
if [ ! -s "$tmp" ]; then
  log "produced an empty archive — refusing to publish it"
  rm -f "$tmp"
  exit 1
fi
if ! listing="$(tar -tzf "$tmp" 2>/dev/null)"; then
  log "produced an unreadable archive — refusing to publish it"
  rm -f "$tmp"
  exit 1
fi

# Valid framing is not evidence of a restorable backup: a mounted but degraded
# pmxcfs (or a source that is not pmxcfs at all) tars into a readable archive of
# nothing, which publishes as success and ages a real archive out per night.
# Every declared cluster-identity file must be IN it. Entries are stored
# relative to / (tar runs -C / with "${SRC#/}"), so the check is an exact match
# on that prefixed path — and reads from the listing already in hand, no second
# decompression.
archive_root="${SRC#/}"
for required in "${REQUIRED_FILES[@]}"; do
  if ! grep -Fxq -- "${archive_root}/${required}" <<<"$listing"; then
    log "archive is missing required cluster identity file ${required} — refusing to publish it"
    rm -f "$tmp"
    exit 1
  fi
done

chmod 0600 "$tmp"
mv "$tmp" "$out"
run_size="$(stat -c %s "$out" 2>/dev/null || echo 0)"
log "wrote ${out} (${run_size} bytes)"

# Retention: keep the newest $KEEP archives. Names are timestamped (no spaces),
# so the glob + ls sort is safe.
# shellcheck disable=SC2012 # ls -t for mtime order; names are generated + safe
ls -t "${DEST_DIR}"/etc-pve-*.tar.gz 2>/dev/null | tail -n "+$(( KEEP + 1 ))" | while IFS= read -r old; do
  [ -n "$old" ] || continue
  rm -f -- "$old"
  log "pruned ${old}"
done

run_success=1
{% endraw %}
