#!/usr/bin/env bash
# {{ ansible_managed }}
{% raw %}
set -Eeuo pipefail

{% endraw %}
POOL_DST="{{ nas_storage_archive_backup_pool }}"
{% raw -%}
RESTORE_BASE="/mnt/restore"
ZVOL_DEV_DIR="/dev/zvol"
SNAP_PREFIX="archsync"
{% endraw %}
# Archive scrub timer: plug enables it and unplug disables it, so scrub coverage
# tracks pool presence rather than deploy timing. The schedule token must name a
# zfs-scrub-<schedule>@ unit zfsutils-linux ships.
SCRUB_TIMER="zfs-scrub-{{ nas_storage_zfs_scrub_schedule }}@{{ nas_storage_archive_backup_pool }}.timer"
{% raw %}

# Retention: the newest N snapshots always, plus the newest snapshot of each of
# the last M calendar months (grandfather).
{% endraw %}
KEEP_RECENT={{ nas_storage_archive_backup_keep_recent | int }}
KEEP_MONTHLY={{ nas_storage_archive_backup_keep_monthly | int }}
{% raw %}
# Per-dataset monthly counts, from nas_storage_archive_backup_keep_monthly_overrides.
# Each applies to its source subtree and to that subtree's archive copy. Keys
# are shell-quoted, so no expansion runs when the array is declared.
{% endraw %}
declare -A KEEP_MONTHLY_OVERRIDES=(
{% for ds, keep in (nas_storage_archive_backup_keep_monthly_overrides | default({}, true)).items() %}
  [{{ ds | quote }}]={{ keep | int }}
{% endfor %}
)
{% raw %}
# vzdump-overrun guard for the ONE cluster-wide dump target: remote nodes write
# it over NFS, so a local pgrep sees nothing. It is snapshotted only once writes
# under its mountpoint quiesce; empty means no dataset gets the guard.
{% endraw %}
VZDUMP_TARGET="{{ nas_storage_archive_backup_vzdump_target }}"
VZDUMP_QUIESCE_MIN={{ nas_storage_archive_backup_vzdump_quiesce_min }}
VZDUMP_MAX_WAIT_MIN={{ nas_storage_archive_backup_vzdump_max_wait_min }}
{% raw %}
# Datasets to replicate, recursively; leave out anything already captured
# indirectly (a VM disk inside the vzdump target). Each ROOT must be a
# filesystem: the -R receive's -o mountpoint/canmount is rejected on a zvol.
{% endraw %}
SRC_LIST=(
{% for src in nas_storage_archive_backup_sources %}
  "{{ src }}"
{% endfor %}
)
{% raw %}
# Children left OUT of the recursive send, from
# nas_storage_archive_backup_exclude. Each entry must be a descendant of a
# SRC_LIST root; the role asserts that before the script ships.
{% endraw %}
EXCLUDE_LIST=(
{% for excluded in nas_storage_archive_backup_exclude | default([]) %}
  "{{ excluded }}"
{% endfor %}
)
{% raw %}
# Opt-in for destroying an excluded child that is already on the archive pool.
{% endraw %}
EXCLUDE_DESTROY_OK={{ nas_storage_archive_backup_exclude_destroy_ok | default(false) | bool | lower }}
{% raw %}
# `zfs send -X` takes a descendant of the dataset being sent, so the flags are
# rebuilt per source. Requires OpenZFS 2.3+; older zfs is refused rather than
# silently replicating an excluded child.
EXCLUDE_FLAGS=()
exclude_flags_for() {
  local src="$1" ex
  EXCLUDE_FLAGS=()
  for ex in "${EXCLUDE_LIST[@]}"; do
    case "$ex" in
      "$src"/*) EXCLUDE_FLAGS+=( -X "$ex" ) ;;
    esac
  done
}

is_excluded() {
  local ds="$1" ex
  for ex in "${EXCLUDE_LIST[@]}"; do
    if [[ "$ds" == "$ex" || "$ds" == "$ex"/* ]]; then
      return 0
    fi
  done
  return 1
}

# Fail loud, never silently: an exclusion the running zfs cannot honour would
# ship the excluded child to the archive.
assert_send_exclude_supported() {
  [[ ${#EXCLUDE_LIST[@]} -gt 0 ]] || return 0
  local usage version
  usage="$(zfs send 2>&1 || true)"
  # The version is logged because how `send -X` treats an existing archive
  # copy differs between zfs releases.
  case "$usage" in
    *-X*)
      version="$(zfs version 2>/dev/null || true)"
      version="${version%%$'\n'*}"
      log "Exclusion: 'send -X' supported by ${version:-an unreported zfs version}"
      return 0 ;;
  esac
  log "FATAL: nas_storage_archive_backup_exclude is set but this zfs has no 'send -X' (OpenZFS 2.3+)"
  return 1
}

# A `send -R -X` stream leaves an already-replicated child's archive copy in
# place, so the copy is reconciled here: destroyed on the opt-in, otherwise
# reported as an orphan whose space is never reclaimed.
reconcile_excluded_archive_copies() {
  _EXCLUDE_RECONCILED=1
  [[ ${#EXCLUDE_LIST[@]} -gt 0 ]] || return 0
  local ex src dst rc=0
  for ex in "${EXCLUDE_LIST[@]}"; do
    for src in "${SRC_LIST[@]}"; do
      case "$ex" in
        "$src"/*) dst="${MAP[$src]}${ex#"$src"}" ;;
        *) continue ;;
      esac
      dataset_present "$dst" || continue
      if [[ "$EXCLUDE_DESTROY_OK" != true ]]; then
        EXCLUDED_ORPHANS=$((EXCLUDED_ORPHANS + 1))
        log "WARNING: ${dst} is excluded from this send but remains on the archive pool; its space is never reclaimed. Set nas_storage_archive_backup_exclude_destroy_ok: true to destroy it."
        continue
      fi
      log "Exclusion: destroying archive copy ${dst} and its descendants"
      # A failed destroy leaves the copy in place, so it still counts as an orphan
      # for the gauge the exit trap publishes.
      zfs destroy -r "$dst" || {
        EXCLUDED_ORPHANS=$((EXCLUDED_ORPHANS + 1))
        log "FATAL: cannot destroy excluded archive copy ${dst}"
        rc=1
      }
    done
  done
  return "$rc"
}
# MAP/RMAP are derived, never hand-maintained: every backup lands at
# ${POOL_DST}/<basename>, and so do the lock list and the restore targets.
# Duplicate basenames would collide, so they fail before any zfs command runs.
declare -A MAP=() RMAP=()
for _src in "${SRC_LIST[@]}"; do
  _dst="${POOL_DST}/${_src##*/}"
  if [[ -n "${RMAP[$_dst]:-}" ]]; then
    echo "FATAL: duplicate SRC_LIST basename: ${_src} collides with ${RMAP[$_dst]} on ${_dst}" >&2
    exit 1
  fi
  MAP["$_src"]="$_dst"
  RMAP["$_dst"]="$_src"
done
for _ds in "${!KEEP_MONTHLY_OVERRIDES[@]}"; do
  for _src in "${SRC_LIST[@]}"; do
    if [[ "$_ds" == "$_src" || "$_ds" == "$_src"/* ]]; then
      KEEP_MONTHLY_OVERRIDES["${MAP[$_src]}${_ds#"$_src"}"]="${KEEP_MONTHLY_OVERRIDES[$_ds]}"
    fi
  done
done
unset _src _dst _ds

{% endraw %}
PROM_DIR="{{ nas_storage_backup_artifact_metrics_dir }}"
{% raw %}
PROM_FILE="${PROM_DIR}/archive_backup.prom"
# Prune failures are detected in the forked per-dataset child ("$0" __run-one),
# whose variables die with it — the marker carries them back to the parent that
# writes the textfile.
PRUNE_FAIL_MARKER="${PROM_DIR}/.archive_prune_failed"

# Per-dataset replication state, keyed by SRC_LIST entry. Seeded from the
# previous textfile by _load_prev_dataset_metrics so an aborted or deferring
# run re-emits last-known values instead of dropping series.
declare -A _DS_SUCCESS_TS=() _DS_DEFERRED=()

# Flipped to 0 by any failed snapshot destroy: a run can replicate perfectly
# and still leave retention broken, which only shows up when the pool fills.
PRUNE_OK=1
# Child-side twin of PRUNE_OK: cmd_run_one turns it into exit 76, which is how
# a prune failure normally reaches the parent.
_PRUNE_FAILED=0
# Archive copies of excluded children left in place this run. Their space is
# never reclaimed, so the count is published rather than only logged.
EXCLUDED_ORPHANS=0
# 0 until the reconcile has actually looked, so a run that exits before it
# re-publishes the last count instead of clearing the signal.
_EXCLUDE_RECONCILED=0

log() { echo "[$(date -Is)] $*"; }

# Record a failed snapshot destroy inside the per-dataset child: exit 76 is the
# primary route back, the marker covers a child that dies first. An unwritable
# marker is FATAL, or the parent would report retention as healthy.
note_prune_failure() {
  PRUNE_OK=0
  _PRUNE_FAILED=1
  if mkdir -p "$PROM_DIR" && : > "$PRUNE_FAIL_MARKER"; then
    return 0
  fi
  log "FATAL: cannot write ${PRUNE_FAIL_MARKER}; a retention failure would go unreported"
  return 1
}

write_prom_metrics() {
  local success="$1" duration="$2"
  local ts
  ts="$(date +%s)"
  local tmp="${PROM_FILE}.$$"
  if ! mkdir -p "$PROM_DIR"; then
    log "FATAL: cannot create ${PROM_DIR}; no metrics written"
    return 1
  fi
  # The children's marker is read, not consumed: the gauge it feeds is published
  # only by the mv below, and a failed write must keep the retention failure.
  local had_marker=0
  if [[ -e "$PRUNE_FAIL_MARKER" ]]; then
    had_marker=1
    PRUNE_OK=0
  fi
  local orphans="$EXCLUDED_ORPHANS"
  if [[ "$_EXCLUDE_RECONCILED" -ne 1 ]]; then
    orphans="$(awk '/^archive_backup_excluded_orphans / {print $2}' "$PROM_FILE" 2>/dev/null || true)"
    orphans="${orphans:-0}"
  fi
  # `|| wrote=1` records a failed write, including a temp file the redirection
  # cannot open.
  local wrote=0
  {
    echo "# HELP archive_backup_last_run_duration_seconds Duration of last backup run"
    echo "# TYPE archive_backup_last_run_duration_seconds gauge"
    echo "archive_backup_last_run_duration_seconds ${duration}"
    echo "# HELP archive_backup_last_run_success Whether the last run succeeded (1=success, 0=failure)"
    echo "# TYPE archive_backup_last_run_success gauge"
    echo "archive_backup_last_run_success ${success}"
    if [ "$success" -eq 1 ]; then
      echo "# HELP archive_backup_last_success_timestamp_seconds Unix timestamp of last successful backup"
      echo "# TYPE archive_backup_last_success_timestamp_seconds gauge"
      echo "archive_backup_last_success_timestamp_seconds ${ts}"
    else
      # Preserve the last-known success timestamp so the staleness alert
      # measures time-since-last-success, not time-since-last-attempt.
      local prev
      prev="$(awk '/^archive_backup_last_success_timestamp_seconds/ {print $2}' "$PROM_FILE" 2>/dev/null || true)"
      if [ -n "$prev" ]; then
        echo "# HELP archive_backup_last_success_timestamp_seconds Unix timestamp of last successful backup"
        echo "# TYPE archive_backup_last_success_timestamp_seconds gauge"
        echo "archive_backup_last_success_timestamp_seconds ${prev}"
      fi
    fi
    echo "# HELP archive_backup_last_prune_success Whether every snapshot destroy in the last run succeeded (1=pruned, 0=retention blocked)"
    echo "# TYPE archive_backup_last_prune_success gauge"
    echo "archive_backup_last_prune_success ${PRUNE_OK}"
    echo "# HELP archive_backup_excluded_orphans Archive copies of excluded children left in place, whose space is never reclaimed"
    echo "# TYPE archive_backup_excluded_orphans gauge"
    echo "archive_backup_excluded_orphans ${orphans}"
    _emit_dataset_gauge archive_backup_dataset_last_success_timestamp_seconds \
      "Unix timestamp of each dataset's last successful replication" _DS_SUCCESS_TS
    _emit_dataset_gauge archive_backup_dataset_deferred_runs \
      "Consecutive runs this dataset was deferred by the vzdump-quiesce guard (0 after any success or failure)" _DS_DEFERRED
  } > "$tmp" || wrote=1
  if [[ "$wrote" -ne 0 ]]; then
    log "FATAL: cannot write ${tmp}; metrics not updated"
    rm -f "$tmp"
    return 1
  fi
  if ! mv "$tmp" "$PROM_FILE"; then
    log "FATAL: cannot publish ${PROM_FILE}; metrics not updated"
    rm -f "$tmp"
    return 1
  fi
  # Published — only now is the marker safe to drop, and only if this run read
  # one: a child that dropped its marker after the read above keeps it for the
  # next run rather than having it deleted unreported.
  if [[ "$had_marker" -eq 1 ]]; then
    rm -f "$PRUNE_FAIL_MARKER" \
      || log "WARNING: could not remove ${PRUNE_FAIL_MARKER}; the next run will report retention blocked"
  fi
  return 0
}

# _emit_dataset_gauge <metric> <help> <assoc-array-name>: one per-dataset gauge
# block. Only current SRC_LIST members are emitted, so a dataset dropped from
# the archive set ages out instead of leaving a series that alerts stale.
_emit_dataset_gauge() {
  local metric="$1" help="$2" ds
  local -n _arr="$3"
  [[ "${#_arr[@]}" -gt 0 ]] || return 0
  echo "# HELP ${metric} ${help}"
  echo "# TYPE ${metric} gauge"
  while IFS= read -r ds; do
    [[ -n "${MAP[$ds]:-}" ]] || continue
    echo "${metric}{dataset=\"${ds}\"} ${_arr[$ds]}"
  done < <(printf '%s\n' "${!_arr[@]}" | sort)
}

# _load_dataset_gauge <metric> <assoc-array-name>: seed one per-dataset gauge
# from the previous run's textfile.
_load_dataset_gauge() {
  local metric="$1" ds val
  local -n _arr="$2"
  while IFS=$'\t' read -r ds val; do
    [[ -n "$ds" && -n "$val" ]] || continue
    _arr["$ds"]="$val"
  done < <(awk -F'[{}" ]+' -v m="^${metric}\\{" '$0 ~ m {print $3 "\t" $NF}' "$PROM_FILE" 2>/dev/null || true)
}

# Seed per-dataset state from the previous run's textfile so datasets this run
# never reaches (deferral, mid-run abort via the ERR trap) keep their series.
_load_prev_dataset_metrics() {
  _load_dataset_gauge archive_backup_dataset_last_success_timestamp_seconds _DS_SUCCESS_TS
  _load_dataset_gauge archive_backup_dataset_deferred_runs _DS_DEFERRED
}

# On failure, write metrics with success=0 (preserve last-known timestamp)
trap_write_failure_metrics() {
  [[ "${_BACKUP_METRICS_ACTIVE:-0}" -eq 1 ]] || return 0
  local end_ts
  end_ts="$(date +%s)"
  local duration=$(( end_ts - _BACKUP_START_TS ))
  write_prom_metrics 0 "$duration"
}
_BACKUP_START_TS="$(date +%s)"
_BACKUP_METRICS_ACTIVE=0
trap trap_write_failure_metrics ERR

need_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    echo "Run as root (e.g. sudo -i then archive-backupctl ...)" >&2
    exit 1
  fi
}

pool_present() { zpool list -H -o name "${POOL_DST}" >/dev/null 2>&1; }
dataset_present() { zfs list -H -o name "$1" >/dev/null 2>&1; }

# tree_prop_matches <dataset> <property> <grep-args...>: 0 when a value under the
# dataset matches, 1 when none does, 2 when `zfs get` fails. The output is captured
# first, so a large tree cannot SIGPIPE a `grep -q` into a false negative.
tree_prop_matches() {
  local ds="$1" prop="$2" vals
  shift 2
  if ! vals="$(zfs get -H -o value -r -t filesystem,volume "$prop" "$ds" 2>/dev/null)"; then
    log "FAILED: cannot read the ${prop} property under ${ds}"
    return 2
  fi
  grep -q "$@" <<< "$vals"
}

tree_is_encrypted() { tree_prop_matches "$1" encryption -Ev '^(off|-|)$'; }
tree_has_keyless() { tree_prop_matches "$1" keystatus -x 'unavailable'; }

# Prints each filesystem under $1 that should be mounted and is not: canmount=on,
# its key available, and a mountpoint other than none or legacy, which `zfs mount`
# never mounts. Returns 2 when `zfs get` fails.
unmounted_in_tree() {
  local props
  if ! props="$(zfs get -H -o name,property,value -r -t filesystem canmount,keystatus,mounted,mountpoint "$1" 2>/dev/null)"; then
    log "FAILED: cannot read the mount state under $1"
    return 2
  fi
  awk -F'\t' '{ v[$1 SUBSEP $2] = $3; n[$1] = 1 }
    END { for (d in n) if (v[d SUBSEP "canmount"] == "on" && v[d SUBSEP "keystatus"] != "unavailable" \
      && v[d SUBSEP "mountpoint"] != "none" && v[d SUBSEP "mountpoint"] != "legacy" && v[d SUBSEP "mounted"] == "no") print d }' \
    <<< "$props" | sort
}

# Monthly keep count for one dataset: the nearest override on it or an
# ancestor, else KEEP_MONTHLY.
keep_monthly_for() {
  local ds="$1"
  while :; do
    if [[ -n "${KEEP_MONTHLY_OVERRIDES[$ds]+set}" ]]; then
      printf '%s' "${KEEP_MONTHLY_OVERRIDES[$ds]}"
      return 0
    fi
    [[ "$ds" == */* ]] || break
    ds="${ds%/*}"
  done
  printf '%s' "$KEEP_MONTHLY"
}

# LOCKDOWN / SAFETY

# A readonly=on that did not take, or a filesystem left mounted, leaves the
# replica exposed, so the flag demotes the run to success=0.
_LOCKDOWN_FAILED=0

# Sets the tree non-mountable with readonly=$2: on locks the replica, off lets a
# receive write. A child `zfs inherit` tracks the root's mountpoint=none, and
# `|| true` is there because zvol children reject mountpoint.
_set_backup_tree() {
  local root="$1" ro="$2" children child mounted
  dataset_present "$root" || return 0

  zfs set mountpoint=none "$root" >/dev/null 2>&1 || true
  zfs set canmount=off "$root"   >/dev/null 2>&1 || true
  if children="$(zfs list -H -o name -r "$root")"; then
    children="$(tail -n +2 <<< "$children")"
  else
    log "Lockdown: FAILED, cannot list the datasets under ${root}"
    _LOCKDOWN_FAILED=1
    children=""
  fi
  while IFS= read -r child; do
    [[ -n "$child" ]] || continue
    if [[ "$child" != "$root" ]]; then
      zfs inherit mountpoint "$child" >/dev/null 2>&1 || true
      zfs set canmount=off "$child"   >/dev/null 2>&1 || true
    fi
    zfs set readonly="$ro" "$child" >/dev/null 2>&1 || [[ "$ro" == off ]] \
      || { log "Lockdown: FAILED readonly=on on ${child}"; _LOCKDOWN_FAILED=1; }
  done <<< "${root}"$'\n'"${children}"

  zfs unmount "$root" >/dev/null 2>&1 || true
  if ! mounted="$(zfs get -H -o name,value -r -t filesystem mounted "$root" 2>/dev/null)"; then
    log "Lockdown: FAILED, cannot read the mount state under ${root}"
    _LOCKDOWN_FAILED=1
    return 0
  fi
  mounted="$(awk -F'\t' '$2 == "yes" { print $1 }' <<< "$mounted" | paste -sd' ' -)"
  if [[ -n "$mounted" ]]; then
    log "Lockdown: FAILED, still mounted: ${mounted}"
    _LOCKDOWN_FAILED=1
  fi
}

# Force backup tree into a safe, non-mountable, read-only state.
lock_backup_tree() { _set_backup_tree "$1" on; }

# Allow receives to write (still never mount anywhere).
unlock_for_receive() { _set_backup_tree "$1" off; }

# Every received dataset lands with a safe mountpoint, so it can never
# temporarily inherit a dangerous one (capturing a live path) mid-receive.
RECV_SAFE_OPTS=( -o mountpoint=none -o canmount=off -o readonly=on )

maybe_resume_receive() {
  local dst="$1"
  dataset_present "$dst" || return 0

  # An interrupted recursive (-R) receive leaves the resume token on the
  # dataset that was mid-stream — usually a CHILD, not the root — so enumerate
  # tokens across the whole tree and resume each one into ITS dataset.
  local ds tok dtype found=0
  local -a recv_opts
  while IFS=$'\t' read -r ds tok; do
    [[ -n "$tok" && "$tok" != "-" ]] || continue
    if [[ "$found" -eq 0 ]]; then
      unlock_for_receive "$dst"
      found=1
    fi
    log "Resuming interrupted receive into ${ds}"
    # Same zvol/filesystem split as the re-seed loop: a resume stream targets
    # $ds directly and zfs rejects -o mountpoint/canmount on a volume.
    dtype="$(zfs get -H -o value type "$ds" 2>/dev/null || true)"
    if [[ "$dtype" == "volume" ]]; then
      recv_opts=( -o readonly=on )
    else
      recv_opts=( "${RECV_SAFE_OPTS[@]}" )
    fi
    if ! zfs send -t "$tok" | zfs receive -s -u "${recv_opts[@]}" "$ds"; then
      # A dead token (e.g. the source snapshot was pruned) can never resume;
      # abort the partial receive state so the incremental/full paths — which
      # any receive into $ds would otherwise reject — can proceed this run.
      log "Resume failed for ${ds}; aborting its partial receive state"
      zfs receive -A "$ds" || true
    fi
  done < <(zfs get -H -o name,value -r receive_resume_token "$dst" 2>/dev/null || true)
  if [[ "$found" -eq 1 ]]; then
    lock_backup_tree "$dst"
  fi
}

# SNAPSHOT / COMMON BASELINE

latest_common_snapshot() {
  local src="$1" dst="$2"

  local src_snaps dst_snaps common
  src_snaps="$(zfs list -H -t snapshot -o name -s creation -r "$src" \
    | sed -n "s|^${src}@||p" \
    | grep -E "^${SNAP_PREFIX}-" || true)"

  # The incremental base must exist on EVERY dataset in the dst tree: an
  # interrupted recursive receive leaves children a snapshot behind, and
  # `zfs send -R -i` then fails on the child missing the base.
  local d ds_count=0 dst_snap_lines=""
  while IFS= read -r d; do
    [[ -n "$d" ]] || continue
    # An excluded child's archive copy stops receiving snapshots, so counting it
    # would reject every candidate base and force a full re-send every run.
    if is_excluded "${src}${d#"$dst"}"; then
      continue
    fi
    ds_count=$(( ds_count + 1 ))
    dst_snap_lines+="$(zfs list -H -t snapshot -o name -d 1 "$d" 2>/dev/null || true)"$'\n'
  done < <(zfs list -H -o name -r "$dst" 2>/dev/null || true)
  [[ "$ds_count" -gt 0 ]] || return 0
  dst_snaps="$(printf '%s' "$dst_snap_lines" \
    | sed -n "s|^.*@\(${SNAP_PREFIX}-.*\)$|\1|p" \
    | sort | uniq -c \
    | awk -v n="$ds_count" '$1 == n { print $2 }')"

  common="$(comm -12 <(printf "%s\n" "$src_snaps" | sort) <(printf "%s\n" "$dst_snaps" | sort) | tail -n 1 || true)"
  printf "%s" "$common"
}

# Prints the newest archsync snapshot of $1, or nothing when it has none.
# Returns 2 when the listing fails, so an error never reads as "no snapshots".
latest_backup_snapshot_fullname() {
  local bdst="$1" snaps
  snaps="$(zfs list -H -t snapshot -o name -s creation -r "$bdst")" || return 2
  grep -E "^${bdst}@${SNAP_PREFIX}-" <<< "$snaps" | tail -n 1 || true
}

# RETENTION / PRUNING

# Prune snapshots for ONE dataset (non-recursive). The `retain` policy keeps the
# newest KEEP_RECENT snapshots plus the newest of each of the last
# keep_monthly_for calendar months; `none` keeps nothing.
prune_snaps_dataset() {
  local ds="$1" policy="${2:-retain}"

  local listed
  listed="$(zfs list -H -t snapshot -o name -S creation -r "$ds")" \
    || { log "Prune: FAILED to list snapshots of $ds"; return 1; }
  mapfile -t snaps < <(grep -E "^${ds}@${SNAP_PREFIX}-" <<< "$listed" || true)
  ((${#snaps[@]} == 0)) && return 0

  declare -A keep=()
  if [[ "$policy" == retain ]]; then
    local i=0 keep_monthly
    keep_monthly="$(keep_monthly_for "$ds")"

    for s in "${snaps[@]}"; do
      if (( i < KEEP_RECENT )); then
        keep["$s"]=1
      fi
      i=$((i+1))
    done

    declare -A kept_month=()
    local kept_m=0

    for s in "${snaps[@]}"; do
      (( kept_m < keep_monthly )) || break
      [[ -n "${keep[$s]:-}" ]] && continue

      local snap_name="${s#"${ds}"@}"
      local yyyymm
      yyyymm="$(echo "$snap_name" | sed -n 's/^'"${SNAP_PREFIX}"'-\([0-9]\{6\}\)[0-9]\{2\}-[0-9]\{6\}$/\1/p')"

      [[ -z "$yyyymm" ]] && continue

      if [[ -z "${kept_month[$yyyymm]:-}" ]]; then
        keep["$s"]=1
        kept_month["$yyyymm"]=1
        kept_m=$((kept_m+1))
      fi
    done
  fi

  # Destroy anything not kept. A failed destroy is reported, not swallowed:
  # retention wedging silently fills the pool.
  local rc=0
  for s in "${snaps[@]}"; do
    if [[ -z "${keep[$s]:-}" ]]; then
      log "Prune: destroying snapshot $s"
      zfs destroy "$s" || { log "Prune: FAILED to destroy $s"; rc=1; }
    fi
  done
  return "$rc"
}

# Prune for dataset tree (root + children datasets). An excluded descendant has
# no archive copy to restore from, so the exclusion IS its retention and every
# snapshot goes; archive-side names never match, so those keep their history.
prune_snaps_tree() {
  local root="$1"
  dataset_present "$root" || return 0

  local rc=0 ds listed
  listed="$(zfs list -H -o name -r "$root")" \
    || { log "Prune: FAILED to list the datasets under $root"; return 1; }
  while IFS= read -r ds; do
    [[ -n "$ds" ]] || continue
    if is_excluded "$ds"; then
      prune_snaps_dataset "$ds" none || rc=1
    else
      prune_snaps_dataset "$ds" retain || rc=1
    fi
  done <<< "$listed"
  return "$rc"
}

# POOL DEFAULTS

set_pool_root_props() {
  zfs set mountpoint=none "${POOL_DST}" >/dev/null 2>&1 || true
  zfs set compression=zstd "${POOL_DST}" >/dev/null 2>&1 || true
  zfs set atime=off "${POOL_DST}" >/dev/null 2>&1 || true
  zfs set xattr=sa "${POOL_DST}" >/dev/null 2>&1 || true
  zfs set acltype=posixacl "${POOL_DST}" >/dev/null 2>&1 || true
}

# REPLICATION

replicate_one() {
  local src="$1" dst="$2"
  local snap_now
  snap_now="${SNAP_PREFIX}-$(date +%Y%m%d-%H%M%S)"
  local reseed_tmp="${dst}-reseed"

  # 73: missing-source SKIP. Distinct from success so cmd_run leaves the
  # dataset's last-success timestamp untouched — a vanished source (e.g. an
  # un-imported pool) must age into ArchiveBackupDatasetStale, not refresh it.
  dataset_present "$src" || { log "SKIP: missing source $src"; return 73; }

  # vzdump-overrun guard: wait for the remote-node NFS writes to settle so this
  # snapshot never captures a half-written backup, and defer the dataset (last
  # night's copy kept) if they do not settle within the bound.
  if [[ "$src" == "$VZDUMP_TARGET" ]]; then
    local vz_mp vz_waited=0
    vz_mp="$(zfs get -H -o value mountpoint "$src" 2>/dev/null || true)"
    if [[ -n "$vz_mp" && "$vz_mp" != "-" && -d "$vz_mp" ]]; then
      while find "$vz_mp" -type f -mmin "-${VZDUMP_QUIESCE_MIN}" -print -quit 2>/dev/null | grep -q .; do
        if (( vz_waited >= VZDUMP_MAX_WAIT_MIN )); then
          # 75 (EX_TEMPFAIL) marks this dataset DEFERRED, not failed, so the
          # run's success metric stays meaningful for real send/receive errors.
          # Chronic deferral surfaces through the per-dataset gauges.
          log "DEFER ${src}: vzdump still writing under ${vz_mp} after ${vz_waited}m; leaving prior backup, will retry next run"
          return 75
        fi
        log "vzdump appears active under ${vz_mp} (writes < ${VZDUMP_QUIESCE_MIN}m old); waiting ${VZDUMP_QUIESCE_MIN}m for quiesce"
        sleep $(( VZDUMP_QUIESCE_MIN * 60 ))
        vz_waited=$(( vz_waited + VZDUMP_QUIESCE_MIN ))
      done
    fi
  fi

  # Encrypted sources must be sent raw (-w): ZFS refuses -R on an encrypted
  # dataset otherwise, and the archive then holds ciphertext. Detected
  # RECURSIVELY - one encrypted child under a plaintext parent aborts the send.
  local raw_flags=() enc_rc=0
  tree_is_encrypted "$src" || enc_rc=$?
  case "$enc_rc" in
    0) raw_flags=(-w) ;;
    1) ;;
    *) log "FATAL ${src}: encryption unknown, so the send mode cannot be chosen"; return 1 ;;
  esac

  exclude_flags_for "$src"

  # A re-seed interrupted after its replacement was fully received leaves a
  # COMPLETE temp sibling: promote it rather than re-send multi-TB. Complete =
  # a snapshot present AND no resume token; anything else is discarded.
  if dataset_present "$reseed_tmp"; then
    # Fail closed: the marker and token list are captured explicitly, so a failed
    # `zfs get` cannot be negated into a false "complete" and promoted over a
    # good dst. The marker is written only after every dataset is received.
    local reseed_marker reseed_tokens reseed_snaps
    reseed_marker="$(zfs get -H -o value "${SNAP_PREFIX}:reseed_complete" "$reseed_tmp" 2>/dev/null || echo "?")"
    if reseed_tokens="$(zfs get -H -o value -r receive_resume_token "$reseed_tmp" 2>/dev/null)" \
       && reseed_snaps="$(zfs list -H -t snapshot -o name -r "$reseed_tmp" 2>/dev/null)" \
       && [[ "$reseed_marker" == "1" ]] \
       && [[ -n "$reseed_snaps" ]] \
       && ! printf '%s\n' "$reseed_tokens" | grep -qv '^-$'; then
      log "Finishing interrupted re-seed: promoting ${reseed_tmp} -> ${dst}"
      if dataset_present "$dst"; then
        unlock_for_receive "$dst"
        zfs destroy -r "$dst"
      fi
      zfs rename "$reseed_tmp" "$dst"
      lock_backup_tree "$dst"
      prune_snaps_tree "$src" || note_prune_failure
      prune_snaps_tree "$dst" || note_prune_failure
      return 0
    fi
    log "Discarding incomplete re-seed temp ${reseed_tmp}"
    unlock_for_receive "$reseed_tmp"
    zfs destroy -r "$reseed_tmp"
  fi

  if dataset_present "$dst"; then
    maybe_resume_receive "$dst"
  fi

  # The recursive snapshot covers the excluded children too, and `send -X`
  # still walks them: their snapshot has to exist until the send returns. The
  # prune below retires it, since the exclusion is their whole retention.
  log "Snapshot: ${src}@${snap_now}"
  zfs snapshot -r "${src}@${snap_now}"

  # A raw stream cannot continue a non-raw base, so a source encrypted after the
  # fact needs a one-time raw re-seed: built in a temp sibling, swapped in only
  # after a complete receive. Only an exact encryption=off triggers it.
  if [[ ${#raw_flags[@]} -gt 0 ]] && dataset_present "$dst" \
     && [[ "$(zfs get -H -o value encryption "$dst" 2>/dev/null)" == "off" ]]; then
    log "Re-seed: ${src} is encrypted but ${dst} is non-raw; building raw copy in ${reseed_tmp} (current snapshot only)"
    # Current snapshot per dataset, never -R: -R ships the whole snapshot history
    # and can overflow the pool. Listed up front so a failed enumeration cannot
    # set the completion marker, and depth-sorted to get parents before children.
    local snap ds sub recv_opts dtype snap_list
    if ! snap_list="$(zfs list -H -o name -t snapshot -r "$src" \
        | awk -F@ -v s="$snap_now" '$2 == s { d = $1; print gsub(/\//, "/", d) "\t" $0 }' \
        | sort -k1,1n -k2,2 | cut -f2-)"; then
      log "Re-seed aborted: failed to enumerate ${snap_now} snapshots under ${src}"
      return 1
    fi
    [[ -n "$snap_list" ]] || { log "Re-seed aborted: no ${snap_now} snapshots under ${src}"; return 1; }
    while IFS= read -r snap; do
      ds="${snap%@"${snap_now}"}"
      # The -R paths drop these through -X; this per-dataset loop skips them.
      if is_excluded "$ds"; then
        continue
      fi
      sub="${reseed_tmp}${ds#"${src}"}"
      # zfs REJECTS a per-dataset mountpoint/canmount override on a zvol receive,
      # so volumes get read-only only. `|| true` leaves dtype empty on a get
      # error, so the else branch aborts instead of guessing filesystem.
      dtype="$(zfs get -H -o value type "$ds" 2>/dev/null || true)"
      if [[ "$dtype" == "volume" ]]; then
        recv_opts=( -o readonly=on )
      elif [[ "$dtype" == "filesystem" ]]; then
        recv_opts=( "${RECV_SAFE_OPTS[@]}" )
      else
        log "Re-seed aborted: cannot determine type of ${ds} (got '${dtype}')"
        return 1
      fi
      zfs send "${raw_flags[@]}" "${snap}" \
        | zfs receive -s -u "${recv_opts[@]}" "$sub" \
        || { log "Re-seed failed sending ${snap} -> ${sub}"; return 1; }
    done <<< "$snap_list"
    # Mark the temp tree complete ONLY after every dataset received. The recovery
    # block requires this marker before promoting, so a crash mid-loop (no
    # marker) or a partial child (resume token) is never promoted over a good dst.
    zfs set "${SNAP_PREFIX}:reseed_complete=1" "$reseed_tmp"
    # Receive completed (a send/receive failure would have aborted above) ->
    # swap the verified raw copy into place: drop the old, rename temp in.
    unlock_for_receive "$dst"
    zfs destroy -r "$dst"
    zfs rename "$reseed_tmp" "$dst"
    lock_backup_tree "$dst"
    prune_snaps_tree "$src" || note_prune_failure
    prune_snaps_tree "$dst" || note_prune_failure
    return 0
  fi

  if ! dataset_present "$dst"; then
    log "Initial replicate -> ${dst} (raw=${raw_flags[*]:-no})"
    zfs send -R "${raw_flags[@]}" "${EXCLUDE_FLAGS[@]}" "${src}@${snap_now}" \
      | zfs receive -s -u "${RECV_SAFE_OPTS[@]}" "${dst}"
    lock_backup_tree "$dst"
  else
    unlock_for_receive "$dst"

    local prev
    prev="$(latest_common_snapshot "$src" "$dst")"

    if [[ -z "$prev" ]]; then
      log "No common ${SNAP_PREFIX}-* snapshots; full replicate to ${dst} (receive -F, raw=${raw_flags[*]:-no})"
      zfs send -R "${raw_flags[@]}" "${EXCLUDE_FLAGS[@]}" "${src}@${snap_now}" \
        | zfs receive -s -u -F "${RECV_SAFE_OPTS[@]}" "${dst}"
    else
      log "Incremental: ${src}@${prev} -> ${src}@${snap_now} into ${dst} (receive -F, raw=${raw_flags[*]:-no})"
      zfs send -R "${raw_flags[@]}" "${EXCLUDE_FLAGS[@]}" -i "${src}@${prev}" "${src}@${snap_now}" \
        | zfs receive -s -u -F "${RECV_SAFE_OPTS[@]}" "${dst}"
    fi

    lock_backup_tree "$dst"
  fi

  # Prune both sides (keeps common set small and the comm faster)
  prune_snaps_tree "$src" || note_prune_failure
  prune_snaps_tree "$dst" || note_prune_failure
}

# COMMANDS

cmd_run() {
  # Single-instance guard: a timer run colliding with a manual run would
  # interleave sends to the same target datasets.
  exec 9>/run/archive-backup.lock
  if ! flock -n 9; then
    log "archive-backup already running; exiting"
    exit 0
  fi
  _BACKUP_METRICS_ACTIVE=1
  _load_prev_dataset_metrics
  # Start from a clean slate: the gauge describes THIS run's retention, so a
  # marker left by an earlier interrupted run must not pin it to 0 forever.
  PRUNE_OK=1
  EXCLUDED_ORPHANS=0
  # Not fatal here — replication is still worth doing without a textfile dir,
  # and write_prom_metrics fails loudly on it at the end of the run.
  mkdir -p "$PROM_DIR" 2>/dev/null \
    || log "WARNING: cannot create ${PROM_DIR}; this run will end without metrics"
  if [[ -e "$PRUNE_FAIL_MARKER" ]]; then
    # Left by a run that died before publishing its textfile, so the failure it
    # carries was never reported. Say so on the way out.
    log "WARNING: discarding orphaned ${PRUNE_FAIL_MARKER} from an earlier run; its prune failure was never published"
    rm -f "$PRUNE_FAIL_MARKER" \
      || log "WARNING: could not remove ${PRUNE_FAIL_MARKER}; this run will report retention blocked"
  fi
  if ! pool_present; then
    log "Pool '${POOL_DST}' not present (exported/unplugged). Nothing to do."
    exit 0
  fi

  assert_send_exclude_supported
  reconcile_excluded_archive_copies

  set_pool_root_props

  log "Starting replication to '${POOL_DST}'"
  local failed=0 deferred=0 rc
  for src in "${SRC_LIST[@]}"; do
    # Isolate each dataset in a fresh process: one failing dataset must not
    # starve the rest, and `if replicate_one ...` would disable errexit and the
    # ERR trap, turning send|receive failures into silent successes.
    rc=0
    "$0" __run-one "$src" || rc=$?
    if [[ "$rc" -eq 0 ]]; then
      _DS_SUCCESS_TS["$src"]="$(date +%s)"
      _DS_DEFERRED["$src"]=0
    elif [[ "$rc" -eq 76 ]]; then
      # Replicated fine, pruned badly: the dataset keeps its success timestamp
      # (the copy IS current) while the run's prune gauge goes to 0. The child's
      # marker says the same thing; this path does not depend on it.
      log "Replication OK for ${src} but snapshot pruning FAILED; retention blocked"
      PRUNE_OK=0
      _DS_SUCCESS_TS["$src"]="$(date +%s)"
      _DS_DEFERRED["$src"]=0
    elif [[ "$rc" -eq 77 ]]; then
      # Replicated fine, did not lock down: the copy IS current, but it is
      # writable, so the run fails while the dataset keeps its timestamp.
      log "Replication OK for ${src} but LOCKDOWN FAILED; the replica is writable"
      failed=1
      _DS_SUCCESS_TS["$src"]="$(date +%s)"
      _DS_DEFERRED["$src"]=0
    elif [[ "$rc" -eq 75 ]]; then
      # Deferred (vzdump quiesce timeout): prior copy kept, not a run failure.
      log "Replication DEFERRED for ${src}; prior backup kept, retrying next run"
      deferred=1
      _DS_DEFERRED["$src"]=$(( ${_DS_DEFERRED["$src"]:-0} + 1 ))
    elif [[ "$rc" -eq 73 ]]; then
      # Missing source is neither a success (the timestamp keeps aging into
      # ArchiveBackupDatasetStale) nor a deferral: reset the counter so a
      # dataset that vanishes mid-deferral stops firing ChronicallyDeferred.
      log "Replication SKIPPED for ${src} (source dataset missing)"
      _DS_DEFERRED["$src"]=0
    else
      log "Replication FAILED for ${src}; continuing with remaining datasets"
      failed=1
      _DS_DEFERRED["$src"]=0
    fi
  done

  if [[ "$failed" -eq 1 ]]; then
    log "Replication finished WITH FAILURES (see per-dataset errors above)."
  elif [[ "$deferred" -eq 1 ]]; then
    log "Replication complete (deferred dataset(s) above retried next run)."
  else
    log "Replication complete."
  fi
  zfs list -o name,used,avail,refer,mountpoint -r "${POOL_DST}" | sed 's/^/  /'

  # Write Prometheus textfile metrics. success=0 preserves the last-success
  # timestamp, so ArchiveBackupFailed fires while the staleness alert still
  # measures time since the last fully good run.
  local end_ts
  end_ts="$(date +%s)"
  local duration=$(( end_ts - _BACKUP_START_TS ))
  if [[ "$failed" -eq 1 || "$_LOCKDOWN_FAILED" -eq 1 ]]; then
    write_prom_metrics 0 "$duration"
    exit 1
  fi
  write_prom_metrics 1 "$duration"
}

# Internal subcommand used only by cmd_run: replicate exactly one SRC_LIST
# dataset in this fresh process, where errexit + the ERR trap are fully
# active. The parent holds the run lock.
cmd_run_one() {
  local src="$1"
  [[ -n "${MAP[$src]:-}" ]] || { log "__run-one: '${src}' is not in SRC_LIST"; exit 2; }
  assert_send_exclude_supported
  # errexit exits with replicate_one's own code on 73/75/failure, so this line
  # is reached only after a clean replication. 76: replicated, did not prune.
  replicate_one "$src" "${MAP[$src]}"
  [[ "$_LOCKDOWN_FAILED" -eq 0 ]] || exit 77
  [[ "$_PRUNE_FAILED" -eq 0 ]] || exit 76
}

cmd_enable() {
  systemctl enable --now archive-backup.timer
  log "Enabled+started archive-backup.timer"
}

cmd_disable() {
  systemctl disable --now archive-backup.timer >/dev/null 2>&1 || true
  log "Disabled+stopped archive-backup.timer"
}

cmd_status() {
  systemctl status archive-backup.timer --no-pager || true
  systemctl status archive-backup.service --no-pager || true
  zpool list "${POOL_DST}" 2>/dev/null || true
  zfs list -r "${POOL_DST}" 2>/dev/null || true
}

# Single-instance lock shared with cmd_run: plug/unplug and the restores must
# never interleave with a mid-send replication (plug re-locks datasets an active
# receive needs writable, unplug dies on a busy export). Fail fast, never block.
_take_run_lock_or_die() {
  exec 9>/run/archive-backup.lock
  if ! flock -n 9; then
    log "replication in progress (lock held); retry after the nightly window"
    exit 1
  fi
}

cmd_unplug() {
  _take_run_lock_or_die
  cmd_disable
  # Scrub coverage tracks pool presence — a monthly scrub against an exported
  # pool would just fail. `|| true`: the timer may not exist/be enabled on a
  # host that never ran plug or a storage deploy with the pool imported.
  systemctl disable --now "${SCRUB_TIMER}" >/dev/null 2>&1 || true
  if ! pool_present; then
    log "Pool '${POOL_DST}' already not present."
    exit 0
  fi
  log "Unmounting datasets under '${POOL_DST}'"
  zfs unmount "${POOL_DST}" 2>/dev/null || true
  log "Exporting pool '${POOL_DST}' (safe to unplug after this)"
  zpool export "${POOL_DST}"
  log "Done."
}

_lock_existing_backup_datasets() {
  set_pool_root_props
  local dst
  for dst in "${!RMAP[@]}"; do
    if dataset_present "$dst"; then
      lock_backup_tree "$dst"
    fi
  done
}

cmd_plug() {
  _take_run_lock_or_die
  if pool_present; then
    log "Pool '${POOL_DST}' already imported."
  else
    log "Importing pool '${POOL_DST}'"
    zpool import -f "${POOL_DST}"
  fi
  _lock_existing_backup_datasets
  cmd_enable
  systemctl enable --now "${SCRUB_TIMER}" || log "WARNING: could not enable ${SCRUB_TIMER}"
  # cmd_run re-opens fd 9, briefly releasing this lock before re-taking it.
  # If the timer wins that race, cmd_run exits 0 ("already running") — which
  # is equivalent: a replication run is underway either way.
  cmd_run
}

cmd_plug_arm() {
  _take_run_lock_or_die
  if pool_present; then
    log "Pool '${POOL_DST}' already imported."
  else
    log "Importing pool '${POOL_DST}'"
    zpool import -f "${POOL_DST}"
  fi
  _lock_existing_backup_datasets
  cmd_enable
  systemctl enable --now "${SCRUB_TIMER}" || log "WARNING: could not enable ${SCRUB_TIMER}"
  log "Plug-arm complete (timer enabled; no immediate replication run)."
}

# RESTORE

# Makes every filesystem child mountable under its parent. Volumes take neither
# canmount nor mountpoint, so only filesystems are listed.
_restore_reset_children() {
  local root="$1" children child rc=0
  if ! children="$(zfs list -H -o name -t filesystem -r "$root")"; then
    log "FAILED: cannot list the filesystems under ${root}"
    return 1
  fi
  while IFS= read -r child; do
    [[ -n "$child" && "$child" != "$root" ]] || continue
    zfs set canmount=on "$child" || { log "FAILED: zfs set canmount=on ${child}"; rc=1; }
    zfs inherit mountpoint "$child" || { log "FAILED: zfs inherit mountpoint ${child}"; rc=1; }
  done <<< "$children"
  return "$rc"
}

# Mounts the tree, then fails when a filesystem that should mount did not. A
# key-less dataset is left for the operator, with the unlock command logged and
# _RESTORE_KEYLESS set.
_RESTORE_KEYLESS=0
_restore_mount_and_verify() {
  local root="$1" mount_err unmounted urc=0 krc=0
  _RESTORE_KEYLESS=0
  mount_err="$(zfs mount -R "$root" 2>&1)" || true
  unmounted="$(unmounted_in_tree "$root")" || urc=$?
  if [[ "$urc" -ne 0 ]]; then
    log "FAILED: cannot tell whether ${root} mounted"
    return 1
  fi
  if [[ -n "$unmounted" ]]; then
    log "FAILED: restored ${root}, but these filesystems did not mount: ${unmounted//$'\n'/ }"
    [[ -z "$mount_err" ]] || log "  zfs mount -R ${root}: ${mount_err//$'\n'/; }"
    return 1
  fi
  tree_has_keyless "$root" || krc=$?
  case "$krc" in
    0)
      _RESTORE_KEYLESS=1
      log "Restored tree ${root} contains encrypted key-less datasets, so its mount is incomplete."
      log "  Unlock + mount: zfs load-key -r -L prompt ${root} && zfs mount -R ${root}"
      ;;
    1) ;;
    *) return 1 ;;
  esac
  return 0
}

_restore_mount_tree() {
  local restore_root="$1" label="$2" ts="$3"
  local mp="${RESTORE_BASE}/${label}/${ts}" rc=0

  mkdir -p "$mp"

  zfs set canmount=on "$restore_root" || rc=1
  zfs set mountpoint="$mp" "$restore_root" || rc=1
  # The stream carries the archive's readonly=on as a received value on every
  # dataset, and received beats inherited. inherit -r masks it tree-wide.
  zfs inherit -r readonly "$restore_root" || rc=1
  _restore_reset_children "$restore_root" || rc=1
  if [[ "$rc" -ne 0 ]]; then
    log "FAILED: ${restore_root} was received, but its properties were not reset, so it may stay read-only or unmounted"
    return 1
  fi

  _restore_mount_and_verify "$restore_root" || return 1
  if [[ "$_RESTORE_KEYLESS" -eq 1 ]]; then
    log "  Once unlocked, the restore tree mounts at: $mp"
  else
    log "Mounted restore tree at: $mp"
  fi
}

# Puts back a mountpoint read before the restore: a local or received value as
# it was, an inherited or default one by following the parent again.
_restore_mountpoint() {
  local ds="$1" mp_value="$2" mp_source="$3"
  if [[ "$mp_source" == local || "$mp_source" == received ]]; then
    zfs set mountpoint="$mp_value" "$ds"
  else
    zfs inherit mountpoint "$ds"
  fi
}

# Sets each recorded child mountpoint again under $1. A recorded child that is
# not in the tree is logged and skipped.
_force_restore_child_mountpoints() {
  local root="$1" suffix rc=0
  for suffix in "${!_FORCE_CHILD_MP[@]}"; do
    if ! dataset_present "${root}${suffix}"; then
      log "WARNING: ${root}${suffix} had mountpoint=${_FORCE_CHILD_MP[$suffix]} but is not in the restored tree"
      continue
    fi
    zfs set mountpoint="${_FORCE_CHILD_MP[$suffix]}" "${root}${suffix}" \
      || { log "FAILED: zfs set mountpoint=${_FORCE_CHILD_MP[$suffix]} ${root}${suffix}"; rc=1; }
  done
  return "$rc"
}

# A restored stream carries the archive's lockdown props (mountpoint=none,
# canmount=off, readonly=on). canmount is not inheritable, so no receive option
# resets it on the children; the tree is reset here to the dataset it replaces.
_force_restore_reset_props() {
  local root="$1" mp_value="$2" mp_source="$3" mp rc=0
  zfs inherit -r readonly "$root" || rc=1
  zfs set canmount=on "$root" || rc=1
  _restore_mountpoint "$root" "$mp_value" "$mp_source" || rc=1
  _restore_reset_children "$root" || rc=1
  _force_restore_child_mountpoints "$root" || rc=1
  if [[ "$rc" -ne 0 ]]; then
    log "FAILED: ${root} was restored, but its properties were not reset, so it may stay read-only or unmounted"
    return 1
  fi

  _restore_mount_and_verify "$root" || return 1
  [[ "$_RESTORE_KEYLESS" -eq 0 ]] || return 0
  mp="$(zfs get -H -o value mountpoint "$root" 2>/dev/null || true)"
  log "Restored ${root}, mounted at ${mp:-its inherited mountpoint}. Re-run the storage deploy to re-assert the host_vars properties."
}

# A full stream cannot be received over a dataset with snapshots or encryption,
# so the existing tree is renamed aside into _FORCE_ASIDE and unmounted first.
_FORCE_ASIDE=""
# Local or received child mountpoints of the replaced tree, keyed by the path
# below its root, for the restored or rolled-back tree to set again.
declare -A _FORCE_CHILD_MP=()
_force_restore_clear_target() {
  local dst="$1" ts="$2"
  local aside="${dst}-pre-restore-${ts}" mps name value source children child
  _FORCE_ASIDE=""
  _FORCE_CHILD_MP=()
  if ! mps="$(zfs get -H -o name,value,source -r -t filesystem mountpoint "$dst")"; then
    log "FAILED: cannot read the mountpoints under ${dst}"
    return 1
  fi
  while IFS=$'\t' read -r name value source; do
    if [[ "$name" == "$dst"/* && ( "$source" == local || "$source" == received ) ]]; then
      _FORCE_CHILD_MP["${name#"$dst"}"]="$value"
    fi
  done <<< "$mps"
  log "FORCE restore: renaming ${dst} -> ${aside}"
  zfs rename "$dst" "$aside" || { log "FAILED: zfs rename ${dst} ${aside}"; return 1; }
  _FORCE_ASIDE="$aside"
  zfs set mountpoint=none "$aside" || { log "FAILED: zfs set mountpoint=none ${aside}"; return 1; }
  if ! children="$(zfs list -H -o name -t filesystem -r "$aside")"; then
    log "FAILED: cannot list the filesystems under ${aside}"
    return 1
  fi
  while IFS= read -r child; do
    [[ -n "$child" && "$child" != "$aside" ]] || continue
    zfs inherit mountpoint "$child" || { log "FAILED: zfs inherit mountpoint ${child}"; return 1; }
  done <<< "$children"
}

# Puts the renamed-aside tree back under its name after a failed force restore,
# replacing any partial tree the receive left there. Each recorded child
# mountpoint is set again and the whole tree must mount.
_force_restore_rollback() {
  local dst="$1" aside="$2" mp_value="$3" mp_source="$4" rc=0
  local mp_cmd="zfs inherit mountpoint ${dst}"
  if [[ "$mp_source" == local || "$mp_source" == received ]]; then
    mp_cmd="zfs set mountpoint=${mp_value} ${dst}"
  fi
  if [[ -z "$aside" ]]; then
    log "FORCE restore of ${dst} FAILED. No previous tree existed, so there is nothing to roll back to."
    # Nothing stood at the name before the receive, so whatever is there now is
    # this run's partial tree.
    if dataset_present "$dst"; then
      if zfs destroy -r "$dst"; then
        log "  Destroyed the partial ${dst} this run received."
      else
        log "  A partial ${dst} remains; destroy it with 'zfs destroy -r ${dst}'."
        return 1
      fi
    fi
    return 0
  fi
  log "FORCE restore of ${dst} FAILED; rolling back to the previous tree ${aside}"
  if { dataset_present "$dst" && ! zfs destroy -r "$dst"; } \
     || ! zfs rename "$aside" "$dst" \
     || ! _restore_mountpoint "$dst" "$mp_value" "$mp_source"; then
    log "ROLLBACK FAILED. The previous tree is ${aside}. Roll back by hand:"
    log "  If a partial ${dst} exists: zfs destroy -r ${dst}"
    log "  zfs rename ${aside} ${dst} && ${mp_cmd} && zfs mount -R ${dst}"
    return 1
  fi
  _force_restore_child_mountpoints "$dst" || rc=1
  if [[ "$rc" -ne 0 ]] || ! _restore_mount_and_verify "$dst"; then
    log "ROLLBACK INCOMPLETE: ${dst} holds the previous tree again, but not every filesystem in it is back at its mountpoint."
    return 1
  fi
  log "Rolled back: ${dst} holds the previous tree again"
}

# Returns 0 restored, 1 failed, 3 skipped: no backup dataset or no archsync
# snapshot to restore from.
_restore_one() {
  local bdst="$1" mode="$2"  # mode: safe|force
  local dst="${RMAP[$bdst]}"
  local label
  label="$(basename "$bdst")"

  dataset_present "$bdst" || { log "SKIP restore: missing backup dataset $bdst"; return 3; }

  local snap_full snap_rc=0
  snap_full="$(latest_backup_snapshot_fullname "$bdst")" || snap_rc=$?
  if [[ "$snap_rc" -ne 0 ]]; then
    log "FAILED restore of ${bdst}: cannot list its snapshots, so nothing was touched"
    return 1
  fi
  [[ -n "$snap_full" ]] || { log "SKIP restore: no ${SNAP_PREFIX}- snapshots on $bdst"; return 3; }

  # Encrypted backups can only be sent raw, so the restored dataset is itself
  # encrypted and needs the source's `zfs load-key` before it mounts. Detected
  # recursively: `zfs send -R` over any encrypted descendant requires -w.
  local raw_flags=() enc_rc=0
  tree_is_encrypted "$bdst" || enc_rc=$?
  case "$enc_rc" in
    0)
      raw_flags=(-w)
      log "Note: ${bdst} contains encrypted datasets; restoring raw (run 'zfs load-key' on the restored dataset before mounting)"
      ;;
    1) ;;
    *) log "FAILED restore of ${bdst}: encryption unknown, so nothing was touched"; return 1 ;;
  esac

  local ts
  ts="$(date +%Y%m%d-%H%M%S)"

  if [[ "$mode" == "safe" ]]; then
    local restore_dst="${dst}-restore-${ts}"
    log "SAFE restore: ${snap_full} -> ${restore_dst} (non-destructive)"
    if ! zfs send -R "${raw_flags[@]}" "${snap_full}" | zfs receive -u "${restore_dst}"; then
      log "FAILED: SAFE restore of ${snap_full}; the live ${dst} is untouched"
      # The name carries this run's timestamp, so a partial tree is this run's own.
      if dataset_present "$restore_dst"; then
        if zfs destroy -r "$restore_dst"; then
          log "  Destroyed the partial ${restore_dst} this run received."
        else
          log "  A partial ${restore_dst} remains on the source pool; destroy it with 'zfs destroy -r ${restore_dst}'."
        fi
      fi
      return 1
    fi
    mkdir -p "${RESTORE_BASE}"
    _restore_mount_tree "${restore_dst}" "${label}" "${ts}" || return 1
    return 0
  fi

  local mp_value="" mp_source="" mp_line aside=""
  _FORCE_CHILD_MP=()
  if dataset_present "$dst"; then
    if ! mp_line="$(zfs get -H -o value,source mountpoint "$dst")"; then
      log "FAILED restore of ${dst}: cannot read its mountpoint, so nothing was touched"
      return 1
    fi
    mp_value="${mp_line%%$'\t'*}"
    mp_source="${mp_line#*$'\t'}"
    if ! _force_restore_clear_target "$dst" "$ts"; then
      if [[ -n "$_FORCE_ASIDE" ]]; then
        _force_restore_rollback "$dst" "$_FORCE_ASIDE" "$mp_value" "$mp_source" || true
      else
        log "FORCE restore of ${dst} FAILED: ${dst} was not renamed and is untouched."
      fi
      return 1
    fi
    aside="$_FORCE_ASIDE"
  fi
  log "FORCE restore (destructive): ${snap_full} -> ${dst}"
  if ! zfs send -R "${raw_flags[@]}" "${snap_full}" | zfs receive -u "${dst}"; then
    _force_restore_rollback "$dst" "$aside" "$mp_value" "$mp_source" || true
    return 1
  fi
  if ! _force_restore_reset_props "$dst" "$mp_value" "$mp_source"; then
    [[ -z "$aside" ]] || log "The previous tree is kept as ${aside}."
    return 1
  fi
  [[ -z "$aside" ]] || log "Kept the previous ${dst} as ${aside}, unmounted, with its space still on the source pool. Destroy it with 'zfs destroy -r ${aside}' once the restore is verified."
}

# An excluded child has no archive copy, so a force restore of its parent moves
# it aside or destroys it and brings nothing back in its place.
_force_guard_excluded() {
  local src="$1" allow="$2" ex rc=0
  for ex in "${EXCLUDE_LIST[@]}"; do
    [[ "$ex" == "$src"/* ]] || continue
    dataset_present "$ex" || continue
    if [[ "$allow" -eq 1 ]]; then
      log "WARNING: ${ex} is excluded from the archive; restore-force ${src##*/} leaves it out of the restored tree (--force-excluded)"
      continue
    fi
    log "REFUSED: ${ex} is excluded from the archive, so restore-force ${src##*/} would remove it and restore nothing in its place."
    log "  Restore the replicated children one at a time instead (nas_storage README, Archive backup restore), or pass --force-excluded."
    rc=1
  done
  return "$rc"
}

# fuser exits 1 both for "no holders" and for a failed probe; no output or the
# bare "<path>:" header means it looked, as in files/mergerfs-idle-probe.sh.
# Returns 0 held, 1 not held, 2 unknown, and leaves the output in _PROBE_OUT.
_PROBE_OUT=""
_fuser_probe() {
  local rc=0 path="${!#}" seen
  _PROBE_OUT="$(fuser "$@" 2>&1)" || rc=$?
  [[ "$rc" -eq 0 ]] && return 0
  seen="${_PROBE_OUT//[[:space:]]/}"
  [[ "$rc" -eq 1 && ( -z "$seen" || "$seen" == "${path//[[:space:]]/}:" ) ]] && return 1
  return 2
}

# _held_report <allow> <label> <what> [<remedy>]: logs a path that holds the
# restore, and returns 1 when that refuses it.
_held_report() {
  local allow="$1" label="$2" what="$3" remedy="${4:-Stop it first}"
  if [[ "$allow" -eq 1 ]]; then
    log "WARNING: ${label} ${what}; restoring over it anyway (--force-held)"
    return 0
  fi
  log "REFUSED: ${label} ${what}. ${remedy}, or pass --force-held."
  return 1
}

# _held_verdict <allow> <label> <fuser args...>: 1 when the path refuses the restore.
_held_verdict() {
  local allow="$1" label="$2" prc=0
  shift 2
  _fuser_probe "$@" || prc=$?
  case "$prc" in
    1) return 0 ;;
    0) _held_report "$allow" "$label" "is held open by a running guest, container or process" ;;
    *) _held_report "$allow" "$label" "could not be checked for holders: ${_PROBE_OUT//$'\n'/; }" ;;
  esac
}

# Prints the MAJ:MIN of the filesystem holding a path. Each mounted dataset has
# its own, and a bind mount shares its source's.
_mount_devid() {
  local out
  out="$(findmnt -n -o MAJ:MIN --target "$1" 2>/dev/null)" || return 1
  out="${out//[[:space:]]/}"
  [[ -n "$out" ]] || return 1
  printf '%s' "$out"
}

# _force_guard_exported <allow> <mountpoint...>: kernel nfsd serves an export
# without a process, so fuser never sees its clients. A mountpoint is exported
# when an export path is on that filesystem, directly or by bind, or above it.
_force_guard_exported() {
  local allow="$1" exports exp mp edev rc=0
  shift
  [[ "$#" -gt 0 ]] || return 0
  # exportfs ships with the NFS server, so a host without it exports nothing.
  command -v exportfs >/dev/null 2>&1 || return 0
  if ! exports="$(exportfs -s 2>&1)"; then
    _held_report "$allow" "the NFS export table" "could not be read: ${exports//$'\n'/; }" \
      "Unexport the datasets under the target first"
    return
  fi
  local -A mdev=()
  for mp in "$@"; do
    mdev["$mp"]="$(_mount_devid "$mp")" || mdev["$mp"]=""
  done
  while read -r exp _; do
    [[ "$exp" == /* ]] || continue
    exp="$(printf '%b' "$exp")"
    edev="$(_mount_devid "$exp")" || edev=""
    for mp in "$@"; do
      if [[ "$exp" == "$mp" || "$exp" == "$mp"/* || "$mp" == "$exp"/* \
            || ( -n "$edev" && "$edev" == "${mdev[$mp]}" ) ]]; then
        _held_report "$allow" "$mp" "is exported over NFS as ${exp}" \
          "Stop its NFS clients and unexport it with 'exportfs -u' first" || rc=1
      elif [[ -z "$edev" || -z "${mdev[$mp]}" ]]; then
        _held_report "$allow" "$mp" "could not be checked against the NFS export ${exp}" \
          "Unexport ${exp} first" || rc=1
      fi
    done
  done <<< "$exports"
  return "$rc"
}

# A zvol a guest holds open, or a mounted filesystem a process or NFS client
# uses, keeps its writer through the rename and splits from the restored copy.
# Without fuser the holders cannot be known, so that refuses too.
_force_guard_held() {
  local src="$1" allow="$2" vols fss vol name mp mounted path targets target rc=0
  local -a devs=() mnts=()
  dataset_present "$src" || return 0
  if ! vols="$(zfs list -H -o name -t volume -r "$src" 2>/dev/null)" \
     || ! fss="$(zfs list -H -o name,mountpoint,mounted -t filesystem -r "$src" 2>/dev/null)"; then
    if [[ "$allow" -eq 1 ]]; then
      log "WARNING: cannot list the datasets under ${src}; they were not checked for holders (--force-held)"
      return 0
    fi
    log "REFUSED: cannot list the datasets under ${src}; pass --force-held to skip the holder check."
    return 1
  fi
  while IFS= read -r vol; do
    [[ -n "$vol" && -e "${ZVOL_DEV_DIR}/${vol}" ]] && devs+=( "${ZVOL_DEV_DIR}/${vol}" )
  done <<< "$vols"
  # A legacy mountpoint is mounted by fstab or a mount unit, so its paths come
  # from the mount table rather than the property.
  while IFS=$'\t' read -r name mp mounted; do
    [[ -n "$name" && "$mounted" == yes ]] || continue
    if [[ "$mp" == /* ]]; then
      mnts+=( "$mp" )
      continue
    fi
    targets="$(findmnt -rn -o TARGET -t zfs -S "$name" 2>/dev/null)" || targets=""
    if [[ -z "$targets" ]]; then
      _held_report "$allow" "$name" "is mounted with mountpoint=${mp} at a path that could not be resolved" \
        "Unmount it first" || rc=1
      continue
    fi
    while IFS= read -r target; do
      [[ -n "$target" ]] && mnts+=( "$(printf '%b' "$target")" )
    done <<< "$targets"
  done <<< "$fss"
  [[ "${#devs[@]}" -gt 0 || "${#mnts[@]}" -gt 0 ]] || return "$rc"
  _force_guard_exported "$allow" "${mnts[@]}" || rc=1
  if ! command -v fuser >/dev/null 2>&1; then
    if [[ "$allow" -eq 1 ]]; then
      log "WARNING: fuser is not installed; the datasets under ${src} were not checked for holders (--force-held)"
      return "$rc"
    fi
    log "REFUSED: fuser is not installed, so the datasets under ${src} cannot be checked for holders; install psmisc or pass --force-held."
    return 1
  fi
  for path in "${devs[@]}"; do
    _held_verdict "$allow" "$path" "$path" || rc=1
  done
  for path in "${mnts[@]}"; do
    _held_verdict "$allow" "$path" -m "$path" || rc=1
  done
  return "$rc"
}

# Valid restore targets, derived from SRC_LIST basenames (for usage strings).
_restore_usage_targets() {
  local out="" src
  for src in "${SRC_LIST[@]}"; do
    out+="${src##*/}|"
  done
  printf '%s' "${out}all"
}

# A restore READS the archive but WRITES into the source pool, so it must never
# interleave with the nightly replication reading and pruning the same datasets:
# it takes the same single-instance lock cmd_run uses.
_cmd_restore_impl() {
  local mode="$1" cmd_name="$2"
  shift 2
  local what="" arg force_excluded=0 force_held=0
  for arg in "$@"; do
    case "$arg" in
      --force-excluded|--force-held)
        [[ "$mode" == force ]] || { echo "${arg} applies to restore-force only" >&2; exit 2; }
        case "$arg" in
          --force-excluded) force_excluded=1 ;;
          --force-held) force_held=1 ;;
        esac ;;
      -*) echo "Unknown option: ${arg}" >&2; exit 2 ;;
      *)
        [[ -z "$what" ]] || { echo "Only one restore target is accepted" >&2; exit 2; }
        what="$arg" ;;
    esac
  done

  _take_run_lock_or_die

  pool_present || { log "Pool '${POOL_DST}' not present. Run: archive-backupctl plug or plug-arm first."; exit 1; }

  [[ -n "$what" ]] || { echo "Usage: archive-backupctl ${cmd_name} <$(_restore_usage_targets)>" >&2; exit 2; }

  local -a targets=()
  local src bdst
  if [[ "$what" == "all" ]]; then
    for src in "${SRC_LIST[@]}"; do
      targets+=( "${MAP[$src]}" )
    done
  else
    bdst="${POOL_DST}/${what}"
    if [[ -z "${RMAP[$bdst]:-}" ]]; then
      echo "Unknown restore target: $what" >&2
      exit 2
    fi
    targets=( "$bdst" )
  fi

  # Every target is checked before any is touched, so a refusal leaves nothing
  # half restored.
  if [[ "$mode" == force ]]; then
    local refused=0
    for bdst in "${targets[@]}"; do
      _force_guard_excluded "${RMAP[$bdst]}" "$force_excluded" || refused=1
      _force_guard_held "${RMAP[$bdst]}" "$force_held" || refused=1
    done
    [[ "$refused" -eq 0 ]] || exit 1
  fi

  # A failure stops the run. A target with nothing to restore is skipped, and
  # fails the run once the other targets are done.
  local -a skipped=()
  local orc
  for bdst in "${targets[@]}"; do
    orc=0
    _restore_one "$bdst" "$mode" || orc=$?
    case "$orc" in
      0) ;;
      3) skipped+=( "${bdst##*/}" ) ;;
      *) exit 1 ;;
    esac
  done
  if [[ "${#skipped[@]}" -gt 0 ]]; then
    log "FAILED: nothing was restored for ${skipped[*]}: no backup dataset or no ${SNAP_PREFIX}- snapshot"
    exit 1
  fi
}

cmd_restore() {
  _cmd_restore_impl safe restore "$@"
  log "Restore (safe) complete. Restores are under: ${RESTORE_BASE}/<target>/<timestamp>/ (space consumed on the source pool)"
}

cmd_restore_force() {
  _cmd_restore_impl force restore-force "$@"
  log "Restore (FORCE) complete."
}

usage() {
  cat <<USAGE
Usage: archive-backupctl <command> [args]   (run as root)

Commands:
  run                 Run replication now (safe if archive is exported/unplugged; exits 0)
  enable              Enable + start the systemd timer
  disable             Disable + stop the systemd timer
  status              Show timer/service/pool status
  unplug              Disable timer, unmount archive datasets, export pool (safe to unplug)
  plug                Import pool, enable timer, and run replication now
  plug-arm            Import pool, lock/unmountable, enable timer (NO immediate run)

  restore <target>        SAFE restore into new *-restore-YYYYMMDD-HHMMSS datasets
                          ON THE SOURCE POOL (space cost lands there), mounted
                          under ${RESTORE_BASE}/<target>/<timestamp>/
  restore-force <target> [--force-excluded] [--force-held]
                          DESTRUCTIVE restore in place. The existing dataset is
                          renamed to <dataset>-pre-restore-YYYYMMDD-HHMMSS and
                          unmounted first; its space stays on the source pool
                          until you destroy it. A failed receive renames it
                          back.
                          Refuses a target holding an excluded child
                          (--force-excluded overrides), or a zvol or mounted
                          filesystem a guest, container or process holds open
                          or that is exported over NFS (--force-held overrides).
                          targets: $(_restore_usage_targets)
USAGE
}

main() {
  need_root
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    run) cmd_run ;;
    __run-one) cmd_run_one "${1:?dataset required}" ;;
    enable) cmd_enable ;;
    disable) cmd_disable ;;
    status) cmd_status ;;
    unplug) cmd_unplug ;;
    plug) cmd_plug ;;
    plug-arm) cmd_plug_arm ;;
    restore) cmd_restore "$@" ;;
    restore-force) cmd_restore_force "$@" ;;
    ""|help|-h|--help) usage ;;
    *) echo "Unknown command: $cmd" >&2; usage; exit 2 ;;
  esac
}

main "$@"
{% endraw %}
