# {{ ansible_managed }}
[Unit]
Description=Nightly ZFS replication to archive pool

[Timer]
# Default 06:30 — after the nightly cluster backup window; the in-script quiesce
# guard defers the vzdump target to the next run if that window overruns.
OnCalendar={{ nas_storage_archive_backup_schedule | default('*-*-* 06:30:00') }}
Persistent=true
RandomizedDelaySec={{ nas_storage_archive_backup_random_delay | default('10m') }}

[Install]
WantedBy=timers.target
