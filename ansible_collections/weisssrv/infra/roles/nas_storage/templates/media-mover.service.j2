# {{ ansible_managed }}
[Unit]
Description=Move media from NVMe hot to tank
RequiresMountsFor={{ nas_storage_media_mover_src }} {{ nas_storage_media_mover_dst }}
After=zfs-mount.service

[Service]
Type=oneshot
# Load-shaping: keep the nightly nvme->tank move from adding to the fleet-wide
# spike. Nice + ionice set absolute priority; CPUWeight/IOWeight (below the 100
# default) proportionally deprioritize it only under contention (a no-op when
# the NAS is otherwise idle).
Nice={{ nas_storage_media_mover_nice | default(10) }}
IOSchedulingClass={{ nas_storage_media_mover_io_class | default('best-effort') }}
IOSchedulingPriority={{ nas_storage_media_mover_io_priority | default(7) }}
CPUWeight={{ nas_storage_media_mover_cpu_weight | default(20) }}
IOWeight={{ nas_storage_media_mover_io_weight | default(20) }}
# Namespace-free hardening only: ProtectSystem/ProtectHome/PrivateTmp would
# put the unit in a private mount namespace, detached from the live ZFS mounts.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
ExecStart=/usr/local/sbin/media-mover.sh
