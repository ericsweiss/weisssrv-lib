# {{ ansible_managed }}

[OPTIONS]

enable: 1
log_level_in: {{ proxmox_firewall_log_level_in }}
log_level_out: nolog
{% if proxmox_firewall_nftables | default(false) | bool %}
nftables: 1
{% endif %}

[RULES]

{% for rule in proxmox_firewall_host_rules | default([]) %}
{{ rule }}
{% endfor %}

GROUP sg-pve-cluster
GROUP sg-host-admin
GROUP sg-metrics
{% if proxmox_firewall_egress_filtering | default(false) %}
# Host-originated egress default-deny: the sg-host-egress allowlist then an
# explicit OUT DROP. pve-firewall ignores the host-level policy_out option, so
# this trailing DROP is what enforces it. Enable per host and verify.
GROUP sg-host-egress
OUT DROP -log info
{% endif %}

{# Exact match (not substring) against proxmox_firewall_storage_role_name, so a
   role string that merely contains it ('nas-backup') does not inherit the
   file-server groups and expose those server ports. #}
{% if (proxmox_role | default('')) == proxmox_firewall_storage_role_name %}
# File-server rules
GROUP sg-nfs-server
GROUP sg-smb-server
{% endif %}
{% for group in proxmox_firewall_host_extra_groups | default([]) %}
GROUP {{ group }}
{% endfor %}
