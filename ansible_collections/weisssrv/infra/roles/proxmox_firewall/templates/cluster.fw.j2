# {{ ansible_managed }}

[OPTIONS]

enable: 1
policy_in: DROP
policy_out: ACCEPT

[ALIASES]

{# NOTE: opens with `{#`, not `{#-`. A leading `-` here strips the trailing
   whitespace of the preceding text node — i.e. the blank line that separates
   the `[ALIASES]` section header from its first entry — and renders
   `[ALIASES]<first-alias>` on one line, which pve-firewall will not parse.
   Host-backed aliases come from inventory: any host setting `firewall_alias`
    contributes one, pointing at the same address the IPSets use. That keeps the
    alias list from duplicating (and drifting from) the host addresses. Aliases
    for things that are not inventory hosts (VIPs, off-cluster peers) go in
    proxmox_firewall_extra_aliases; an extra with the same name wins. -#}
{%- set derived_aliases = [] -%}
{%- for host in groups['all'] | sort -%}
  {%- set hv = hostvars[host] -%}
  {%- if hv.get('firewall_alias') -%}
    {%- set _ = derived_aliases.append({
          'name': hv['firewall_alias'],
          'cidr': hv['proxmox_firewall_node_ip'] | default(hv['ansible_host']),
          'comment': hv.get('firewall_alias_comment', host)}) -%}
  {%- endif -%}
{%- endfor -%}
{%- set extra_names = proxmox_firewall_extra_aliases | default([]) | map(attribute='name') | list -%}
{% for alias in (derived_aliases | rejectattr('name', 'in', extra_names) | list)
                + (proxmox_firewall_extra_aliases | default([])) %}
{{ alias.name }} {{ alias.cidr }}{% if alias.comment is defined %} # {{ alias.comment }}{% endif %}

{% endfor %}

[IPSET admin_lan]

# Sources allowed at the management plane (:22, :8006, :6443). A whole-subnet
# entry also admits every other device on that L2, so narrow this to a dedicated
# management subnet wherever VLAN segmentation exists.
{% for cidr in proxmox_firewall_admin_lan_cidrs %}
{{ cidr }}
{% endfor %}

[IPSET admin_ts]

# Admin overlay network — the full Tailscale CGNAT range by default rather than
# per-device pins, which risk DR lockout. Narrow it if the tailnet carries
# non-admin members.
{% for cidr in proxmox_firewall_admin_ts_cidrs %}
{{ cidr }}
{% endfor %}

{% include 'ipsets.j2' %}

[IPSET smb_clients]

# Hosts allowed SMB access
{% for cidr in proxmox_firewall_smb_client_cidrs %}
{{ cidr }}
{% endfor %}

[group sg-dns]

# DoT (DNS over TLS)
IN ACCEPT -source +dc/admin_ts -p udp -dport 853 -log nolog
IN ACCEPT -source +dc/admin_lan -p udp -dport 853 -log nolog
IN ACCEPT -source +dc/admin_ts -p tcp -dport 853 -log nolog
IN ACCEPT -source +dc/admin_lan -p tcp -dport 853 -log nolog
{# Resolver admin surfaces (AdGuard Home's HTTPS UI on :443 and its plaintext
   admin API on :3000). Both port and source sets are site data: the plaintext
   API carries a reusable admin credential, so a scraper reaching it from the
   cluster has to be declared, not inherited. #}
{% for entry in proxmox_firewall_dns_admin_ports | default([]) %}
{% for src in entry.sources %}
IN ACCEPT -source +dc/{{ src }} -p tcp -dport {{ entry.port }} -log nolog{% if entry.comment is defined %} # {{ entry.comment }}{% endif %}

{% endfor %}
{% endfor %}
{# Standard DNS. The client scope is site data
   (proxmox_firewall_dns_client_sources): resolution is a service every VLAN
   needs, which is a wider set than the admin sets the resolver's own
   management surfaces above are pinned to. Default = the two admin sets, so an
   unsegmented site renders exactly what it always did. #}
# Standard DNS
{% for src in proxmox_firewall_dns_client_sources %}
IN ACCEPT -source +dc/{{ src }} -p tcp -dport 53 -log nolog
IN ACCEPT -source +dc/{{ src }} -p udp -dport 53 -log nolog
{% endfor %}

{# Per-application groups are site data, supplied as
   proxmox_firewall_security_groups (empty by default; worked example in the
   role README). Rules are emitted verbatim, in order, comments included. #}
{% for group in proxmox_firewall_security_groups | default([]) %}
[group {{ group.name }}]

{% for line in group.rules | default([]) %}
{{ line }}
{% endfor %}

{% endfor %}
[group sg-host-admin]

IN ACCEPT -source +dc/admin_ts -p tcp -dport 8006 -log nolog # Proxmox
IN ACCEPT -source +dc/admin_lan -p tcp -dport 8006 -log nolog # Proxmox
IN ACCEPT -source +dc/admin_ts -p tcp -dport 22 -log nolog
IN ACCEPT -source +dc/admin_lan -p tcp -dport 22 -log nolog
IN ACCEPT -source +dc/admin_ts -p icmp -log nolog
IN ACCEPT -source +dc/admin_lan -p icmp -log nolog

[group sg-vm-admin]

IN ACCEPT -source +dc/admin_ts -p tcp -dport 22 -log nolog
IN ACCEPT -source +dc/admin_lan -p tcp -dport 22 -log nolog
IN ACCEPT -source +dc/admin_ts -p icmp -log nolog
IN ACCEPT -source +dc/admin_lan -p icmp -log nolog

[group sg-k3s-core]

IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 2379:2380 -log nolog
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 2381 -log nolog  # etcd metrics (kubeEtcd scrape)
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 10250 -log nolog
# Flannel wireguard-native backend (pod-to-pod encrypted).
IN ACCEPT -source +dc/k3s_nodes -p udp -dport 51820 -log nolog
# MetalLB speaker memberlist (L2 leader election between speakers)
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 7946 -log nolog
IN ACCEPT -source +dc/k3s_nodes -p udp -dport 7946 -log nolog
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 9345 -log nolog
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 6443 -log nolog
IN ACCEPT -source +dc/admin_ts -p tcp -dport 6443 -log nolog
IN ACCEPT -source +dc/admin_lan -p tcp -dport 6443 -log nolog

[group sg-k3s-ingress-int]

{# The internal ingress serves ordinary users, not just operators, so its client
   scope is site data (proxmox_firewall_k3s_ingress_int_sources) rather than the
   admin sets. Default = the two admin sets — unchanged for an unsegmented
   site. Port stays the outer loop: :443 for every source, then :80. #}
{% for port in [443, 80] %}
{% for src in proxmox_firewall_k3s_ingress_int_sources %}
IN ACCEPT -source +dc/{{ src }} -p tcp -dport {{ port }} -log nolog
{% endfor %}
{% endfor %}

[group sg-k3s-ingress-pub]

IN ACCEPT -p tcp -dport 443 -log nolog
IN ACCEPT -p tcp -dport 80 -log nolog
# WireGuard VPN endpoint from the WAN (the router forwards :51820/udp to a
# load-balancer VIP). `-dest` scopes each rule to that VIP so it does NOT open
# the node's own :51820/udp — that is flannel wireguard-native (sg-k3s-core,
# k3s_nodes only), which must stay off the WAN. Empty list = no WAN WireGuard.
{% for vip in proxmox_firewall_wan_wireguard_vips | default([]) %}
IN ACCEPT -dest {{ vip }} -p udp -dport 51820 -log nolog
{% endfor %}

[group sg-nfs-server]

IN ACCEPT -source +dc/nfs_clients -p udp -dport 111 -log nolog
IN ACCEPT -source +dc/nfs_clients -p tcp -dport 111 -log nolog
IN ACCEPT -source +dc/nfs_clients -p tcp -dport 2049 -log nolog

[group sg-metrics]

# Prometheus scraping from k3s cluster (k3s SNATs pod traffic to node IPs).
# Built in: the exporters this collection's own roles bind. host.fw applies this
# group on every node, so application scrape targets are site data
# (proxmox_firewall_metrics_scrape_ports) rather than ports opened fleet-wide
# for an app that may not be there.
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 9100 -log nolog  # node-exporter
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 9101 -log nolog  # node-exporter-host (bare metal)
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 9134 -log nolog  # zfs-exporter
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 9167 -log nolog  # unbound-exporter
{% for entry in proxmox_firewall_metrics_scrape_ports | default([]) %}
{% for src in entry.sources %}
IN ACCEPT -source +dc/{{ src }} -p tcp -dport {{ entry.port }} -log nolog{% if entry.comment is defined %}  # {{ entry.comment }}{% endif %}

{% endfor %}
{% endfor %}

[group sg-pve-cluster]

# Proxmox auto-permits intra-cluster traffic via a built-in macro, so this
# group is belt-and-suspenders.
IN ACCEPT -source +dc/pve_hosts -p tcp -dport 8006 -log nolog
{% if proxmox_firewall_insecure_migration_ports | default(false) %}
# Cleartext live-migration channel. Only reachable when datacenter.cfg carries
# `migration: type=insecure` (proxmox_ha pins secure by default), and it moves
# guest RAM unencrypted — keep this off unless that trade is deliberate.
IN ACCEPT -source +dc/pve_hosts -p tcp -dport 60000:60050 -log nolog
{% endif %}
IN ACCEPT -source +dc/pve_hosts -p tcp -dport 22 -log nolog
# corosync totem ring UDP ports: 5405 = ring0 (single-ring default), 5406 =
# ring1 (reserved for a future second knet link). If the knet ring layout
# changes (confirm with `corosync-cmapctl | grep mcastport`), update to match.
IN ACCEPT -source +dc/pve_hosts -p udp -dport 5406 -log nolog
IN ACCEPT -source +dc/pve_hosts -p udp -dport 5405 -log nolog

[group sg-smb-server]

IN ACCEPT -source +dc/smb_clients -p tcp -dport 445 -log nolog

[group sg-smtp-relay]

# SMTP submission from core cluster
IN ACCEPT -source +dc/core-cluster -p tcp -dport 587 -log nolog
# SMTP relay from core cluster
IN ACCEPT -source +dc/core-cluster -p tcp -dport 25 -log nolog
# Outbound egress allowlist. Only enforced when the guest's .fw sets
# policy_out: DROP (guest_firewall_policy_out in the guest's inventory entry) —
# Proxmox's guest default is policy_out ACCEPT, which makes these OUT ACCEPTs
# no-ops. conntrack auto-allows replies to inbound 25/587.
# DNS and SMTP submission (upstream relay to Gmail)
OUT ACCEPT -p udp -dport 853 -log nolog
OUT ACCEPT -p tcp -dport 853 -log nolog
OUT ACCEPT -p udp -dport 53 -log nolog
OUT ACCEPT -p tcp -dport 53 -log nolog
OUT ACCEPT -p tcp -dport 587 -log nolog
# apt (the base role runs apt inside the LXC) + ICMP diagnostics
OUT ACCEPT -p tcp -dport 80 -log nolog
OUT ACCEPT -p tcp -dport 443 -log nolog
OUT ACCEPT -p tcp -dport 31100 -log nolog       # Loki push NodePort fallback (alloy_host_loki_url)
OUT ACCEPT -p icmp -log nolog

[group sg-host-egress]

# Host-originated egress allowlist, referenced by host.fw only where
# proxmox_firewall_egress_filtering is true (inert otherwise). conntrack
# auto-allows RELATED/ESTABLISHED replies, so these cover only NEW outbound
# connections the node initiates; tune them from the OUT DROP rule's drop logs.
OUT ACCEPT -p udp -dport 53 -log nolog          # DNS
OUT ACCEPT -p tcp -dport 53 -log nolog          # DNS over TCP
OUT ACCEPT -p udp -dport 853 -log nolog         # DNS over TLS
OUT ACCEPT -p tcp -dport 853 -log nolog         # DNS over TLS
OUT ACCEPT -p udp -dport 123 -log nolog         # NTP
OUT ACCEPT -p tcp -dport 80 -log nolog          # apt / HTTP
OUT ACCEPT -p tcp -dport 443 -log nolog         # apt, Proxmox repos, Tailscale control/DERP, 1Password Connect
OUT ACCEPT -p udp -dport 41641 -log nolog       # Tailscale direct
OUT ACCEPT -p udp -dport 3478 -log nolog        # Tailscale STUN
OUT ACCEPT -p tcp -dport 22 -log nolog          # SSH (migration, host-to-host, cert distribution)
OUT ACCEPT -p tcp -dport 2222 -log nolog        # GitLab SSH
OUT ACCEPT -p tcp -dport 587 -log nolog         # SMTP submission to relay
OUT ACCEPT -p tcp -dport 25 -log nolog          # SMTP relay
OUT ACCEPT -p tcp -dport 2049 -log nolog        # NFS (backup target / shares)
OUT ACCEPT -p tcp -dport 111 -log nolog         # rpcbind (NFS)
OUT ACCEPT -p udp -dport 111 -log nolog         # rpcbind (NFS)
OUT ACCEPT -p tcp -dport 31100 -log nolog       # Loki push NodePort fallback (alloy_host_loki_url)
OUT ACCEPT -p udp -dport 5404:5412 -log nolog   # corosync cluster membership
OUT ACCEPT -p tcp -dport 8006 -log nolog        # Proxmox API (cluster/migration)
{% if proxmox_firewall_insecure_migration_ports | default(false) %}
OUT ACCEPT -p tcp -dport 60000:60050 -log nolog # cleartext live-migration channel
{% endif %}
OUT ACCEPT -p icmp -log nolog                   # ping/diagnostics

[RULES]

{% for rule in proxmox_firewall_cluster_rules | default([]) %}
{{ rule }}
{% endfor %}
