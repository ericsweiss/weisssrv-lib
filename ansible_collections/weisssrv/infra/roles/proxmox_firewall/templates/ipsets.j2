{#- IPSets derived from each host's firewall_ipsets membership. -#}
{%- set ipset_members = {} -%}
{%- set ipset_comments = {
  'core-cluster': 'Core cluster nodes',
  'k3s_nodes': 'K3s cluster nodes + API VIP',
  'nfs_clients': 'Hosts allowed NFS access',
  'pve_hosts': 'Proxmox VE cluster hosts'
} -%}

{#- Collect hosts and their IPSet memberships. proxmox_firewall_node_ip wraps
    ansible_host so molecule can keep ansible_host on the container while still
    feeding a realistic per-node IP into the render. -#}
{%- for host in groups['all'] -%}
  {%- set host_ip = hostvars[host]['proxmox_firewall_node_ip'] | default(hostvars[host]['ansible_host']) -%}
  {%- set host_ipsets = hostvars[host].get('firewall_ipsets', []) -%}
  {%- for ipset_name in host_ipsets -%}
    {%- if ipset_name not in ipset_members -%}
      {%- set _ = ipset_members.update({ipset_name: []}) -%}
    {%- endif -%}
    {%- set _ = ipset_members[ipset_name].append({'ip': host_ip, 'name': host}) -%}
  {%- endfor -%}
{%- endfor -%}

{#- Add special entries (VIPs, non-host IPs) -#}
{%- for ipset_name, special_entries in (firewall_ipset_special_entries | default({})).items() -%}
  {%- if ipset_name not in ipset_members -%}
    {%- set _ = ipset_members.update({ipset_name: []}) -%}
  {%- endif -%}
  {%- for entry in special_entries -%}
    {%- set _ = ipset_members[ipset_name].append({'ip': entry.ip, 'name': entry.comment | default('')}) -%}
  {%- endfor -%}
{%- endfor -%}

{#- Render every discovered IPSet (sorted): adding a set to a host's
    firewall_ipsets in inventory is enough. A set ipset_comments does not
    describe gets no header comment line. -#}
{%- for ipset_name in ipset_members.keys() | sort %}
[IPSET {{ ipset_name }}]

{% if ipset_comments.get(ipset_name) %}# {{ ipset_comments[ipset_name] }}
{% endif %}
{%- for member in ipset_members[ipset_name] | sort(attribute='ip') -%}
{{ member.ip }}{{ '  # ' ~ member.name if member.name else '' }}
{% endfor %}
{%- endfor -%}
