{# Deployed content (/etc/modprobe.d/vfio.conf) behind the same
   update-grub / rebuild-initramfs / reboot-required handler chain as
   grub-vfio.cfg.j2 — keep byte-stable, narrative in README.md. #}
# {{ ansible_managed }}
# Managed by the vfio_passthrough Ansible role (host-side GPU passthrough).
#
# Bind the listed PCI functions to vfio-pci and keep host drivers off them. The
# primary bind is the vfio-pci.ids= kernel cmdline; this is its modprobe.d twin,
# baked into the initramfs. The role never reboots — the operator does.
options vfio-pci ids={{ vfio_passthrough_pci_ids | join(',') }}
{% for mod in vfio_passthrough_blacklist_modules %}
# {{ mod }}: hard-blacklisted (never loads) — vfio-pci claims its function via ids=.
blacklist {{ mod }}
{% endfor %}
{% for mod in vfio_passthrough_softdep_modules %}
# {{ mod }} loads at boot for other host devices; make vfio-pci win the race for
# the passed-through function by loading it first.
softdep {{ mod }} pre: vfio-pci
{% endfor %}
