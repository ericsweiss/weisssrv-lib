#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Distributes the renewed wildcard cert to every distribution target, as root on
# the cert authority host; --check only probes them. Schema: acme_certs README.

set -euo pipefail

_CERT_START_TS="$(date +%s)"

PROM_DIR="{{ acme_certs_textfile_dir }}"
# node_exporter_host normally owns this dir; a cron-driven reload on a fresh
# host can run first.
mkdir -p "$PROM_DIR"
PROM_FILE="${PROM_DIR}/cert_renewal.prom"
PROM_TARGET_FILE="${PROM_DIR}/cert_distribution_targets.prom"

# Check mode probes every target and refreshes the distribution gauges without
# pushing, reloading or writing $PROM_FILE. An unrecognised argument is fatal,
# so a typo cannot turn the daily check into a push.
CHECK_ONLY=0
case "${1:-}" in
    --check) CHECK_ONLY=1 ;;
    "") ;;
    *) echo "usage: $0 [--check]" >&2; exit 1 ;;
esac
if [ "${HOMELAB_CERT_CHECK:-0}" = "1" ]; then
    CHECK_ONLY=1
fi

# A probe is retried before it writes 0: the gauge holds until the next daily
# run, so one SSH blip would otherwise read as a dead target for a whole day.
CHECK_RETRIES={{ acme_certs_distribution_check_retries }}
CHECK_RETRY_DELAY={{ acme_certs_distribution_check_retry_delay }}

write_prom_metrics() {
  local success="$1" duration="$2"
  local ts notafter_epoch=""
  ts="$(date +%s)"
  # Computed before the redirected block so a parse warning reaches real stderr,
  # and emitted on failed runs too: CertExpiringSoon's absent() clause needs it.
  notafter_epoch="$(date -d "$(openssl x509 -enddate -noout -in "$FULLCHAIN_SRC" 2>/dev/null | cut -d= -f2)" +%s 2>/dev/null || true)"
  [ -n "$notafter_epoch" ] || echo "warning: could not parse cert notAfter; cert_local_expiry_timestamp_seconds omitted" >&2
  # Staleness must measure time since the last SUCCESS, so a failed run re-emits
  # the previous timestamp rather than dropping the series.
  local sval
  if [ "$success" -eq 1 ]; then
    sval="$ts"
  else
    sval="$(awk -v k=cert_renewal_last_success_timestamp_seconds '$1 == k { v = $2 } END { if (v != "") print v }' "$PROM_FILE" 2>/dev/null || true)"
  fi
  local tmp="${PROM_FILE}.$$"
  {
    echo "# HELP cert_renewal_last_run_duration_seconds Duration of last cert renewal run"
    echo "# TYPE cert_renewal_last_run_duration_seconds gauge"
    echo "cert_renewal_last_run_duration_seconds ${duration}"
    echo "# HELP cert_renewal_last_run_success Whether the local cert renewal and reload succeeded (1=success, 0=failure)"
    echo "# TYPE cert_renewal_last_run_success gauge"
    echo "cert_renewal_last_run_success ${success}"
    if [ -n "$notafter_epoch" ]; then
      echo "# HELP cert_local_expiry_timestamp_seconds Unix timestamp of the distributed wildcard cert's notAfter"
      echo "# TYPE cert_local_expiry_timestamp_seconds gauge"
      echo "cert_local_expiry_timestamp_seconds ${notafter_epoch}"
    fi
    if [ -n "$sval" ]; then
      echo "# HELP cert_renewal_last_success_timestamp_seconds Unix timestamp of last successful cert renewal"
      echo "# TYPE cert_renewal_last_success_timestamp_seconds gauge"
      echo "cert_renewal_last_success_timestamp_seconds ${sval}"
    fi
  } > "$tmp" 2>/dev/null || {
    logger -t homelab-cert-reload-metrics -p daemon.err "could not write ${PROM_FILE}"
    rm -f "$tmp"
    return 0
  }
  mv "$tmp" "$PROM_FILE" 2>/dev/null || {
    logger -t homelab-cert-reload-metrics -p daemon.err "could not rename ${tmp} -> ${PROM_FILE}"
    rm -f "$tmp"
  }
}

# Per-target metrics so one dead target is visible instead of collapsing into
# the run-level success bit.
_TARGET_METRICS_TMP="$(mktemp)"
_TARGET_METRICS_FLUSHED=0
_TARGET_FAIL_COUNT=0
_TARGETS_WALKED=0
write_target_metric() {
    local host="$1" success="$2"
    [ "$success" -eq 1 ] || _TARGET_FAIL_COUNT=$(( _TARGET_FAIL_COUNT + 1 ))
    printf 'cert_distribution_target_last_run_success{host="%s"} %d\n' \
        "$host" "$success" >> "$_TARGET_METRICS_TMP"
}
flush_target_metrics() {
    # Idempotent: both the end-of-script call and the EXIT trap reach here, and a
    # second pass would rewrite $PROM_TARGET_FILE with headers and no host lines.
    if [[ "$_TARGET_METRICS_FLUSHED" -eq 1 ]]; then
        return
    fi
    # A run that died before the target list says nothing about the targets, so
    # the last run's gauges stand. An empty configured list walks to the end and
    # publishes the empty set, retiring a removed target's series.
    if [[ "$_TARGETS_WALKED" -eq 0 && ! -s "$_TARGET_METRICS_TMP" ]]; then
        rm -f "$_TARGET_METRICS_TMP"
        _TARGET_METRICS_FLUSHED=1
        return 0
    fi
    local tmp="${PROM_TARGET_FILE}.$$"
    {
        echo "# HELP cert_distribution_target_last_run_success Per-target cert distribution success (1=ok, 0=failed)"
        echo "# TYPE cert_distribution_target_last_run_success gauge"
        cat "$_TARGET_METRICS_TMP"
        # Run-level count, so a consumer alerts on "any target failed" without a
        # regex over host labels.
        echo "# HELP cert_distribution_last_run_failed_targets Distribution targets that failed on the last run"
        echo "# TYPE cert_distribution_last_run_failed_targets gauge"
        echo "cert_distribution_last_run_failed_targets ${_TARGET_FAIL_COUNT}"
    } > "$tmp" 2>/dev/null || {
        logger -t homelab-cert-reload-metrics -p daemon.err "could not write ${PROM_TARGET_FILE}"
        rm -f "$tmp" "$_TARGET_METRICS_TMP"
        _TARGET_METRICS_FLUSHED=1
        return 0
    }
    mv "$tmp" "$PROM_TARGET_FILE" 2>/dev/null || {
        logger -t homelab-cert-reload-metrics -p daemon.err "could not rename ${tmp} -> ${PROM_TARGET_FILE}"
        rm -f "$tmp"
    }
    rm -f "$_TARGET_METRICS_TMP"
    _TARGET_METRICS_FLUSHED=1
}

# Cleared by a failed local reload, which is a local failure even though the
# script still exits 2.
_LOCAL_OK=1

trap_write_failure_metrics() {
  local rc="$1"
  local end_ts
  end_ts="$(date +%s)"
  local duration=$(( end_ts - _CERT_START_TS ))
  # Exit 2 is a dead distribution target: the local cert renewed and reloaded,
  # so the renewal bit stays 1 and only the distribution gauges report it.
  local renewal=0
  if [ "$rc" -eq 2 ] && [ "$_LOCAL_OK" -eq 1 ]; then
    renewal=1
  fi
  if [ "$CHECK_ONLY" -eq 0 ]; then
    write_prom_metrics "$renewal" "$duration"
  fi
  flush_target_metrics
}
# shellcheck disable=SC2154 # `rc` is assigned via $? at trap fire time
trap 'rc=$?; if [ "$rc" -ne 0 ]; then trap_write_failure_metrics "$rc"; fi; rm -f "$_TARGET_METRICS_TMP"' EXIT

FULLCHAIN_SRC="{{ acme_certs_local_cert_dir }}/fullchain.pem"
PRIVKEY_SRC="{{ acme_certs_local_cert_dir }}/privkey.pem"
IDENTITY_FILE="{{ acme_certs_ssh_key_path }}"

[[ -r "$FULLCHAIN_SRC" && -r "$PRIVKEY_SRC" ]] || {
    echo "missing $FULLCHAIN_SRC or $PRIVKEY_SRC; nothing to distribute" >&2
    exit 1
}

# StrictHostKeyChecking=yes, never accept-new: every target's host_key is pinned
# in known_hosts, so a rebuilt host or a MITM fails the push loudly.
SSH_OPTS=(-i "$IDENTITY_FILE" -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/root/.ssh/known_hosts -o ConnectTimeout=10)
SCP_OPTS=(-q -i "$IDENTITY_FILE" -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/root/.ssh/known_hosts -o ConnectTimeout=10)

# One dead target must not abort distribution to the rest; the script exits 2.
ANY_FAIL=0

# Boundary between the two PEM parts in the bundle streamed to the receiver.
# Not valid PEM/base64, so it can never collide with cert or key content.
DELIM="===CERT-RECEIVE-BUNDLE-BOUNDARY==="

# Check mode for a sudo target: an empty bundle reaches the receiver, which
# refuses it with "FAIL: empty bundle". That answer proves transport, key, forced
# command and sudo while installing nothing.
check_target_receiver() {
    local host="$1" ip="$2" ssh_user="$3" ssh_port="$4"
    local out rc attempt=0
    while :; do
        if out=$(ssh -p "$ssh_port" "${SSH_OPTS[@]}" "${ssh_user}@${ip}" \
                    </dev/null 2>&1); then
            rc=0
        else
            rc=$?
        fi
        printf '%s\n' "$out" | grep -q 'FAIL: empty bundle' && break
        [ "$attempt" -ge "$CHECK_RETRIES" ] && break
        attempt=$((attempt + 1))
        sleep "$CHECK_RETRY_DELAY"
    done
    if printf '%s\n' "$out" | grep -q 'FAIL: empty bundle'; then
        write_target_metric "$host" 1
        echo "reachable: ${host}"
    else
        echo "FAIL: ${host}: ${out:-ssh exited ${rc}}" >&2
        write_target_metric "$host" 0
        ANY_FAIL=1
    fi
}

# Sudo targets: stream the bundle to the forced-command receiver in one
# round-trip; it validates, installs, reloads and prints OK/unchanged/FAIL.
push_target_receiver() {
    local host="$1" ip="$2" ssh_user="$3" ssh_port="$4"
    local out rc
    if [ "$CHECK_ONLY" -eq 1 ]; then
        check_target_receiver "$host" "$ip" "$ssh_user" "$ssh_port"
        return
    fi
    if out=$( { cat "$FULLCHAIN_SRC"; printf '\n%s\n' "$DELIM"; cat "$PRIVKEY_SRC"; } \
                | ssh -p "$ssh_port" "${SSH_OPTS[@]}" "${ssh_user}@${ip}" 2>&1 ); then
        rc=0
    else
        rc=$?
    fi
    if [ "$rc" -eq 0 ] && printf '%s\n' "$out" | grep -qx 'OK'; then
        write_target_metric "$host" 1
        echo "OK: ${host}"
    elif [ "$rc" -eq 0 ] && printf '%s\n' "$out" | grep -qx 'unchanged'; then
        write_target_metric "$host" 1
        echo "unchanged: ${host}"
    else
        echo "FAIL: ${host}: ${out:-ssh exited ${rc}}" >&2
        write_target_metric "$host" 0
        ANY_FAIL=1
    fi
}

# Legacy scp+sudo push, for ssh_no_sudo appliance targets only: their
# authorized_keys is operator-managed, so they cannot host the receiver.
push_target_legacy() {
    local host="$1" ip="$2" cert_dir="$3" \
          ssh_user="$4" ssh_port="$5" sudo_prefix="$6" \
          owner="$7" group="$8" cert_mode="$9" key_mode="${10}" \
          reload_cmd="${11}"

    # Check mode separates reachability from drift: the three hash reads below
    # swallow an ssh failure into an empty string, which otherwise reports a
    # host that never answered as one not carrying the cert.
    if [ "$CHECK_ONLY" -eq 1 ]; then
        local probe attempt=0
        while ! probe=$(ssh -p "$ssh_port" "${SSH_OPTS[@]}" \
                "${ssh_user}@${ip}" true 2>&1); do
            if [ "$attempt" -ge "$CHECK_RETRIES" ]; then
                echo "FAIL: ${host}: ${probe:-ssh exited}" >&2
                write_target_metric "$host" 0
                ANY_FAIL=1
                return
            fi
            attempt=$((attempt + 1))
            sleep "$CHECK_RETRY_DELAY"
        done
    fi

    # Skip only when the applied marker AND both remote file hashes match; the
    # marker is written after a successful reload, so a failed reload re-pushes.
    local local_hash local_key_hash applied_hash remote_hash remote_key_hash
    local_hash=$(sha256sum "$FULLCHAIN_SRC" | cut -d' ' -f1)
    local_key_hash=$(sha256sum "$PRIVKEY_SRC" | cut -d' ' -f1)
    if ! applied_hash=$(ssh -p "$ssh_port" "${SSH_OPTS[@]}" "${ssh_user}@${ip}" \
            "${sudo_prefix}cat \"${cert_dir}/.applied-fullchain.sha256\" 2>/dev/null"); then
        applied_hash=""
    fi
    applied_hash=$(printf '%s' "$applied_hash" | tr -d '[:space:]')
    if ! remote_hash=$(ssh -p "$ssh_port" "${SSH_OPTS[@]}" "${ssh_user}@${ip}" \
            "${sudo_prefix}sha256sum \"${cert_dir}/fullchain.pem\" 2>/dev/null | cut -d' ' -f1"); then
        remote_hash=""
    fi
    remote_hash=$(printf '%s' "$remote_hash" | tr -d '[:space:]')
    if ! remote_key_hash=$(ssh -p "$ssh_port" "${SSH_OPTS[@]}" "${ssh_user}@${ip}" \
            "${sudo_prefix}sha256sum \"${cert_dir}/privkey.pem\" 2>/dev/null | cut -d' ' -f1"); then
        remote_key_hash=""
    fi
    remote_key_hash=$(printf '%s' "$remote_key_hash" | tr -d '[:space:]')
    if [[ -n "$applied_hash" && "$applied_hash" == "$local_hash" \
          && "$remote_hash" == "$local_hash" && "$remote_key_hash" == "$local_key_hash" ]]; then
        write_target_metric "$host" 1
        echo "unchanged: ${host}"
        return
    fi

    # Check mode stops at the comparison: the host answered the probe above, so
    # a mismatch here is the cert, not reachability. Nothing is pushed.
    if [ "$CHECK_ONLY" -eq 1 ]; then
        echo "FAIL: ${host}: not carrying the applied cert" >&2
        write_target_metric "$host" 0
        ANY_FAIL=1
        return
    fi

    # Stage in a per-run 0700 dir: privkey.pem must never sit in world-readable
    # /tmp. Chowned to ${ssh_user} so the scp needs no sudo.
    # `if ! stage=$(ssh ...)`: a bare assignment would abort every later target.
    local stage
    if ! stage=$(ssh -p "$ssh_port" "${SSH_OPTS[@]}" "${ssh_user}@${ip}" \
            "set -e; \
             d=\$(${sudo_prefix}mktemp -d /tmp/cert-stage.XXXXXX); \
             ${sudo_prefix}chmod 0700 \"\$d\"; \
             ${sudo_prefix}chown ${ssh_user}: \"\$d\"; \
             printf '%s' \"\$d\"") || [ -z "$stage" ]; then
        echo "FAIL: could not create staging dir on ${host}" >&2
        write_target_metric "$host" 0
        ANY_FAIL=1
        return
    fi

    if ! scp -P "$ssh_port" "${SCP_OPTS[@]}" \
            "$FULLCHAIN_SRC" "$PRIVKEY_SRC" \
            "${ssh_user}@${ip}:${stage}/"; then
        echo "FAIL: scp to ${host} failed" >&2
        # Best-effort cleanup; ignore rc since the dir may not exist.
        ssh -p "$ssh_port" "${SSH_OPTS[@]}" "${ssh_user}@${ip}" \
            "${sudo_prefix}rm -rf \"${stage}\"" 2>/dev/null || true
        write_target_metric "$host" 0
        ANY_FAIL=1
        return
    fi

    # && between steps so a partial mv never reaches the reload; every path is
    # quoted against word-splitting.
    # reload_cmd carries its own sudo — compound shell forms reject `sudo if`.
    if ! ssh -p "$ssh_port" "${SSH_OPTS[@]}" \
            "${ssh_user}@${ip}" \
            "${sudo_prefix}mv \"${stage}/fullchain.pem\" \"${stage}/privkey.pem\" \"${cert_dir}/\" \
             && ${sudo_prefix}chown \"${owner}:${group}\" \"${cert_dir}/fullchain.pem\" \"${cert_dir}/privkey.pem\" \
             && ${sudo_prefix}chmod \"${cert_mode}\" \"${cert_dir}/fullchain.pem\" \
             && ${sudo_prefix}chmod \"${key_mode}\" \"${cert_dir}/privkey.pem\" \
             && ${sudo_prefix}rm -rf \"${stage}\" \
             && ${reload_cmd} \
             && printf '%s' '${local_hash}' | ${sudo_prefix}tee \"${cert_dir}/.applied-fullchain.sha256\" >/dev/null"; then
        echo "FAIL: remote install/reload on ${host} failed" >&2
        # Best-effort cleanup if the mv failed mid-step.
        ssh -p "$ssh_port" "${SSH_OPTS[@]}" "${ssh_user}@${ip}" \
            "${sudo_prefix}rm -rf \"${stage}\"" 2>/dev/null || true
        write_target_metric "$host" 0
        ANY_FAIL=1
        return
    fi

    write_target_metric "$host" 1
    echo "OK: ${host}"
}

{% for target in acme_certs_distribution_targets %}
{# Per-target overrides; defaults apply when a field is unset. restart_command
   renders verbatim and carries its own sudo; the restart_service shorthand gets
   sudo here. #}
{% set _sudo = '' if (target.ssh_no_sudo | default(false)) else 'sudo ' %}
{% set _rc = target.restart_command | default('') | trim %}
{% set _rs = target.restart_service | default('') | trim %}
{% set _reload = _rc if _rc else (_sudo ~ 'systemctl restart ' ~ _rs) %}
{% set _ssh_port = target.ssh_port | default(22) %}
{% set _ssh_user = target.ssh_user | default(acme_certs_ssh_user) %}
{% if target.ssh_no_sudo | default(false) %}
{# cert_dir is baked into the receiver on sudo targets; only this legacy
   (ssh_no_sudo) push path still needs it client-side. #}
push_target_legacy \
    "{{ target.host }}" \
    "{{ target.ip }}" \
    "{{ target.cert_dir }}" \
    "{{ _ssh_user }}" \
    "{{ _ssh_port }}" \
    "{{ _sudo }}" \
    "{{ target.owner }}" \
    "{{ target.group }}" \
    "{{ target.cert_mode }}" \
    "{{ target.key_mode }}" \
    "{{ _reload }}"
{% else %}
push_target_receiver \
    "{{ target.host }}" \
    "{{ target.ip }}" \
    "{{ _ssh_user }}" \
    "{{ _ssh_port }}"
{% endif %}

{% endfor %}

{% if acme_certs_local_reload_command | default('') | length > 0 %}
# Local consumer of the cert, reloaded last so a local config regression cannot
# abort distribution to the remote targets. Skipped only when both files are
# readable and the hash matches the one last applied.
LOCAL_APPLIED_HASH_FILE="{{ acme_certs_local_cert_dir }}/.applied-fullchain.sha256"
_local_hash=$(sha256sum "$FULLCHAIN_SRC" 2>/dev/null | cut -d' ' -f1)
if [[ -r "$LOCAL_APPLIED_HASH_FILE" && -r "$FULLCHAIN_SRC" && -r "$PRIVKEY_SRC" && -n "$_local_hash" \
      && "$(cat "$LOCAL_APPLIED_HASH_FILE")" == "$_local_hash" ]]; then
    echo "unchanged: {{ inventory_hostname }} (local)"
    write_target_metric "{{ inventory_hostname }}" 1
elif [ "$CHECK_ONLY" -eq 1 ]; then
    echo "FAIL: local cert differs from the applied copy" >&2
    write_target_metric "{{ inventory_hostname }}" 0
    ANY_FAIL=1
elif {{ acme_certs_local_reload_command }}; then
    printf '%s\n' "$_local_hash" > "$LOCAL_APPLIED_HASH_FILE" 2>/dev/null || true
    write_target_metric "{{ inventory_hostname }}" 1
else
    echo "FAIL: local reload failed" >&2
    write_target_metric "{{ inventory_hostname }}" 0
    _LOCAL_OK=0
    ANY_FAIL=1
fi
{% endif %}

# Reaching here means every configured target was recorded, so an empty metrics
# file is a "no targets configured" answer rather than a lost one.
_TARGETS_WALKED=1
flush_target_metrics

if [ "$ANY_FAIL" -ne 0 ]; then
    echo "Certificate distribution finished with one or more failed targets." >&2
    # Exit 2 is partial-target failure; exit 1 is a hard local error.
    # $PROM_TARGET_FILE names the offending host(s).
    exit 2
fi

if [ "$CHECK_ONLY" -eq 1 ]; then
    echo "Certificate distribution check complete."
else
    echo "Certificate distribution complete."
    _CERT_END_TS="$(date +%s)"
    _CERT_DURATION=$(( _CERT_END_TS - _CERT_START_TS ))
    write_prom_metrics 1 "$_CERT_DURATION"
fi
