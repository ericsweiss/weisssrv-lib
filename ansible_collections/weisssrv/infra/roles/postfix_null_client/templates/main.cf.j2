# {{ ansible_managed }}

smtpd_banner = $myhostname ESMTP $mail_name (Debian/GNU)
biff = no

# Append .domain is the MUA's job
append_dot_mydomain = no

recipient_delimiter = +

{# Every key of the merged map is rendered, so a site can add any postfix
   parameter through postfix_null_client_config_extra. #}
{% for key, value in (postfix_null_client_config
     | combine(postfix_null_client_config_extra | default({}, true))) | dictsort %}
{{ key }} = {{ value }}
{% endfor %}

alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
{% if postfix_null_client_virtual_aliases is defined %}
virtual_alias_maps = hash:/etc/postfix/virtual
{% endif %}

compatibility_level = 3.6
