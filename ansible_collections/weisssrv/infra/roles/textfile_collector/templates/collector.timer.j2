# {{ ansible_managed }}
# Fires {{ textfile_collector_name }}.service periodically. OnUnitInactiveSec
# measures from when the previous run finished, so a failed sample re-arms it.
[Unit]
Description={{ textfile_collector_timer_description }}

[Timer]
OnBootSec={{ textfile_collector_on_boot_sec }}
OnUnitInactiveSec={{ textfile_collector_on_unit_inactive_sec }}
AccuracySec={{ textfile_collector_accuracy_sec }}
Unit={{ textfile_collector_name }}.service

[Install]
WantedBy=timers.target
