#!/usr/bin/env bash
# {{ ansible_managed }}
# Nightly offsite backup to Backblaze B2 via restic + rclone. Each source is
# read from its newest <prefix>-* snapshot. Guards and metrics: role README.

set -Eeuo pipefail

# config (rendered by Ansible; keep OUT of the raw block below)
BIND_MODE="{{ restic_offsite_bind_mode | default('bind') }}"        # bind (host) | direct (molecule)
BIND_ROOT="{{ restic_offsite_bind_root }}"                          # stable path root for file-source binds
ZVOL_MOUNT_ROOT="{{ restic_offsite_zvol_mount_root }}"             # stable path root for zvol-clone mounts
SNAP_PREFIX="{{ restic_offsite_snap_prefix | default('archsync') }}"
FRESH_MAX_AGE_H="{{ restic_offsite_freshness_max_age_h | default(26) }}"
RESTORE_BASE="{{ restic_offsite_restore_base | default('/mnt/restore/restic') }}"
EXCLUDE_FILE="{{ restic_offsite_excludes_file | default('/etc/restic-offsite/excludes.txt') }}"
KEEP_DAILY="{{ restic_offsite_keep_daily | default(7) }}"
KEEP_WEEKLY="{{ restic_offsite_keep_weekly | default(2) }}"
KEEP_MONTHLY="{{ restic_offsite_keep_monthly | default(3) }}"
KEEP_YEARLY="{{ restic_offsite_keep_yearly | default(1) }}"
KEEP_LAST="{{ restic_offsite_keep_last | default(5) }}"
FORGET_GROUP_BY="{{ restic_offsite_forget_group_by | default('host') }}"
FORGET_MAX_REMOVE="{{ restic_offsite_forget_max_remove | default(3) }}"
RETRY_LOCK="{{ restic_offsite_retry_lock | default('15m') }}"       # empty disables --retry-lock
STALE_LOCK_MIN_AGE_H="{{ restic_offsite_stale_lock_min_age_h | default(6) }}"
VERIFY_GROUPS="{{ restic_offsite_verify_groups | default(12) }}"
DRILL_SAMPLE_FILES="{{ restic_offsite_restore_drill_sample_files | default(5) }}"
DRILL_MAX_BYTES="{{ restic_offsite_restore_drill_max_bytes | default(16777216) }}"
DRILL_MIN_BYTES="{{ restic_offsite_restore_drill_min_bytes | default(4096) }}"
DRILL_MIN_SOURCES="{{ restic_offsite_restore_drill_min_sources | default(1) }}"
PROM_DIR="{{ restic_offsite_metrics_dir | default('/var/lib/node_exporter') }}"
ZVOL_CLONE_SUFFIX="{{ restic_offsite_zvol_clone_suffix | default('b2walk') }}"
ENV_FILE="{{ restic_offsite_config_dir }}/env"
# Overnight jobs this run must not overlap, space-joined.
CONFLICTING_UNITS="{{ restic_offsite_conflicting_units | default([]) | join(' ') }}"

# File-walkable sources: "name mountpoint" (bind the latest snapshot subtree).
# Names/paths carry no spaces, so a space-split read is safe.
FILE_SOURCES=(
{% for s in restic_offsite_sources %}
  "{{ s.name }} {{ s.mountpoint }}"
{% endfor %}
)
# Zvol data sources: "name zvol fstype mount_opts"; the latest snapshot is
# cloned and mounted read-only. The default omits `noload` so ext4 replays the
# journal and a crash-consistent snapshot walks without EBADMSG.
ZVOL_SOURCES=(
{% for z in restic_offsite_zvol_sources | default([]) %}
  "{{ z.name }} {{ z.zvol }} {{ z.fstype | default('ext4') }} {{ z.mount_opts | default('ro') }}"
{% endfor %}
)
{% raw %}
PROM_FILE="${PROM_DIR}/restic_offsite.prom"
VERIFY_PROM_FILE="${PROM_DIR}/restic_offsite_verify.prom"
DRILL_PROM_FILE="${PROM_DIR}/backup_restore_drill.prom"
LOCK="/run/restic-offsite.lock"

# GFS retention flags, shared by the nightly run and `prune` so the two cannot
# diverge. --keep-last is a floor independent of the calendar buckets;
# --group-by is pinned so a source-list change re-groups rather than forking.
FORGET_FLAGS=(
  --keep-last "$KEEP_LAST"
  --keep-daily "$KEEP_DAILY"
  --keep-weekly "$KEEP_WEEKLY"
  --keep-monthly "$KEEP_MONTHLY"
  --keep-yearly "$KEEP_YEARLY"
  --group-by "$FORGET_GROUP_BY"
{% endraw -%}
{% for tag in restic_offsite_keep_tags %}  --keep-tag={{ tag | quote }}
{% endfor -%}
{% raw -%}
)

log() { echo "[$(date -Is)] $*"; }

# Strip --b2-hard-delete from restic's built-in rclone args: a hide-only
# restricted key 401s on b2_delete_file_version, including the lock refresh.
# --retry-lock waits out a concurrent holder.
_RESTIC_BASE_ARGS=( -o rclone.args="serve restic --stdio" )
_RETRY_LOCK_ARGS=()
if [[ -n "$RETRY_LOCK" ]]; then
  _RETRY_LOCK_ARGS=( --retry-lock "$RETRY_LOCK" )
fi
restic() {
  command restic "${_RESTIC_BASE_ARGS[@]}" "${_RETRY_LOCK_ARGS[@]}" "$@"
}

# Read-only probes: --no-lock, and no --retry-lock. restic takes a read lock
# even for `cat`, so a locking probe would wait out --retry-lock and never reap
# the lock it was called for.
restic_ro() {
  command restic "${_RESTIC_BASE_ARGS[@]}" --no-lock "$@"
}

# Reap a lock this host left behind: same hostname, dead PID, older than
# STALE_LOCK_MIN_AGE_H. Every non-match is logged with its reason and counted —
# cmd_unlock turns the counts into a verdict.
_REAPED_LOCKS=0
_SKIPPED_LOCKS=0
reap_stale_locks() {
  local ids id meta lock_host lock_pid lock_time epoch age min_age me
  _REAPED_LOCKS=0
  _SKIPPED_LOCKS=0
  min_age=$(( STALE_LOCK_MIN_AGE_H * 3600 ))
  me="${HOSTNAME:-$(uname -n)}"
  ids="$(restic_ro list locks 2>/dev/null || true)"
  [[ -n "$ids" ]] || return 0
  for id in $ids; do
    meta="$(restic_ro cat lock "$id" 2>/dev/null || true)"
    if [[ -z "$meta" ]]; then
      log "stale-lock: ${id} left alone — its metadata could not be read"
      _SKIPPED_LOCKS=$(( _SKIPPED_LOCKS + 1 ))
      continue
    fi
    lock_host="$(printf '%s\n' "$meta" | sed -n 's/.*"hostname"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
    lock_pid="$(printf '%s\n' "$meta" | sed -n 's/.*"pid"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -1)"
    lock_time="$(printf '%s\n' "$meta" | sed -n 's/.*"time"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
    if [[ "$lock_host" != "$me" ]]; then
      log "stale-lock: ${id} left alone — held by ${lock_host:-an unknown host}, not this one (${me})"
      _SKIPPED_LOCKS=$(( _SKIPPED_LOCKS + 1 ))
      continue
    fi
    if [[ -n "$lock_pid" ]] && kill -0 "$lock_pid" 2>/dev/null; then
      log "stale-lock: ${id} left alone — pid ${lock_pid} is still running here, so a live operation holds it"
      _SKIPPED_LOCKS=$(( _SKIPPED_LOCKS + 1 ))
      continue
    fi
    epoch="$(date -d "$lock_time" +%s 2>/dev/null || true)"
    if [[ -z "$epoch" ]]; then
      log "stale-lock: ${id} left alone — its timestamp (${lock_time:-unset}) could not be parsed, so its age is unknown"
      _SKIPPED_LOCKS=$(( _SKIPPED_LOCKS + 1 ))
      continue
    fi
    age=$(( $(date +%s) - epoch ))
    if (( age <= min_age )); then
      log "stale-lock: ${id} left alone — age ${age}s is within the ${min_age}s (${STALE_LOCK_MIN_AGE_H}h) staleness threshold"
      _SKIPPED_LOCKS=$(( _SKIPPED_LOCKS + 1 ))
      continue
    fi
    # CRITICAL: `restic unlock` is repository-wide, removing every lock restic
    # deems stale, not just the one verified above. It is only safe when that
    # lock is the repository's sole lock; otherwise a coexisting writer's lock
    # is swept along with it and that writer corrupts the repository.
    if [[ "$(wc -w <<<"$ids")" -ne 1 ]]; then
      log "stale-lock: ${id} is reapable, but other repository locks exist — refusing repository-wide unlock"
      _SKIPPED_LOCKS=$(( _SKIPPED_LOCKS + 1 ))
      return 0
    fi
    log "stale-lock: ${id} (host ${lock_host}, pid ${lock_pid:-unknown} not running, age ${age}s > ${min_age}s) — running restic unlock"
    if restic unlock; then
      log "stale-lock: removed"
      _REAPED_LOCKS=$(( _REAPED_LOCKS + 1 ))
    else
      log "stale-lock: restic unlock FAILED — exclusive operations will stay blocked"
    fi
    return 0
  done
  return 0
}

# Ceiling-refusal sentinel, outside restic's own codes (0/1/2/3/10/11/12), which
# run_forget also returns.
FORGET_RC_CEILING=90

# Guarded forget+prune: dry-run the same policy, count the delete set, and
# refuse the destructive pass above $max_remove. Returns 0 pruned,
# $FORGET_RC_CEILING refused, 1 unusable dry-run, or restic's own rc.
run_forget() {
  local max_remove="${1:-$FORGET_MAX_REMOVE}"
  local dry removing rc=0
  dry="$(restic forget "${FORGET_FLAGS[@]}" --dry-run 2>&1)" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    log "retention dry-run failed (rc=${rc}) — refusing to prune"
    if [[ "$rc" -eq 11 ]]; then
      log "rc=11 is a repository lock — clear a stale one with: restic-offsitectl unlock"
    fi
    printf '%s\n' "$dry" | tail -n 20
    return 1
  fi
  # An absent `remove N snapshots:` line means zero ONLY when the keep/remove
  # summary shape is present at all. Without this check a reworded restic would
  # silently degrade the ceiling to no ceiling.
  if ! printf '%s\n' "$dry" | grep -Eq '^(keep|remove) [0-9]+ snapshots?:'; then
    log "retention dry-run: unrecognised restic forget summary — refusing to prune (the delete-set ceiling cannot be evaluated)"
    printf '%s\n' "$dry" | tail -n 20
    return 1
  fi
  removing="$(printf '%s\n' "$dry" \
    | sed -n 's/^remove \([0-9][0-9]*\) snapshots\{0,1\}:.*/\1/p' \
    | awk '{ s += $1 } END { print s + 0 }')"
  [[ "$removing" =~ ^[0-9]+$ ]] || removing=0
  retention_pending="$removing"
  log "retention dry-run: ${removing} snapshot(s) would be forgotten (ceiling ${max_remove})"
  if [[ "$removing" -gt "$max_remove" ]]; then
    log "REFUSING to prune: the policy would forget ${removing} snapshots, above the ${max_remove} ceiling."
    log "Inspect first: restic-offsitectl snapshots"
    log "If that delete set is intended: restic-offsitectl prune --max-remove ${removing}"
    return "$FORGET_RC_CEILING"
  fi
  log "restic forget ${FORGET_FLAGS[*]} --prune"
  restic forget "${FORGET_FLAGS[@]}" --prune
}

# rc -> gauges: 0 pruned, $FORGET_RC_CEILING is a ceiling refusal (sets
# retention_blocked, the run still succeeds), anything else fails the run.
apply_forget_rc() {
  local forget_rc="$1"
  case "$forget_rc" in
    0) prune_success=1 ;;
    "$FORGET_RC_CEILING")
       retention_blocked=1
       log "retention blocked: ${retention_pending} snapshot(s) pending above the ${FORGET_MAX_REMOVE} ceiling — the backup itself landed"
       ;;
    *) log "retention FAILED (rc=${forget_rc}) — the backup itself landed, but retention did not apply; it may have forgotten snapshots before failing" ;;
  esac
  if [[ "$forget_rc" -eq 0 || "$forget_rc" -eq "$FORGET_RC_CEILING" ]]; then
    run_success=1
  fi
}

# rc -> verdict: 0 landed, 3 landed with unreadable files, anything else failed.
# rc=3 keeps the snapshot, skips retention and still succeeds.
classify_backup_rc() {
  local rc="$1" log_file="$2" unreadable
  backup_attempted=1
  if [[ "$rc" -eq 0 ]]; then
    run_incomplete=0
    return 0
  fi
  [[ "$rc" -eq 3 ]] || return "$rc"
  unreadable="$(grep -c '^error: ' "$log_file" 2>/dev/null || true)"
  [[ "$unreadable" =~ ^[0-9]+$ ]] || unreadable=0
  log "restic backup INCOMPLETE (rc=3): ${unreadable} unreadable path(s)"
  run_incomplete=1
  return 0
}

# Retention after an incomplete backup would let that snapshot expire a complete
# one under --keep-last/--keep-daily, so it is skipped and the run still
# succeeds: the snapshot landed.
apply_retention_decision() {
  if [[ "$run_incomplete" -eq 0 ]]; then
    prune_attempted=1
    local forget_rc=0
    run_forget || forget_rc=$?
    apply_forget_rc "$forget_rc"
  else
    run_success=1
    log "retention deferred: the backup was incomplete"
  fi
}

# The systemd unit injects the restic/rclone env via EnvironmentFile=; MANUAL
# invocations (the runbook's restore/verify/run paths) run outside the unit, so
# source the same file ourselves when the repo env is absent. Root-only 0600.
if [[ -z "${RESTIC_REPOSITORY:-}" && -r "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi

need_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    echo "Run as root (e.g. sudo restic-offsitectl ...)" >&2
    exit 1
  fi
}

# metrics

# Run-metric globals, flushed on every exit of a run by the cleanup() EXIT trap,
# so an abort, a mount failure or a signal all record a failed run. backup and
# prune outcomes are tracked separately.
run_success=0
backup_success=0
run_incomplete=0
backup_attempted=0
prune_attempted=0
prune_success=0
retention_blocked=0
retention_pending=0
run_repo_bytes=0
run_snap_bytes=0
_RUN_START_TS="$(date +%s)"
_METRICS_ACTIVE=0

# Last value of a metric in a textfile (empty when absent/unreadable).
prev_metric() {
  local file="$1" name="$2"
  awk -v n="$name" '$1 == n { v = $2 } END { if (v != "") print v }' "$file" 2>/dev/null || true
}

write_prom_metrics() {
  local success="$1" duration="$2" repo_bytes="$3" snap_bytes="$4"
  local ts tmp sval bval pval blocked pending ival
  ts="$(date +%s)"
  tmp="${PROM_FILE}.$$"
  # Timestamps survive a failed attempt so staleness alerts measure
  # time-since-last-success. Retention gauges carry forward when prune never
  # ran, and are omitted when there is nothing to carry.
  if [ "$success" -eq 1 ]; then sval="$ts"; else sval="$(prev_metric "$PROM_FILE" restic_offsite_last_success_timestamp_seconds)"; fi
  if [ "$backup_success" -eq 1 ]; then bval="$ts"; else bval="$(prev_metric "$PROM_FILE" restic_offsite_last_backup_timestamp_seconds)"; fi
  # The incomplete gauge describes the last 'restic backup', so a run that never
  # reached one carries it forward: otherwise an abort clears the warning the
  # consumer alert needs two consecutive nights to fire on.
  if [ "$backup_attempted" -eq 1 ]; then
    ival="$run_incomplete"
  else
    ival="$(prev_metric "$PROM_FILE" restic_offsite_last_run_incomplete)"
    [ -n "$ival" ] || ival=0
  fi
  if [ "$prune_attempted" -eq 1 ]; then
    pval="$prune_success"
    blocked="$retention_blocked"
    pending="$retention_pending"
  else
    pval="$(prev_metric "$PROM_FILE" restic_offsite_last_prune_success)"
    blocked="$(prev_metric "$PROM_FILE" restic_offsite_retention_blocked)"
    pending="$(prev_metric "$PROM_FILE" restic_offsite_retention_pending_removals)"
  fi
  {
    echo "# HELP restic_offsite_last_run_duration_seconds Duration of the last offsite backup run"
    echo "# TYPE restic_offsite_last_run_duration_seconds gauge"
    echo "restic_offsite_last_run_duration_seconds ${duration}"
    echo "# HELP restic_offsite_last_run_success Whether the last run completed without error (1=success, 0=failure/abort)"
    echo "# TYPE restic_offsite_last_run_success gauge"
    echo "restic_offsite_last_run_success ${success}"
    if [ -n "$sval" ]; then
      echo "# HELP restic_offsite_last_success_timestamp_seconds Unix timestamp of the last successful offsite run"
      echo "# TYPE restic_offsite_last_success_timestamp_seconds gauge"
      echo "restic_offsite_last_success_timestamp_seconds ${sval}"
    fi
    echo "# HELP restic_offsite_last_backup_success Whether the last 'restic backup' landed in the repository (1=yes)"
    echo "# TYPE restic_offsite_last_backup_success gauge"
    echo "restic_offsite_last_backup_success ${backup_success}"
    echo "# HELP restic_offsite_last_run_incomplete Whether the last 'restic backup' skipped unreadable files (restic rc=3)"
    echo "# TYPE restic_offsite_last_run_incomplete gauge"
    echo "restic_offsite_last_run_incomplete ${ival}"
    if [ -n "$bval" ]; then
      echo "# HELP restic_offsite_last_backup_timestamp_seconds Unix timestamp of the last successful 'restic backup'"
      echo "# TYPE restic_offsite_last_backup_timestamp_seconds gauge"
      echo "restic_offsite_last_backup_timestamp_seconds ${bval}"
    fi
    if [ -n "$pval" ]; then
      echo "# HELP restic_offsite_last_prune_success Whether the last retention pass applied (1=pruned, 0=blocked/failed)"
      echo "# TYPE restic_offsite_last_prune_success gauge"
      echo "restic_offsite_last_prune_success ${pval}"
    fi
    if [ -n "$blocked" ]; then
      echo "# HELP restic_offsite_retention_blocked Whether retention is refusing to prune because of the delete-set ceiling"
      echo "# TYPE restic_offsite_retention_blocked gauge"
      echo "restic_offsite_retention_blocked ${blocked}"
    fi
    if [ -n "$pending" ]; then
      echo "# HELP restic_offsite_retention_pending_removals Snapshots the retention policy would forget on the next prune"
      echo "# TYPE restic_offsite_retention_pending_removals gauge"
      echo "restic_offsite_retention_pending_removals ${pending}"
    fi
    echo "# HELP restic_offsite_repo_size_bytes restic repository raw-data size in bytes (0 = unknown)"
    echo "# TYPE restic_offsite_repo_size_bytes gauge"
    echo "restic_offsite_repo_size_bytes ${repo_bytes}"
    echo "# HELP restic_offsite_snapshot_total_bytes Size of the latest restic snapshot in bytes (0 = unknown)"
    echo "# TYPE restic_offsite_snapshot_total_bytes gauge"
    echo "restic_offsite_snapshot_total_bytes ${snap_bytes}"
  } > "$tmp" 2>/dev/null || {
    logger -t restic-offsite-metrics -p daemon.err "could not write ${PROM_FILE}"
    rm -f "$tmp"
    return 0
  }
  mv "$tmp" "$PROM_FILE" 2>/dev/null || {
    logger -t restic-offsite-metrics -p daemon.err "could not rename ${tmp} -> ${PROM_FILE}"
    rm -f "$tmp"
  }
}

flush_run_metrics() {
  local now duration
  now="$(date +%s)"
  duration=$(( now - _RUN_START_TS ))
  write_prom_metrics "$run_success" "$duration" "$run_repo_bytes" "$run_snap_bytes"
}

# $2 = the pack group just read (rotating deep verify); empty leaves the
# persisted cursor alone so a failed or skipped week is retried, not lost.
write_verify_metrics() {
  local success="$1" group="${2:-}"
  local ts tmp sval gval
  ts="$(date +%s)"
  tmp="${VERIFY_PROM_FILE}.$$"
  if [ "$success" -eq 1 ]; then sval="$ts"; else sval="$(prev_metric "$VERIFY_PROM_FILE" restic_offsite_last_verify_timestamp_seconds)"; fi
  if [ "$success" -eq 1 ] && [ -n "$group" ]; then gval="$group"; else gval="$(prev_metric "$VERIFY_PROM_FILE" restic_offsite_verify_group)"; fi
  {
    echo "# HELP restic_offsite_last_verify_success Whether the last 'restic check' succeeded (1=ok, 0=failed)"
    echo "# TYPE restic_offsite_last_verify_success gauge"
    echo "restic_offsite_last_verify_success ${success}"
    if [ -n "$sval" ]; then
      echo "# HELP restic_offsite_last_verify_timestamp_seconds Unix timestamp of the last successful verify"
      echo "# TYPE restic_offsite_last_verify_timestamp_seconds gauge"
      echo "restic_offsite_last_verify_timestamp_seconds ${sval}"
    fi
    if [ -n "$gval" ]; then
      echo "# HELP restic_offsite_verify_group Pack group last read successfully by the rotating deep verify"
      echo "# TYPE restic_offsite_verify_group gauge"
      echo "restic_offsite_verify_group ${gval}"
    fi
    echo "# HELP restic_offsite_verify_groups Number of pack groups the rotating deep verify cycles through"
    echo "# TYPE restic_offsite_verify_groups gauge"
    echo "restic_offsite_verify_groups ${VERIFY_GROUPS}"
  } > "$tmp" 2>/dev/null || {
    logger -t restic-offsite-metrics -p daemon.err "could not write ${VERIFY_PROM_FILE}"
    rm -f "$tmp"
    return 0
  }
  mv "$tmp" "$VERIFY_PROM_FILE" 2>/dev/null || {
    logger -t restic-offsite-metrics -p daemon.err "could not rename ${tmp} -> ${VERIFY_PROM_FILE}"
    rm -f "$tmp"
  }
}

# Restore-drill metrics: _last_run_seconds advances even on failure,
# _last_success_seconds only on a pass, and _files_compared reports how much was
# proven, where 0 means the drill sampled nothing and is a failure.
write_drill_metrics() {
  local success="$1" compared="$2"
  local ts tmp sval
  ts="$(date +%s)"
  tmp="${DRILL_PROM_FILE}.$$"
  if [ "$success" -eq 1 ]; then sval="$ts"; else sval="$(prev_metric "$DRILL_PROM_FILE" backup_restore_drill_last_success_seconds)"; fi
  {
    echo "# HELP backup_restore_drill_last_run_seconds Unix timestamp of the last restore-drill attempt"
    echo "# TYPE backup_restore_drill_last_run_seconds gauge"
    echo "backup_restore_drill_last_run_seconds ${ts}"
    if [ -n "$sval" ]; then
      echo "# HELP backup_restore_drill_last_success_seconds Unix timestamp of the last restore drill whose every compared file matched"
      echo "# TYPE backup_restore_drill_last_success_seconds gauge"
      echo "backup_restore_drill_last_success_seconds ${sval}"
    fi
    echo "# HELP backup_restore_drill_files_compared Files byte-compared against their source in the last restore drill"
    echo "# TYPE backup_restore_drill_files_compared gauge"
    echo "backup_restore_drill_files_compared ${compared}"
  } > "$tmp" 2>/dev/null || {
    logger -t restic-offsite-metrics -p daemon.err "could not write ${DRILL_PROM_FILE}"
    rm -f "$tmp"
    return 0
  }
  mv "$tmp" "$DRILL_PROM_FILE" 2>/dev/null || {
    logger -t restic-offsite-metrics -p daemon.err "could not rename ${tmp} -> ${DRILL_PROM_FILE}"
    rm -f "$tmp"
  }
}

# Next pack group for the rotating deep verify: (last successfully read % N) + 1,
# persisted in the verify metrics file. A wall-clock (ISO week) index would skip
# the groups whose week failed and not revisit them for a full cycle.
next_verify_group() {
  local last
  last="$(prev_metric "$VERIFY_PROM_FILE" restic_offsite_verify_group)"
  last="${last%%.*}"
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  [[ "$last" -le "$VERIFY_GROUPS" ]] || last=0
  echo $(( last % VERIFY_GROUPS + 1 ))
}

# source snapshot resolution / freshness

# Latest snapshot name for a file source, from the browsable .zfs tree. Glob
# matches sort ascending, so the last is newest; the explicit return 0 keeps an
# empty result from killing the caller under set -e.
latest_file_snap() {
  local mp="$1" d newest=""
  for d in "${mp}/.zfs/snapshot/${SNAP_PREFIX}-"*/; do
    [[ -e "$d" ]] || continue
    newest="${d%/}"
  done
  [[ -n "$newest" ]] && printf '%s' "${newest##*/}"
  return 0
}

# Latest snapshot NAME for a zvol (no browsable .zfs — list snapshots).
latest_zvol_snap() {
  local zvol="$1"
  zfs list -H -t snapshot -o name -s creation "$zvol" 2>/dev/null \
    | sed -n "s/.*@\(${SNAP_PREFIX}-.*\)$/\1/p" | tail -1 || true
}

# Age in seconds of a <prefix>-YYYYMMDD-HHMMSS snapshot, parsed from its NAME
# (works in bind + direct mode, needs no zfs command). Prints a huge number when
# the name is unparseable so the freshness guard treats it as stale.
snap_age_seconds() {
  local name="$1" d epoch now
  d="${name#"${SNAP_PREFIX}-"}"
  epoch="$(date -d "${d:0:8} ${d:9:2}:${d:11:2}:${d:13:2}" +%s 2>/dev/null || true)"
  [[ -n "$epoch" ]] || { echo 999999999; return 0; }
  now="$(date +%s)"
  echo $(( now - epoch ))
}

# Echoes "<newest_epoch> <oldest_epoch> <sources_without_a_snapshot>" over all
# sources, 0 0 <n> when none resolve. It mounts and clones nothing, so it runs
# before any setup, and feeds the already-uploaded short-circuit in cmd_run.
source_snap_epochs() {
  local entry name mp zvol rest snap age now epoch
  local newest=0 oldest=0 missing=0
  now="$(date +%s)"
  _acc() {
    epoch=$1
    [[ "$newest" -eq 0 || "$epoch" -gt "$newest" ]] && newest="$epoch"
    [[ "$oldest" -eq 0 || "$epoch" -lt "$oldest" ]] && oldest="$epoch"
    return 0
  }
  for entry in "${FILE_SOURCES[@]}"; do
    [[ -n "$entry" ]] || continue
    read -r name mp <<< "$entry"
    snap="$(latest_file_snap "$mp")"
    if [[ -z "$snap" ]]; then missing=$(( missing + 1 )); continue; fi
    age="$(snap_age_seconds "$snap")"
    _acc $(( now - age ))
  done
  for entry in "${ZVOL_SOURCES[@]}"; do
    [[ -n "$entry" ]] || continue
    read -r name zvol rest <<< "$entry"
    snap="$(latest_zvol_snap "$zvol")"
    if [[ -z "$snap" ]]; then missing=$(( missing + 1 )); continue; fi
    age="$(snap_age_seconds "$snap")"
    _acc $(( now - age ))
  done
  printf '%s %s %s' "$newest" "$oldest" "$missing"
}

# Unix time of the last successful UPLOAD, from the metrics file (0 when
# absent). Falls back to the run timestamp when only that gauge is present.
last_backup_epoch() {
  local v
  v="$(prev_metric "$PROM_FILE" restic_offsite_last_backup_timestamp_seconds)"
  [[ -n "$v" ]] || v="$(prev_metric "$PROM_FILE" restic_offsite_last_success_timestamp_seconds)"
  case "${v%%.*}" in ''|*[!0-9]*) echo 0 ;; *) echo "${v%%.*}" ;; esac
}

# cleanup (EXIT trap)

# CRITICAL: metrics first. A run killed at TimeoutStartSec has only
# TimeoutStopSec left, and a `zfs destroy -r` below can eat all of it, leaving
# the previous run's success gauge published for a run that failed.
_BINDS_TO_UMOUNT=()
_ZVOL_MOUNTS_TO_UMOUNT=()
_CLONES_TO_DESTROY=()
_TMP_FILES_TO_REMOVE=()
cleanup() {
  local p
  if [[ "${_METRICS_ACTIVE}" -eq 1 ]]; then
    flush_run_metrics
  fi
  # Torn down in reverse: unmount every bind and zvol-clone mount, then destroy
  # every clone. Paths and clones are recorded before the mount, so an abort
  # mid-run cannot strand them.
  for p in "${_ZVOL_MOUNTS_TO_UMOUNT[@]:-}"; do
    [[ -n "$p" ]] || continue
    umount -l "$p" >/dev/null 2>&1 || true
  done
  for p in "${_BINDS_TO_UMOUNT[@]:-}"; do
    [[ -n "$p" ]] || continue
    umount -l "$p" >/dev/null 2>&1 || true
  done
  for p in "${_CLONES_TO_DESTROY[@]:-}"; do
    [[ -n "$p" ]] || continue
    zfs destroy -r "$p" >/dev/null 2>&1 || true
  done
  for p in "${_TMP_FILES_TO_REMOVE[@]:-}"; do
    [[ -n "$p" ]] || continue
    rm -f "$p" >/dev/null 2>&1 || true
  done
}

# restic repo helpers
repo_init_if_needed() {
  # CRITICAL: init must run only for a genuinely absent repository. Initialising
  # on an auth, transport or corruption failure creates a fresh empty repo and
  # silently forks backup continuity. restic_ro is used for the probe so a stale
  # exclusive lock cannot turn the question into a wait that falls through.
  local probe_err probe_rc=0
  probe_err="$(restic_ro cat config 2>&1 >/dev/null)" || probe_rc=$?
  if [[ "$probe_rc" -eq 0 ]]; then
    return 0
  fi
  if [[ "$probe_rc" -eq 10 ]] \
     || grep -qi 'repository does not exist\|Is there a repository at the following location' \
        <<<"$probe_err"; then
    log "restic repository not initialized; running restic init"
    restic init
  else
    log "cannot read the restic repository config (rc=${probe_rc}) and it does not look uninitialised — refusing to init over it"
    printf '%s\n' "$probe_err" >&2
    return 1
  fi
}

# run
cmd_run() {
  local force=0
  [[ "${1:-}" == "--force" ]] && force=1

  exec 9>"$LOCK"
  if ! flock -n 9; then
    log "restic-offsite already running; exiting"
    exit 0
  fi

  # CRITICAL: a conflicting overnight job moves the ground under a running
  # upload (swap-clean stops guests whose zvols this run cloned and mounted).
  # Fail-open on a systemctl error, so a broken systemctl cannot wedge backups.
  # shellcheck disable=SC2086  # deliberate word-split of the space-joined list
  for u in $CONFLICTING_UNITS; do
    if systemctl is-active --quiet "$u"; then
      log "deliberate-skip: ${u} is active; a backup must not overlap it — retrying on the next timer"
      exit 0
    fi
  done

  # Already-uploaded short-circuit (README): every source must be present and
  # fresh, so a total snapshot failure still reaches the freshness abort below.
  # It sits before _METRICS_ACTIVE=1, because a skip is not a run.
  if [[ "$force" -eq 0 ]]; then
    local newest_snap oldest_snap missing_snaps last_ok max_age_pre
    read -r newest_snap oldest_snap missing_snaps <<< "$(source_snap_epochs)"
    last_ok="$(last_backup_epoch)"
    max_age_pre=$(( FRESH_MAX_AGE_H * 3600 ))
    if [[ "$missing_snaps" -eq 0 && "$newest_snap" -gt 0 \
          && $(( $(date +%s) - oldest_snap )) -le "$max_age_pre" \
          && "$last_ok" -ge "$newest_snap" ]]; then
      log "already-uploaded: last successful offsite backup ($(date -d "@${last_ok}" -Is 2>/dev/null || echo "@${last_ok}")) already covers the newest ${SNAP_PREFIX}-* source snapshot ($(date -d "@${newest_snap}" -Is 2>/dev/null || echo "@${newest_snap}")) and every source is fresh; nothing new to upload — skipping (use 'run --force' to override)"
      exit 0
    fi
  fi

  _METRICS_ACTIVE=1
  trap cleanup EXIT
  trap 'exit' INT TERM

  mkdir -p "$PROM_DIR" "$BIND_ROOT" "$ZVOL_MOUNT_ROOT"

  # Freshness guard: never upload a stale tree. Each source must carry a
  # <prefix>-* snapshot no older than FRESH_MAX_AGE_H; an absent or stale one
  # aborts with success=0 and a distinct 'stale-source' log line.
  local max_age_s=$(( FRESH_MAX_AGE_H * 3600 ))
  local restic_paths=() name mp snap age zvol fstype mopts entry

  for entry in "${FILE_SOURCES[@]}"; do
    read -r name mp <<< "$entry"
    snap="$(latest_file_snap "$mp")"
    if [[ -z "$snap" ]]; then
      log "stale-source: no ${SNAP_PREFIX}-* snapshot under ${mp}/.zfs/snapshot — aborting (not uploading a stale/absent tree)"
      exit 1
    fi
    age="$(snap_age_seconds "$snap")"
    if (( age > max_age_s )); then
      log "stale-source: ${mp} newest snapshot ${snap} is ${age}s old (> ${max_age_s}s) — aborting"
      exit 1
    fi
    if [[ "$BIND_MODE" == "bind" ]]; then
      mkdir -p "${BIND_ROOT}/${name}"
      _BINDS_TO_UMOUNT+=( "${BIND_ROOT}/${name}" )
      mount --bind "${mp}/.zfs/snapshot/${snap}" "${BIND_ROOT}/${name}"
      # A ZFS snapshot is immutable, but remount ro so nothing can ever write
      # through the bind either.
      mount -o remount,ro,bind "${BIND_ROOT}/${name}" 2>/dev/null || true
      restic_paths+=( "${BIND_ROOT}/${name}" )
    else
      # direct (molecule): back up the snapshot dir in place (single run; no
      # parent-snapshot dedup needed).
      restic_paths+=( "${mp}/.zfs/snapshot/${snap}" )
    fi
  done

  for entry in "${ZVOL_SOURCES[@]}"; do
    [[ -n "$entry" ]] || continue
    read -r name zvol fstype mopts <<< "$entry"
    snap="$(latest_zvol_snap "$zvol")"
    if [[ -z "$snap" ]]; then
      log "stale-source: no ${SNAP_PREFIX}-* snapshot on zvol ${zvol} — aborting"
      exit 1
    fi
    age="$(snap_age_seconds "$snap")"
    if (( age > max_age_s )); then
      log "stale-source: zvol ${zvol} newest snapshot ${snap} is ${age}s old (> ${max_age_s}s) — aborting"
      exit 1
    fi
    # Clone to a throwaway sibling zvol and MOUNT it read-only; the clone stays
    # writable so ext4 can replay. A stale clone is destroyed only after `origin`
    # proves it is ours; the name derives from the FULL zvol path (no collisions).
    local clone="${zvol}-${ZVOL_CLONE_SUFFIX}"
    if zfs list -H -o name "$clone" >/dev/null 2>&1; then
      local origin
      origin="$(zfs get -H -o value origin "$clone" 2>/dev/null || true)"
      if [[ "$origin" == "${zvol}@"* ]]; then
        log "destroying stale clone ${clone} from a prior run (origin ${origin})"
        zfs destroy -r "$clone" >/dev/null 2>&1 || true
      else
        log "clone-conflict: ${clone} exists with origin ${origin:-unknown} — not a clone of ${zvol}, refusing to destroy an unmanaged dataset; remove/rename it manually"
        exit 1
      fi
    fi
    if ! zfs clone "${zvol}@${snap}" "$clone"; then
      log "clone-failed: zfs clone ${zvol}@${snap} -> ${clone} failed — aborting"
      exit 1
    fi
    # Registered AFTER a successful create: the EXIT trap must only reap clones
    # THIS run made, never a name it refused to touch above.
    _CLONES_TO_DESTROY+=( "$clone" )
    # zvol device nodes appear via udev; wait briefly for /dev/zvol/<clone>.
    local dev="/dev/zvol/${clone}" i=0
    udevadm settle >/dev/null 2>&1 || true
    while [[ ! -e "$dev" ]] && (( i < 50 )); do sleep 0.2; i=$(( i + 1 )); done
    mkdir -p "${ZVOL_MOUNT_ROOT}/${name}"
    _ZVOL_MOUNTS_TO_UMOUNT+=( "${ZVOL_MOUNT_ROOT}/${name}" )
    if ! mount -t "$fstype" -o "$mopts" "$dev" "${ZVOL_MOUNT_ROOT}/${name}"; then
      log "mount-failed: ${dev} (${fstype},${mopts}) -> ${ZVOL_MOUNT_ROOT}/${name} — aborting"
      exit 1
    fi
    restic_paths+=( "${ZVOL_MOUNT_ROOT}/${name}" )
  done

  reap_stale_locks
  repo_init_if_needed

  log "restic backup of ${#restic_paths[@]} source path(s)"
  local backup_rc=0 verdict_rc=0 backup_log
  # Streamed, not buffered: a multi-hour upload must show progress in the
  # journal, and a run killed at TimeoutStartSec must not lose its whole log.
  # The copy is kept so the rc=3 arm can count the unreadable paths.
  backup_log="$(mktemp)"
  _TMP_FILES_TO_REMOVE+=( "$backup_log" )
  # errexit off across the pipeline so PIPESTATUS[0] (restic's own status, not
  # tee's) is what reaches classify_backup_rc.
  set +e
  restic backup "${restic_paths[@]}" \
    --tag nightly \
    --exclude-file "$EXCLUDE_FILE" \
    --exclude-caches \
    --one-file-system=false 2>&1 | tee "$backup_log"
  backup_rc=${PIPESTATUS[0]}
  set -e
  classify_backup_rc "$backup_rc" "$backup_log" || verdict_rc=$?
  rm -f "$backup_log"
  if [[ "$verdict_rc" -ne 0 ]]; then
    log "restic backup FAILED (rc=${backup_rc})"
    if [[ "$backup_rc" -eq 11 ]]; then
      log "rc=11 is a repository lock — clear a stale one with: restic-offsitectl unlock"
    fi
    return 1
  fi
  # Flushed immediately: the upload has landed, and that fact must survive
  # whatever the retention stage below does.
  backup_success=1
  flush_run_metrics

  # Retention is dry-run-guarded (see run_forget); apply_retention_decision owns
  # the skip-on-incomplete rule and apply_forget_rc the rc mapping.
  apply_retention_decision

  # Repo raw-data size + latest snapshot size for the metrics (best-effort).
  run_repo_bytes="$(restic stats --mode raw-data --json 2>/dev/null \
    | sed -n 's/.*"total_size":\([0-9]*\).*/\1/p' | head -1 || true)"
  [[ "$run_repo_bytes" =~ ^[0-9]+$ ]] || run_repo_bytes=0
  run_snap_bytes="$(restic stats --mode restore-size --json latest 2>/dev/null \
    | sed -n 's/.*"total_size":\([0-9]*\).*/\1/p' | head -1 || true)"
  [[ "$run_snap_bytes" =~ ^[0-9]+$ ]] || run_snap_bytes=0

  log "offsite backup complete (repo raw-data ${run_repo_bytes} bytes, latest snapshot ${run_snap_bytes} bytes)"
  # cleanup() (EXIT trap) unmounts binds, destroys clones, and writes metrics.
  [[ "$run_success" -eq 1 ]] || return 1
}

# restore
cmd_restore() {
  need_lock_or_die
  local name="${1:-}" snap="${2:-latest}" target="${3:-}"
  if [[ -z "$name" ]]; then
    echo "Usage: restic-offsitectl restore <source-name> [snapshotID|latest] [target-dir]" >&2
    exit 2
  fi
  if [[ -z "$target" ]]; then
    target="${RESTORE_BASE}/${name}/$(date +%Y%m%d-%H%M%S)"
  fi
  mkdir -p "$target"
  # Restrict the restore to the requested source's path prefix (bind or zvol root).
  log "restic restore ${snap} --target ${target} (source: ${name})"
  restic restore "$snap" --target "$target" \
    --include "${BIND_ROOT}/${name}" \
    --include "${ZVOL_MOUNT_ROOT}/${name}"
  log "restore complete: ${target}"
}

# verify
cmd_verify() {
  # A TimeoutStartSec kill would otherwise leave the last success timestamp
  # published, so the loud gauge never trips and only the staleness arm does.
  trap 'write_verify_metrics 0 ""; exit 143' INT TERM
  need_lock_or_skip
  reap_stale_locks
  local rc=0 group=""
  if [[ "${1:-}" == "--full" ]]; then
    log "restic check --read-data (full)"
    restic check --read-data || rc=$?
  elif [[ "${1:-}" == "--auto-subset" ]]; then
    # Rotating deep verify: read-verify one pack group per run so the whole repo
    # is re-read against bit-rot every VERIFY_GROUPS runs at a fraction of the
    # egress. The cursor advances only on success (next_verify_group).
    group="$(next_verify_group)"
    log "restic check --read-data-subset=${group}/${VERIFY_GROUPS} (rotating deep verify)"
    restic check --read-data-subset="${group}/${VERIFY_GROUPS}" || rc=$?
  else
    log "restic check (structure + subset of packs)"
    restic check || rc=$?
  fi
  if [[ "$rc" -eq 0 ]]; then
    write_verify_metrics 1 "$group"
    log "verify OK${group:+ (group ${group}/${VERIFY_GROUPS})}"
  else
    write_verify_metrics 0 ""
    log "verify FAILED (rc=${rc})"
    if [[ "$rc" -eq 11 ]]; then
      log "rc=11 is a repository lock — clear a stale one with: restic-offsitectl unlock"
    fi
  fi
  return "$rc"
}

# restore drill

# The drill proves bytes come back out and match. It stays small because egress
# is billed; repo-wide bit-rot is `verify --auto-subset`'s job. See the README.

# Newest snapshot per file source, resolved once. The selection walk resolves a
# comparand per candidate, so re-globbing .zfs/snapshot each time would dominate
# the drill's runtime on a repository with many files.
DRILL_SNAPS=()
drill_cache_snaps() {
  local i name mp
  DRILL_SNAPS=()
  for i in "${!FILE_SOURCES[@]}"; do
    read -r name mp <<< "${FILE_SOURCES[$i]}"
    DRILL_SNAPS[i]="$(latest_file_snap "$mp")"
  done
}

# Where a repository path can be compared against on this host, and which file
# source it belongs to. The comparand is the immutable snapshot subtree, not the
# live dataset. Prints "<source index><TAB><comparand>", or nothing.
drill_compare_path() {
  local p="$1" entry name mp rest snap i
  for i in "${!FILE_SOURCES[@]}"; do
    entry="${FILE_SOURCES[$i]}"
    [[ -n "$entry" ]] || continue
    read -r name mp <<< "$entry"
    if [[ "$BIND_MODE" == "bind" ]]; then
      [[ "$p" == "${BIND_ROOT}/${name}/"* ]] || continue
      rest="${p#"${BIND_ROOT}/${name}/"}"
    else
      [[ "$p" == "${mp}/.zfs/snapshot/"* ]] || continue
      rest="${p#"${mp}/.zfs/snapshot/"}"
      rest="${rest#*/}"
    fi
    snap="${DRILL_SNAPS[$i]:-}"
    if [[ -n "$snap" && -f "${mp}/.zfs/snapshot/${snap}/${rest}" ]]; then
      printf '%s\t%s' "$i" "${mp}/.zfs/snapshot/${snap}/${rest}"
    elif [[ -f "${mp}/${rest}" ]]; then
      printf '%s\t%s' "$i" "${mp}/${rest}"
    fi
    return 0
  done
  return 0
}

cmd_drill() {
  need_lock_or_skip
  reap_stale_locks
  local work restore_dir rc=0 compared=0 mismatched=0 skipped=0 total=0
  local glob_skipped=0 glob_note="" too_small=0 filled=0 round_added=1
  local proven_sources=0 breakdown="" min_sources="$DRILL_MIN_SOURCES"
  local min_bytes="$DRILL_MIN_BYTES"
  local snap_json snap_time snap_epoch size path cmp_src cmp_entry restored src_mtime i
  local name mp idx line snaps_probe=""
  local includes=() sample_paths=() sample_srcs=() sample_mtimes=()
  local src_count=() src_cursor=() src_selected=()

  work="$(mktemp -d)"
  # shellcheck disable=SC2064  # expand $work now: it must survive the function
  trap "rm -rf '$work'" EXIT
  # A TimeoutStartSec kill must publish the failure gauge and still clear $work.
  # shellcheck disable=SC2064
  trap "write_drill_metrics 0 0; rm -rf '$work'; exit 143" INT TERM

  mkdir -p "$PROM_DIR"

  # Probe reachability first, then re-probe with `snapshots --json`: an empty or
  # null snapshot list is "nothing to drill yet", anything else is a real
  # outage.
  if ! restic_ro ls --json latest > "${work}/ls.json" 2>/dev/null; then
    if restic_ro snapshots --json > "${work}/snaps.json" 2>/dev/null; then
      snaps_probe="$(tr -d '[:space:]' < "${work}/snaps.json" 2>/dev/null || true)"
    fi
    case "$snaps_probe" in
      '[]'|'null')
        log "drill FAILED: the offsite repository is reachable but holds no snapshot yet — there is nothing to restore from. Run a backup first (restic-offsitectl run), or set restic_offsite_restore_drill_seed false for this first converge."
        ;;
      *)
        log "drill FAILED: could not list the newest snapshot (is the repository reachable?)"
        ;;
    esac
    write_drill_metrics 0 0
    return 1
  fi

  # The snapshot's time is the selection filter below: only files whose
  # comparand predates it are sampled.
  snap_json="$(restic_ro snapshots --json latest 2>/dev/null || true)"
  snap_time="$(printf '%s' "$snap_json" | grep -o '"time":"[^"]*"' | head -1 | sed 's/.*:"//; s/"$//' || true)"
  snap_epoch="$(date -d "$snap_time" +%s 2>/dev/null || echo 0)"
  case "$snap_epoch" in ''|*[!0-9]*) snap_epoch=0 ;; esac
  # Fail on an unreadable OR empty snapshot time: GNU `date -d ''` is not an
  # error, it resolves to today 00:00, which would silently substitute a wrong
  # churn-filter cutoff and turn a parse miss into a false corruption verdict.
  if [[ -z "${snap_time//[[:space:]]/}" || "$snap_epoch" -le 0 ]]; then
    log "drill FAILED: could not read the newest snapshot's time (got '${snap_time:-}') — the churn filter cannot be applied, and without it a legitimately-changed file would be reported as corruption"
    write_drill_metrics 0 0
    return 1
  fi

  # One JSON object per line. Paths containing a quote or a backslash do not
  # match and are simply not sampled — a sampler may skip awkward names, it may
  # not misread them.
  grep '"type":"file"' "${work}/ls.json" 2>/dev/null \
    | sed -n 's/.*"path":"\([^"\\]*\)".*"size":\([0-9][0-9]*\).*/\2 \1/p' \
    | sort -n -k1,1 > "${work}/candidates" || true

  # An empty candidate list is a PARSE failure — distinct from the "nothing here
  # maps to this host" case handled below.
  if [[ ! -s "${work}/candidates" ]]; then
    if [[ -s "${work}/ls.json" ]]; then
      log "drill FAILED: could not parse any file entry out of 'restic ls --json' — restic's output shape changed and the sampler needs updating"
    else
      log "drill FAILED: 'restic ls --json latest' returned no entries — the newest snapshot appears to be empty"
    fi
    write_drill_metrics 0 0
    return 1
  fi

  # A zero-byte file compares equal to anything, so the floor is never below 1.
  [[ "$min_bytes" -ge 1 ]] || min_bytes=1
  # A requirement above the number of configured sources could never be met, so
  # a source-list change would wedge the drill permanently.
  if [[ "$min_sources" -gt "${#FILE_SOURCES[@]}" ]]; then
    log "drill: restic_offsite_restore_drill_min_sources (${min_sources}) exceeds the ${#FILE_SOURCES[@]} configured file source(s) — requiring ${#FILE_SOURCES[@]}"
    min_sources="${#FILE_SOURCES[@]}"
  fi

  drill_cache_snaps
  for i in "${!FILE_SOURCES[@]}"; do
    src_count[i]=0
    src_cursor[i]=0
    src_selected[i]=0
    : > "${work}/cand.${i}"
  done

  # Bucket eligible candidates per source (size, comparand, repo path). A
  # globally-smallest-first list proves whichever source owns the smallest files
  # and leaves the rest unproven, so the round-robin below draws from buckets.
  while read -r size path; do
    [[ -n "${path:-}" ]] || continue
    # Size floor: without one the sample is the estate's marker files, and a
    # drill that restores five 1-byte files proves almost nothing.
    if [[ "$size" -lt "$min_bytes" ]]; then
      too_small=$(( too_small + 1 ))
      continue
    fi
    # Skip paths with glob metacharacters: restic --include uses
    # filepath.Match, so they never match literally and the loop would report a
    # false MISSING.
    case "$path" in
      *'*'*|*'?'*|*'['*|*']'*|*'\'*)
        log "drill: skipping '${path}' — the path contains a glob metacharacter and cannot be passed as a literal --include pattern"
        glob_skipped=$(( glob_skipped + 1 ))
        continue
        ;;
    esac
    cmp_entry="$(drill_compare_path "$path")"
    [[ -n "$cmp_entry" ]] || continue
    idx="${cmp_entry%%$'\t'*}"
    cmp_src="${cmp_entry#*$'\t'}"
    [[ "${src_count[$idx]}" -lt "$DRILL_SAMPLE_FILES" ]] || continue
    src_mtime="$(stat -c %Y "$cmp_src" 2>/dev/null || echo 0)"
    case "$src_mtime" in ''|*[!0-9]*) src_mtime=0 ;; esac
    # Skip anything written after the snapshot: it legitimately differs, so
    # sampling it would produce a false MISMATCH. snap_epoch is guaranteed
    # above to be > 0, so the filter is never conditionally disabled.
    if [[ "$src_mtime" -gt "$snap_epoch" ]]; then continue; fi
    printf '%s\t%s\t%s\n' "$size" "$cmp_src" "$path" >> "${work}/cand.${idx}"
    src_count[idx]=$(( src_count[idx] + 1 ))
    if [[ "${src_count[$idx]}" -eq "$DRILL_SAMPLE_FILES" ]]; then
      filled=$(( filled + 1 ))
      [[ "$filled" -lt "${#FILE_SOURCES[@]}" ]] || break
    fi
  done < "${work}/candidates"

  # Round-robin: one file per source per round, smallest first within a source,
  # until the sample size is reached or every bucket is spent.
  while [[ "${#sample_paths[@]}" -lt "$DRILL_SAMPLE_FILES" && "$round_added" -gt 0 ]]; do
    round_added=0
    for i in "${!FILE_SOURCES[@]}"; do
      [[ "${#sample_paths[@]}" -lt "$DRILL_SAMPLE_FILES" ]] || break
      [[ "${src_cursor[$i]}" -lt "${src_count[$i]}" ]] || continue
      src_cursor[i]=$(( src_cursor[i] + 1 ))
      line="$(sed -n "${src_cursor[$i]}p" "${work}/cand.${i}")"
      IFS=$'\t' read -r size cmp_src path <<< "$line"
      # The byte cap is per drill, so a source whose next candidate would blow
      # it is passed over rather than ending the selection. Buckets ascend by
      # size, so a source that fails the cap once is effectively done.
      if [[ $(( total + size )) -gt "$DRILL_MAX_BYTES" ]]; then continue; fi
      src_mtime="$(stat -c %Y "$cmp_src" 2>/dev/null || echo 0)"
      case "$src_mtime" in ''|*[!0-9]*) src_mtime=0 ;; esac
      includes+=( --include "$path" )
      sample_paths+=( "$path" )
      sample_srcs+=( "$cmp_src" )
      sample_mtimes+=( "$src_mtime" )
      src_selected[i]=$(( src_selected[i] + 1 ))
      total=$(( total + size ))
      round_added=$(( round_added + 1 ))
    done
  done

  # Per-source breakdown: how many files were sampled is not the same question
  # as which sources this drill actually proves.
  for i in "${!FILE_SOURCES[@]}"; do
    read -r name mp <<< "${FILE_SOURCES[$i]}"
    if [[ "${src_selected[$i]}" -gt 0 ]]; then
      proven_sources=$(( proven_sources + 1 ))
    fi
    breakdown="${breakdown} ${name}=${src_selected[$i]}"
  done
  log "drill: sampled${breakdown:- none} (${proven_sources}/${#FILE_SOURCES[@]} file sources; ${too_small} candidate(s) under the ${min_bytes}-byte floor, ${glob_skipped} skipped for glob metacharacters)"

  if [[ "${#sample_paths[@]}" -eq 0 ]]; then
    glob_note=""
    if [[ "$glob_skipped" -gt 0 ]]; then
      glob_note=" (${glob_skipped} candidate(s) skipped for glob metacharacters in their path)"
    fi
    log "drill FAILED: no file in the newest snapshot maps to a stable, comparable path on this host — nothing was proven${glob_note}"
    write_drill_metrics 0 0
    return 1
  fi

  # Coverage floor. A sample drawn from one source proves that source only, and
  # the pass looks identical to one that covered the estate.
  if [[ "$proven_sources" -lt "$min_sources" ]]; then
    log "drill FAILED: only ${proven_sources} of ${#FILE_SOURCES[@]} file source(s) yielded a sampled file, below the required ${min_sources} — lower restic_offsite_restore_drill_min_sources or fix the sources that yielded nothing"
    write_drill_metrics 0 0
    return 1
  fi

  restore_dir="${work}/restore"
  mkdir -p "$restore_dir"
  log "drill: restoring ${#sample_paths[@]} file(s) (${total} bytes) from the newest snapshot into ${restore_dir}"
  restic restore latest --target "$restore_dir" "${includes[@]}" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    log "drill: restic restore FAILED (rc=${rc})"
  fi

  for i in "${!sample_paths[@]}"; do
    path="${sample_paths[$i]}"
    cmp_src="${sample_srcs[$i]}"
    restored="${restore_dir}${path}"
    if [[ ! -f "$restored" ]]; then
      log "drill: MISSING after restore: ${path}"
      mismatched=$(( mismatched + 1 ))
      continue
    fi
    if cmp -s "$restored" "$cmp_src"; then
      compared=$(( compared + 1 ))
      continue
    fi
    # The only tolerated difference: the comparand was rewritten between
    # sampling and comparing. Anything else is corruption and must be loud.
    src_mtime="$(stat -c %Y "$cmp_src" 2>/dev/null || echo 0)"
    case "$src_mtime" in ''|*[!0-9]*) src_mtime=0 ;; esac
    if [[ "$src_mtime" != "${sample_mtimes[$i]}" ]]; then
      log "drill: ${path} differs, but ${cmp_src} was rewritten during the drill — not counted"
      skipped=$(( skipped + 1 ))
      continue
    fi
    log "drill: MISMATCH ${path} vs ${cmp_src} — restored bytes are NOT the source bytes"
    mismatched=$(( mismatched + 1 ))
  done

  if [[ "$rc" -eq 0 && "$mismatched" -eq 0 && "$compared" -gt 0 ]]; then
    write_drill_metrics 1 "$compared"
    log "drill OK: ${compared} file(s) restored from the offsite repository and byte-identical to source (${skipped} skipped as changed since the snapshot)"
    return 0
  fi
  write_drill_metrics 0 "$compared"
  log "drill FAILED: ${compared} matched, ${mismatched} mismatched/missing, ${skipped} skipped, restore rc=${rc}"
  return 1
}

# snapshots / prune / unlock / status
cmd_snapshots() { restic_ro snapshots; }

cmd_prune() {
  local max_remove="$FORGET_MAX_REMOVE"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --max-remove)
        max_remove="${2:-}"
        [[ "$max_remove" =~ ^[0-9]+$ ]] || { log "--max-remove needs a number"; return 2; }
        shift 2
        ;;
      *) log "unknown prune argument: $1"; return 2 ;;
    esac
  done
  need_lock_or_die
  reap_stale_locks
  run_forget "$max_remove"
}

# Non-zero while locks remain, and count_locks propagates restic's rc: a
# swallowed `list locks` failure would report an unreadable repo as "no locks".
count_locks() {
  local out
  out="$(restic_ro list locks 2>/dev/null)" || return 1
  printf '%s\n' "$out" | grep -c . || true
}

cmd_unlock() {
  local before after
  need_lock_or_die
  if ! before="$(count_locks)"; then
    log "unlock: could not read the repository's lock list at all — this is NOT 'no locks'. The repository is unreachable, the credentials/password are wrong, or the repo no longer exists. Diagnose that first (restic-offsitectl status); nothing was reaped."
    return 1
  fi
  reap_stale_locks
  if ! after="$(count_locks)"; then
    log "unlock: the lock list became unreadable after reaping — the repository is unreachable, the credentials/password are wrong, or the repo no longer exists. The lock state is UNKNOWN, not clear. Diagnose that first (restic-offsitectl status)."
    return 1
  fi
  echo "--- restic locks (after reaping) ---"
  restic_ro list locks || true
  if [[ "$after" -eq 0 ]]; then
    if [[ "$_REAPED_LOCKS" -gt 0 ]]; then
      log "unlock: removed $(( before - after )) stale lock(s); the repository is now unlocked"
    else
      log "unlock: no locks on the repository — nothing to remove"
    fi
    return 0
  fi
  if [[ "$_REAPED_LOCKS" -gt 0 ]]; then
    log "unlock: removed $(( before - after )) stale lock(s), ${after} still held"
  fi
  log "unlock: ${after} lock(s) remain and none met the staleness test (other host / live pid / age <= ${STALE_LOCK_MIN_AGE_H}h) — the per-lock reason is logged above. Do NOT force-unlock a live run; wait for it, or stop the unit that holds it."
  return 1
}

# restic_ro throughout: `status` is what an operator runs WHILE the repo is
# locked, so it must never block on the lock it is being used to diagnose.
cmd_status() {
  systemctl status restic-offsite.timer --no-pager 2>/dev/null || true
  systemctl status restic-offsite.service --no-pager 2>/dev/null || true
  echo "--- restic snapshots (tail) ---"
  restic_ro snapshots 2>/dev/null | tail -n 15 || true
  echo "--- restic stats (raw-data) ---"
  restic_ro stats --mode raw-data 2>/dev/null || true
}

# Single-instance lock shared with cmd_run: a restore/verify/prune must never
# interleave with a mid-run backup (they'd race the same repo). Fail fast.
need_lock_or_die() {
  exec 9>"$LOCK"
  if ! flock -n 9; then
    log "restic-offsite run in progress (lock held); retry after the nightly window"
    exit 1
  fi
}

# Same lock, for the timer-driven checks: contention with a long nightly upload
# is expected, so the unit must not go 'failed' and page. The staleness alerts
# still fire if the timestamp stops advancing week after week.
need_lock_or_skip() {
  exec 9>"$LOCK"
  if ! flock -n 9; then
    log "restic-offsite run in progress (lock held); skipping — the timer retries next interval"
    exit 0
  fi
}

usage() {
  cat <<USAGE
Usage: restic-offsitectl <command> [args]   (run as root)

Commands:
  run [--force]                Run the nightly offsite backup now (freshness-guarded).
                               Skips when the last successful backup already covers
                               the newest source snapshot; --force overrides that skip.
  restore <name> [snap] [dir]  Restore a source (default snap=latest) into dir
                               (default {% endraw %}{{ restic_offsite_restore_base | default('/mnt/restore/restic') }}{% raw %}/<name>/<ts>)
  verify [--full|--auto-subset]  restic check (--full reads all pack data;
                               --auto-subset reads the next rotating pack group —
                               the weekly restic-offsite-verify.timer's mode)
  drill                        Restore {% endraw %}{{ restic_offsite_restore_drill_sample_files | default(5) }}{% raw %} file(s) of the newest snapshot,
                               spread across the file sources, and byte-compare
                               them against source (the quarterly
                               backup-restore-drill.timer's mode)
  snapshots                    List restic snapshots
  prune [--max-remove N]       restic forget --prune (GFS retention). Refuses to
                               run (exit 90) when the dry-run would forget more
                               than N snapshots (default {% endraw %}{{ restic_offsite_forget_max_remove | default(3) }}{% raw %}) — name the count
                               to accept a deliberate retention/grouping change.
  unlock                       Remove a stale repository lock left by a crashed
                               run on this host, then list remaining locks and
                               print a verdict. Exits 1 when locks remain (each
                               one's skip reason — other host / live pid / too
                               young — is logged); never force-unlocks a live run.
  status                       Timer/service status + snapshots + repo stats
  restic <args...>             Authenticated passthrough to bare restic for
                               one-off ops the wrappers don't carry (e.g.
                               \`restic tag --add legacy <snapshot-id>\` to pin
                               a snapshot against retention via the keep-tags
                               policy). No guardrails — you hold the knife.
USAGE
}

main() {
  need_root
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    run) cmd_run "$@" ;;
    restore) cmd_restore "$@" ;;
    verify) cmd_verify "$@" ;;
    drill) cmd_drill "$@" ;;
    snapshots) cmd_snapshots ;;
    prune) cmd_prune "$@" ;;
    unlock) cmd_unlock ;;
    status) cmd_status ;;
    restic) restic "$@" ;;
    ""|help|-h|--help) usage ;;
    *) echo "Unknown command: $cmd" >&2; usage; exit 2 ;;
  esac
}

main "$@"
{% endraw %}
