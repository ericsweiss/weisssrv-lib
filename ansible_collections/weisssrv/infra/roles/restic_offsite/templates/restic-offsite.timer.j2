# {{ ansible_managed }}
[Unit]
Description=Nightly trigger for the offsite B2 backup
# Nightly trigger. A site can also chain this unit off archive replication; the
# control script's already-uploaded short-circuit makes a double trigger a no-op.

[Timer]
OnCalendar={{ restic_offsite_timer_calendar }}
Persistent=true
RandomizedDelaySec={{ restic_offsite_timer_randomized_delay }}

[Install]
WantedBy=timers.target
