# {{ ansible_managed }}
[Unit]
Description=Fallback trigger for the nightly offsite B2 backup
# PRIMARY trigger is OnSuccess=restic-offsite.service on the archive replication
# unit; this timer covers the rare path where that OnSuccess is skipped. It is
# unconditional by design — the control script's already-uploaded short-circuit
# decides whether there is anything new to send, so the guard also applies to a
# manual invocation.

[Timer]
OnCalendar={{ restic_offsite_timer_calendar }}
Persistent=true
RandomizedDelaySec={{ restic_offsite_timer_randomized_delay }}

[Install]
WantedBy=timers.target
