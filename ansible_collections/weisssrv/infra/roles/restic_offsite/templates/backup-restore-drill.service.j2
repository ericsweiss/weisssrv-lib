# {{ ansible_managed }}
[Unit]
Description=Quarterly offsite restore drill (restore a sample and byte-compare it)
# The comparands live in the source pools' ZFS snapshots, so the mount passes
# must have completed. The shared flock keeps it out of a mid-run nightly backup
# (it skips and Persistent=true catches up).
After=zfs-mount.service zfs-mount-encrypted.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile={{ restic_offsite_config_dir }}/env
# Fails the unit on mismatch by design: that is what puts the mismatching path
# in the journal next to the failure.
ExecStart=/usr/local/sbin/restic-offsitectl drill
TimeoutStartSec={{ restic_offsite_drill_timeout_start_sec }}
TimeoutStopSec={{ restic_offsite_timeout_stop_sec }}
# Without this the journal tag is the ExecStart basename, the same one the
# nightly run and the weekly verify get; the alert points at this tag.
SyslogIdentifier=backup-restore-drill
Nice={{ restic_offsite_nice }}
IOSchedulingClass={{ restic_offsite_io_class }}
IOSchedulingPriority={{ restic_offsite_io_priority }}
CPUWeight={{ restic_offsite_cpu_weight }}
IOWeight={{ restic_offsite_io_weight }}
