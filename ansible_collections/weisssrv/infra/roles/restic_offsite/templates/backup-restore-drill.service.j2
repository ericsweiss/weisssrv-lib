# {{ ansible_managed }}
[Unit]
Description=Quarterly offsite restore drill (restore a sample and byte-compare it)
# The comparands are files inside the source pools' ZFS snapshots, so the mount
# passes must have completed; the control script's shared flock keeps it from
# interleaving with a mid-run nightly backup (it fails fast and Persistent=true
# catches up).
After=zfs-mount.service zfs-mount-encrypted.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile={{ restic_offsite_config_dir }}/env
# Fails the unit on mismatch by design: the metric answers "when did a drill
# last PASS", and a failed unit is what puts the failure in the journal next to
# the mismatching path.
ExecStart=/usr/local/sbin/restic-offsitectl drill
# journald tags stdout with the ExecStart BASENAME by default, i.e.
# `restic-offsitectl` — the same tag the nightly run and the weekly verify get.
# The alert annotation and docs/42 both send an operator to
# `journalctl -t backup-restore-drill`, which would return nothing. Pin the tag
# so that command works and the drill's journal is separable from the run's.
SyslogIdentifier=backup-restore-drill
Nice={{ restic_offsite_nice }}
IOSchedulingClass={{ restic_offsite_io_class }}
IOSchedulingPriority={{ restic_offsite_io_priority }}
CPUWeight={{ restic_offsite_cpu_weight }}
IOWeight={{ restic_offsite_io_weight }}
