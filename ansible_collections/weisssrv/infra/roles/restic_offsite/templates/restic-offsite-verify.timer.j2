# {{ ansible_managed }}
[Unit]
Description=Weekly trigger for the rotating offsite restic deep verify

[Timer]
# Schedule it far from the nightly backup window so the verify never competes
# with the dump/replication/upload chain for storage I/O.
OnCalendar={{ restic_offsite_verify_timer_calendar }}
Persistent=true
RandomizedDelaySec=30m

[Install]
WantedBy=timers.target
