# {{ ansible_managed }}
[Unit]
Description=Nightly offsite backup to Backblaze B2 (restic + rclone)
# Ordered after both ZFS mount passes: sources on encrypted datasets mount only
# once their keys load. The timer is the nightly trigger; a site may also chain
# this unit from the archive replication unit with OnSuccess=.
After=zfs-mount.service zfs-mount-encrypted.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile={{ restic_offsite_config_dir }}/env
ExecStart=/usr/local/sbin/restic-offsitectl run
# systemd leaves Type=oneshot without a start timeout, so a wedged run would
# hold the repository lock and block every later run.
TimeoutStartSec={{ restic_offsite_backup_timeout_start_sec }}
TimeoutStopSec={{ restic_offsite_timeout_stop_sec }}
# Deferential under contention: Nice + ionice set absolute priority; the
# cgroup-v2 weights only bite when something else competes.
Nice={{ restic_offsite_nice }}
IOSchedulingClass={{ restic_offsite_io_class }}
IOSchedulingPriority={{ restic_offsite_io_priority }}
CPUWeight={{ restic_offsite_cpu_weight }}
IOWeight={{ restic_offsite_io_weight }}
