# {{ ansible_managed }}
# rclone remote for the restic backend. Rendered 0600 root:root with no_log.

# b2: hard_delete unset, so rclone deletes by hiding and the bucket lifecycle
# rule expires hidden versions, letting a key without deleteFiles prune.

# CRITICAL: restic's rclone backend passes --b2-hard-delete on the command
# line, which beats this file. restic-offsitectl strips it on every invocation;
# keep the two in sync.
[{{ restic_offsite_rclone_remote_name }}]
type = {{ restic_offsite_rclone_remote_type }}
{% if restic_offsite_rclone_remote_type == 'b2' %}
account = {{ restic_offsite_b2_key_id }}
key = {{ restic_offsite_b2_application_key }}
{% endif %}
{% for opt_key, opt_value in (restic_offsite_rclone_remote_options | default({}) | dictsort) %}
{{ opt_key }} = {{ opt_value }}
{% endfor %}
