# {{ ansible_managed }}

server:
  # Loopback only by default: a filtering resolver in front of this is the
  # LAN-facing one.
{% for iface in unbound_interfaces %}
  interface: {{ iface }}
{% endfor %}
  port: {{ unbound_port }}
  do-ip4: yes
  do-ip6: yes
  do-udp: yes
  do-tcp: yes

  num-threads: {{ unbound_num_threads }}
  msg-cache-size: {{ unbound_msg_cache_size }}
  rrset-cache-size: {{ unbound_rrset_cache_size }}
  outgoing-range: {{ unbound_outgoing_range }}
  num-queries-per-thread: {{ unbound_num_queries_per_thread }}
  so-reuseport: {{ 'yes' if (unbound_so_reuseport | bool) else 'no' }}

  serve-expired: {{ 'yes' if (unbound_serve_expired | bool) else 'no' }}
  serve-expired-ttl: {{ unbound_serve_expired_ttl }}
  aggressive-nsec: {{ 'yes' if (unbound_aggressive_nsec | bool) else 'no' }}
  edns-buffer-size: {{ unbound_edns_buffer_size }}

  # Per-rcode, per-type and per-class counters. The exporter emits
  # unbound_answer_rcodes_total only when this is on.
  extended-statistics: yes

  tls-cert-bundle: "/etc/ssl/certs/ca-certificates.crt"

  hide-identity: yes
  hide-version: yes
  qname-minimisation: yes
  harden-glue: yes
  harden-dnssec-stripped: yes
  # 0x20 DNS-name randomization. Turn it off when an upstream changes the query
  # name's case, which unbound then answers with SERVFAIL. See README.
  use-caps-for-id: {{ 'yes' if (unbound_use_caps_for_id | bool) else 'no' }}
  prefetch: yes
  cache-min-ttl: 60
  cache-max-ttl: 86400

  # DNS rebinding protection: a public domain must never resolve to a
  # private/loopback address. Internal names are answered by the filtering
  # resolver in front of unbound, so it never legitimately returns these ranges.
  private-address: 10.0.0.0/8
  private-address: 172.16.0.0/12
  private-address: 192.168.0.0/16
  private-address: 127.0.0.0/8
  private-address: ::1
  private-address: fd00::/8
  private-address: fe80::/10

  # A netblock not listed here falls back to unbound's built-in default:
  # localhost is allowed and everything else is refused.
{% for acl in unbound_access_control %}
  access-control: {{ acl }}
{% endfor %}

forward-zone:
  name: "."
  forward-tls-upstream: yes
{% for forwarder in unbound_forwarders %}
  # {{ forwarder.name }}
  forward-addr: {{ forwarder.addr }}@{{ forwarder.port }}#{{ forwarder.name }}
{% endfor %}
