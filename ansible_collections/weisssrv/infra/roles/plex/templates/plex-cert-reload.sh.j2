#!/bin/bash
# {{ ansible_managed }}
#
# Builds the PKCS#12 bundle Plex reads from the PEM pair in {{ plex_cert_dir }},
# restarts Plex, verifies the served leaf and reverts on failure. Details: README.

set -euo pipefail

CERT_DIR={{ plex_cert_dir | quote }}
PEM_FULLCHAIN="$CERT_DIR/fullchain.pem"
PEM_KEY="$CERT_DIR/privkey.pem"
PFX_FILE="$CERT_DIR/plex.pfx"
PFX_PREV="$CERT_DIR/plex.pfx.prev"
PFX_PASSPHRASE_FILE="$CERT_DIR/pfx-passphrase"
PLEX_GROUP={{ plex_user | quote }}
PLEX_PORT={{ plex_port | string | quote }}
CERT_DOMAIN_FALLBACK={{ plex_cert_domain | quote }}

[[ -r "$PEM_FULLCHAIN" && -r "$PEM_KEY" ]] || {
    echo "missing PEM input files in $CERT_DIR" >&2
    exit 1
}
[[ -r "$PFX_PASSPHRASE_FILE" ]] || {
    echo "missing $PFX_PASSPHRASE_FILE (deploy via the plex role)" >&2
    exit 1
}
[[ -s "$PFX_PASSPHRASE_FILE" ]] || {
    echo "$PFX_PASSPHRASE_FILE is empty; the bundle would be built with an empty passphrase" >&2
    exit 1
}

# Every post-swap failure path reverts through this; there is nothing to revert
# to on a first install.
revert_bundle() {
    [[ -f "$PFX_PREV" ]] || return 0
    cp -p "$PFX_PREV" "$PFX_FILE"
    chown "root:$PLEX_GROUP" "$PFX_FILE"
    chmod 0640 "$PFX_FILE"
    systemctl restart plexmediaserver || true
}

# The passphrase goes to openssl through a file reference, not `pass:` on argv,
# so it never appears in /proc/<pid>/cmdline.
PFX_TMP=$(mktemp -p "$CERT_DIR" .plex.pfx.XXXXXX)
trap 'rm -f "$PFX_TMP"' EXIT

openssl pkcs12 \
    -export \
    -inkey "$PEM_KEY" \
    -in "$PEM_FULLCHAIN" \
    -out "$PFX_TMP" \
    -name "Plex Server Certificate" \
    -passout "file:$PFX_PASSPHRASE_FILE"

# Parse the bundle back before swapping it in: one that generated successfully
# but is unopenable would break Plex on its next restart.
if ! openssl pkcs12 -info -in "$PFX_TMP" -nokeys -noout \
        -password "file:$PFX_PASSPHRASE_FILE" >/dev/null 2>&1; then
    echo "PFX bundle generated but failed verification; aborting swap" >&2
    exit 1
fi

chmod 0640 "$PFX_TMP"
chown "root:$PLEX_GROUP" "$PFX_TMP"

# Keep the prior bundle as a one-step revert; on a first install there is none.
if [[ -f "$PFX_FILE" ]]; then
    cp -p "$PFX_FILE" "$PFX_PREV"
fi

# Drop the trap before the mv so a signal between mv and restart cannot delete
# the now-installed bundle.
trap - EXIT
mv "$PFX_TMP" "$PFX_FILE"

# Capture the restart's own rc: under set -e a failed restart would abort before
# the revert path could run.
restart_rc=0
systemctl restart plexmediaserver || restart_rc=$?

# `systemctl restart` returns as soon as the unit is asked to restart, so the
# unit state is checked after a short wait.
sleep 3
if [[ $restart_rc -ne 0 ]] || ! systemctl is-active --quiet plexmediaserver; then
    echo "plexmediaserver failed to come back up after cert swap; reverting" >&2
    revert_bundle
    exit 1
fi

# Plex stays active while silently serving its plex.direct fallback on a parse
# failure, so compare the served leaf against the pushed fullchain (~60s budget).
EXPECTED_FP=$(openssl x509 -in "$PEM_FULLCHAIN" -noout -fingerprint -sha256) || EXPECTED_FP=""

# The probe MUST send SNI: without it Plex serves the *.plex.direct fallback.
# The domain comes from live Preferences.xml; the role default is the fallback.
PLEX_PREFS="{{ plex_config_dir }}/Library/Application Support/Plex Media Server/Preferences.xml"
CERT_DOMAIN=""
if [[ -r "$PLEX_PREFS" ]]; then
    CERT_DOMAIN=$(grep -oE 'customCertificateDomain="[^"]*"' "$PLEX_PREFS" 2>/dev/null \
        | head -1 | cut -d'"' -f2) || CERT_DOMAIN=""
fi
CERT_DOMAIN="${CERT_DOMAIN:-$CERT_DOMAIN_FALLBACK}"
# The swap already happened, so anything that blocks verification must revert it.
if [[ -z "$CERT_DOMAIN" || -z "$EXPECTED_FP" ]]; then
    echo "cannot verify the pushed certificate (domain or fingerprint unavailable); reverting the unverified certificate swap" >&2
    revert_bundle
    exit 1
fi
SERVED_FP=""
for _ in $(seq 1 20); do
    SERVED_FP=$(openssl s_client -connect "127.0.0.1:$PLEX_PORT" -servername "$CERT_DOMAIN" \
        </dev/null 2>/dev/null \
        | openssl x509 -noout -fingerprint -sha256 2>/dev/null) || SERVED_FP=""
    [[ "$SERVED_FP" == "$EXPECTED_FP" ]] && break
    sleep 3
done
if [[ "$SERVED_FP" != "$EXPECTED_FP" ]]; then
    if [[ -f "$PFX_PREV" ]]; then
        echo "plex is serving an unexpected certificate after cert swap (got ${SERVED_FP:-nothing}); reverting" >&2
        revert_bundle
        exit 1
    fi
    # First install: nothing to revert to and the custom cert is not live until
    # an operator sets it in the UI - warn instead of failing the run.
    echo "warning: plex is not serving the pushed certificate (got ${SERVED_FP:-nothing}); if this is the first install, configure the custom certificate location + encryption key in Plex settings" >&2
fi

echo "plex cert reloaded ($PFX_FILE)"
