# {{ ansible_managed }}

{# to_json emits a safe double-quoted JSON string (valid YAML), so a credential
   holding YAML-significant characters cannot mis-parse or truncate. No wrapping
   quotes here — to_json supplies its own. #}
origin:
  url: {{ adguard_sync_origin | to_json }}
  username: {{ adguard_sync_admin_user | to_json }}
  password: {{ adguard_sync_admin_password | to_json }}

replica:
  url: {{ adguard_sync_replica | to_json }}
  username: {{ adguard_sync_admin_user | to_json }}
  password: {{ adguard_sync_admin_password | to_json }}

features:
{% for feature, config in adguard_sync_features.items() %}
{% if config is mapping %}
  {{ feature }}:
{% for subfeature, value in config.items() %}
    {{ subfeature }}: {{ value | lower }}
{% endfor %}
{% else %}
  {{ feature }}: {{ config | lower }}
{% endif %}
{% endfor %}

api:
  port: 0  # metrics API off — the failure signal is the ExecStopPost .prom
