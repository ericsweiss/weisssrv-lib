#!/usr/bin/env bash
# {{ ansible_managed }}
# node_exporter textfile metrics for the adguardhome-sync timer, its only
# failure signal. ExecStopPost prefixed '+'; $1 is systemd's $SERVICE_RESULT.
set -u

PROM_DIR="{{ adguard_sync_textfile_dir }}"
PROM_FILE="${PROM_DIR}/adguardhome_sync.prom"

# Missing textfile dir: say so rather than dropping the only failure signal.
[ -d "$PROM_DIR" ] || {
  logger -t adguardhome-sync-metrics -p daemon.err \
    "textfile dir ${PROM_DIR} absent; adguardhome_sync_last_run_success not published" || true
  exit 0
}

if [ "${1:-}" = "success" ]; then
  success=1
else
  success=0
fi

ts="$(date +%s)"
tmp="${PROM_FILE}.$$"
{
  echo "# HELP adguardhome_sync_last_run_success Whether the last adguardhome-sync run succeeded (1=success, 0=failure)"
  echo "# TYPE adguardhome_sync_last_run_success gauge"
  echo "adguardhome_sync_last_run_success ${success}"
  # Preserve the last-known success timestamp on failure so a staleness alert
  # measures time-since-last-success, not time-since-last-attempt.
  if [ "$success" -eq 1 ]; then
    sval="$ts"
  else
    sval="$(awk '/^adguardhome_sync_last_success_timestamp_seconds/ {print $2}' "$PROM_FILE" 2>/dev/null || true)"
  fi
  if [ -n "${sval:-}" ]; then
    echo "# HELP adguardhome_sync_last_success_timestamp_seconds Unix timestamp of last successful sync"
    echo "# TYPE adguardhome_sync_last_success_timestamp_seconds gauge"
    echo "adguardhome_sync_last_success_timestamp_seconds ${sval}"
  fi
} > "$tmp" 2>/dev/null || {
  logger -t adguardhome-sync-metrics -p daemon.err "could not write ${PROM_FILE}"
  rm -f "$tmp"
  exit 0
}
mv "$tmp" "$PROM_FILE" 2>/dev/null || {
  logger -t adguardhome-sync-metrics -p daemon.err "could not rename ${tmp} -> ${PROM_FILE}"
  rm -f "$tmp"
}
