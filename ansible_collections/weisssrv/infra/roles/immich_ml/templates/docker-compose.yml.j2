{# Byte-stable: any change here notifies "Restart compose stack", which is a
   full stack down+up. Do not churn this file for cosmetics. #}
# {{ ansible_managed }}
# Immich machine-learning (OpenVINO), mirroring the hwaccel.ml.yml openvino
# stanza of Immich {{ immich_ml_version }}. Host edits are reverted on deploy.
name: immich-ml

services:
  immich-machine-learning:
    image: {{ immich_ml_image }}
    # Upstream openvino stanza: USB device-class rule (Intel NPU/Movidius
    # sticks); harmless with no matching device present.
    device_cgroup_rules:
      - 'c 189:* rmw'
    devices:
      - {{ immich_ml_device_dir }}:{{ immich_ml_device_dir }}
    # CAP_DAC_OVERRIDE cannot bypass the 0660 root:video/render device perms
    # when the container's root is not host root, so grant the video/render
    # GIDs (discovered from the /dev/dri nodes at deploy time).
    group_add:
      - "{{ immich_ml_video_gid }}"
      - "{{ immich_ml_render_gid }}"
    environment:
      TZ: {{ immich_ml_timezone }}
{% for key, value in immich_ml_extra_env.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
    volumes:
      # Model cache (multi-GB, downloaded on first run). Named volume in the
      # LXC rootfs: re-downloadable cache, not state — no backup enrollment.
      - model-cache:/cache
    ports:
      # AUTHLESS endpoint; the site firewall is the security boundary.
      - "{{ immich_ml_bind }}:{{ immich_ml_listen_port }}:3003"
    restart: always

volumes:
  model-cache:
