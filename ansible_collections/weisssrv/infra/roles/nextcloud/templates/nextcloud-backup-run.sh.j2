#!/usr/bin/env bash
# {{ ansible_managed }}
# Nightly Nextcloud PostgreSQL backup, run by nextcloud-backup.timer. Not
# `set -e`: the dump's exit code is captured so the metric is always written.
set -uo pipefail

COMPOSE_DIR="{{ nextcloud_compose_dir }}"
BACKUP_DIR="{{ nextcloud_backup_dir }}"
KEEP_DAYS="{{ nextcloud_backup_keep_days }}"
DB_NAME="{{ nextcloud_db_name }}"
DB_USER="{{ nextcloud_db_user }}"
PROM_DIR="{{ nextcloud_backup_metrics_dir }}"
# 1 when the backup lands on the NFS export (nextcloud_backup_nfs_enabled).
NFS_ENABLED="{{ '1' if (nextcloud_backup_nfs_enabled | bool) else '0' }}"

METRICS_LIB="{{ nextcloud_backup_lib_path }}"
# Hard gate: without the lib, write_prom_metrics is undefined and the run would
# proceed metric-less — refuse instead.
if [ ! -r "$METRICS_LIB" ]; then
  echo "nextcloud-backup: metrics library $METRICS_LIB missing — re-run the nextcloud role" >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$METRICS_LIB"
{% raw %}
PROM_FILE="${PROM_DIR}/nextcloud_backup.prom"
START_TS="$(date +%s)"
# Matches the FINAL dump name only, so an in-progress .partial is never sized as
# a healthy artefact. Metric semantics: README § Backups.
ARTIFACT_GLOB="${BACKUP_DIR}/nextcloud-db-*.sql.gz"

mkdir -p "$PROM_DIR"

require_mounted_landing_zone nextcloud_backup "$BACKUP_DIR" "$NFS_ENABLED" "$PROM_FILE" || exit 1
mkdir -p "$BACKUP_DIR"
cd "$COMPOSE_DIR" || exit 1

OUT="${BACKUP_DIR}/nextcloud-db-$(date +%Y%m%d-%H%M%S).sql.gz"
# .partial -> final rename only after both pipe stages and the size floor pass;
# the final name is what the artefact collector and the offsite walk key on.
TMP="${OUT}.partial"
# Best-effort cleanup; the post-retention .partial sweep covers a SIGKILL.
trap 'rm -f -- "$TMP"' EXIT

# pg_dump in the db container -> gzip on the host; --clean --if-exists makes the
# dump restorable over an existing schema. Both pipe stages' exit codes are
# captured: a gzip or disk-full failure can still leave a non-empty partial.
docker compose exec -T nextcloud-db \
  pg_dump -U "$DB_USER" -d "$DB_NAME" --clean --if-exists 2>/dev/null | gzip -c > "$TMP"
pipe_status=("${PIPESTATUS[@]}")

# A plausibility floor, not just `[ -s ]`: a gzip header alone is ~20 bytes.
# Taken from the .partial, before promotion.
rc=1
size=0
if [ "${pipe_status[0]}" -eq 0 ] && [ "${pipe_status[1]}" -eq 0 ] && [ -f "$TMP" ]; then
  size="$(stat -c %s "$TMP" 2>/dev/null || echo 0)"
  if [ "$size" -ge 1000 ] && mv -f -- "$TMP" "$OUT"; then
    rc=0
    # Prune old dumps only after a successful new one.
    find "$BACKUP_DIR" -maxdepth 1 -name 'nextcloud-db-*.sql.gz' -type f -mtime "+${KEEP_DAYS}" -delete 2>/dev/null || true
    # Sweep .partial files a SIGKILL left behind.
    find "$BACKUP_DIR" -maxdepth 1 -name 'nextcloud-db-*.sql.gz.partial' -type f -mtime +1 -delete 2>/dev/null || true
  fi
fi

if [ "$rc" -ne 0 ]; then
  # Only the .partial can exist here; report 0 so write_prom_metrics falls back
  # to the newest complete dump.
  size=0
  rm -f -- "$TMP"
fi

end_ts="$(date +%s)"
duration=$(( end_ts - START_TS ))
if [ "$rc" -eq 0 ]; then
  write_prom_metrics nextcloud_backup 1 "$duration" "$size" "$PROM_FILE" "$ARTIFACT_GLOB"
else
  write_prom_metrics nextcloud_backup 0 "$duration" "$size" "$PROM_FILE" "$ARTIFACT_GLOB"
fi

exit "$rc"
{% endraw %}
