#!/usr/bin/env bash
# {{ ansible_managed }}
# Nightly Nextcloud PostgreSQL logical backup + node_exporter textfile metrics.
# Invoked by nextcloud-backup.service (nextcloud-backup.timer).
#
# NOT `set -e`: the dump's exit code must be captured and the metric written
# regardless, so the failed/stale alerts can fire. The prior success timestamp
# is preserved on failure so staleness measures time-since-success.
set -uo pipefail

COMPOSE_DIR="{{ nextcloud_compose_dir }}"
BACKUP_DIR="{{ nextcloud_backup_dir }}"
KEEP_DAYS="{{ nextcloud_backup_keep_days }}"
DB_NAME="{{ nextcloud_db_name }}"
DB_USER="{{ nextcloud_db_user }}"
PROM_DIR="{{ nextcloud_backup_metrics_dir }}"
# 1 when the backup lands on the NFS export (nextcloud_backup_nfs_enabled).
NFS_ENABLED="{{ '1' if (nextcloud_backup_nfs_enabled | default(false)) else '0' }}"

# Hard gate (no set -e here): without the lib, write_prom_metrics is undefined
# and the run would proceed metric-less — refuse instead.
# shellcheck source=/dev/null
if ! source {{ nextcloud_backup_lib_path }}; then
  echo "nextcloud-backup: missing backup metrics library {{ nextcloud_backup_lib_path }}" >&2
  exit 1
fi
{% raw %}
PROM_FILE="${PROM_DIR}/nextcloud_backup.prom"
START_TS="$(date +%s)"
# Passed to write_prom_metrics so a run that produced nothing still reports the
# newest EXISTING dump's size: 0 means "no artefact at all" (a landing-path
# fault), not "tonight's dump failed" — that is the success metric's job. It
# matches the FINAL dump name only, so the in-progress .partial below can never
# be sized as a healthy artefact.
ARTIFACT_GLOB="${BACKUP_DIR}/nextcloud-db-*.sql.gz"

mkdir -p "$PROM_DIR"

# Fail closed on an unmounted landing zone: when NFS-backed, BACKUP_DIR is the
# mountpoint, and a missing mount would land the dump on the local mountpoint
# dir — silently un-offsited.
if [ "$NFS_ENABLED" = "1" ] && ! mountpoint -q "$BACKUP_DIR"; then
  echo "nextcloud-backup: BACKUP_DIR ${BACKUP_DIR} is NFS-backed but not mounted — aborting" >&2
  # No ARTIFACT_GLOB here (matching the gitlab wrapper): the glob points INSIDE
  # the unmounted mountpoint, so it would size a shadow directory on the root
  # disk — exactly the un-offsited state this guard refuses to trust — and a
  # healthy-looking size would suppress BackupArtifactEmpty. Size 0 is the truth
  # for a landing zone nothing can reach.
  write_prom_metrics nextcloud_backup 0 0 0 "$PROM_FILE"
  exit 1
fi
mkdir -p "$BACKUP_DIR"
cd "$COMPOSE_DIR" || exit 1

OUT="${BACKUP_DIR}/nextcloud-db-$(date +%Y%m%d-%H%M%S).sql.gz"
# The dump streams into .partial and is renamed into OUT only once the pipeline
# AND the size check passed: the FINAL name is what the NAS artefact collector
# and the offsite file walk key on, so it must only ever appear complete.
# `.partial` is excluded by both (and by ARTIFACT_GLOB above); the rename is
# atomic within the same directory.
TMP="${OUT}.partial"
# Best-effort cleanup on an interrupted run (a SIGKILL cannot fire it — the
# stale-partial sweep after retention covers that).
trap 'rm -f -- "$TMP"' EXIT

# pg_dump inside the db container -> gzip on the host. --clean --if-exists makes
# the dump idempotently restorable over an existing schema. BOTH stages' exit
# codes are captured: a gzip / disk-full failure can still leave a non-empty
# partial, so promoting on `[ -s ]` alone would ship a truncated dump.
docker compose exec -T nextcloud-db \
  pg_dump -U "$DB_USER" -d "$DB_NAME" --clean --if-exists 2>/dev/null | gzip -c > "$TMP"
pipe_status=("${PIPESTATUS[@]}")

# A plausibility floor, not just `[ -s ]`: a gzip header alone is ~20 bytes, so
# an empty/truncated stream can be non-empty and still be no backup at all. The
# size is taken from the .partial, BEFORE promotion, so only a validated dump
# ever reaches the final name.
rc=1
size=0
if [ "${pipe_status[0]}" -eq 0 ] && [ "${pipe_status[1]}" -eq 0 ] && [ -f "$TMP" ]; then
  size="$(stat -c %s "$TMP" 2>/dev/null || echo 0)"
  if [ "$size" -ge 1000 ] && mv -f -- "$TMP" "$OUT"; then
    rc=0
    # Prune old dumps only after a successful new one.
    find "$BACKUP_DIR" -maxdepth 1 -name 'nextcloud-db-*.sql.gz' -mtime "+${KEEP_DAYS}" -delete 2>/dev/null || true
    # Retention matches the FINAL name only, so a SIGKILLed run's .partial would
    # otherwise sit in the landing zone forever.
    find "$BACKUP_DIR" -maxdepth 1 -name 'nextcloud-db-*.sql.gz.partial' -mtime +1 -delete 2>/dev/null || true
  fi
fi

if [ "$rc" -ne 0 ]; then
  # Only the .partial can exist here (the rename is the last step that can
  # fail), and its size is not a backup — report 0 so write_prom_metrics falls
  # back to the newest COMPLETE dump instead.
  size=0
  rm -f -- "$TMP"
fi

end_ts="$(date +%s)"
duration=$(( end_ts - START_TS ))
if [ "$rc" -eq 0 ]; then
  write_prom_metrics nextcloud_backup 1 "$duration" "$size" "$PROM_FILE" "$ARTIFACT_GLOB"
else
  write_prom_metrics nextcloud_backup 0 "$duration" "$size" "$PROM_FILE" "$ARTIFACT_GLOB"
fi

exit "$rc"
{% endraw %}
