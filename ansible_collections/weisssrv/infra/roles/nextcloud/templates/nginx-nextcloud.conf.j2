# {{ ansible_managed }}
# Host nginx: terminates 443 with the distributed wildcard cert and proxies to
# the loopback-bound Nextcloud web container. Nextcloud's own rewrite/security
# rules live in the container's apache; this front end only adds TLS, large
# bodies, websockets and forwarded headers.

map $http_upgrade $nextcloud_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ nextcloud_nginx_server_names }};

    ssl_certificate     {{ nextcloud_nginx_ssl_certificate }};
    ssl_certificate_key {{ nextcloud_nginx_ssl_certificate_key }};
    ssl_protocols TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Real client IP: only the listed proxy sources are trusted, so their
    # X-Forwarded-For is walked back to the true client while a directly
    # connected client's forged header is ignored and $remote_addr stands.
{% for addr in nextcloud_nginx_real_ip_trusted_addresses %}
    set_real_ip_from {{ addr }};
{% endfor %}
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Unlimited upload size (Nextcloud enforces its own quota); request
    # buffering off so large chunked uploads stream straight through.
    client_max_body_size 0;
    client_body_timeout 300s;
    proxy_request_buffering off;
    proxy_buffering off;

    # DAV discovery is answered here with RELATIVE redirects: the container
    # apache builds an absolute http:// Location from its side of the proxy, and
    # clients drop the Authorization header across that scheme change, failing
    # principal discovery.
    location = /.well-known/carddav { return 301 /remote.php/dav/; }
    location = /.well-known/caldav  { return 301 /remote.php/dav/; }

    location / {
        proxy_pass http://{{ nextcloud_http_bind_address }}:{{ nextcloud_http_bind_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # REPLACE (not append) X-Forwarded-For with the resolved client, so the
        # container reads one authoritative value and a spoofed upstream header
        # can never be walked back past this hop.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $nextcloud_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_max_temp_file_size 0;
    }
}
