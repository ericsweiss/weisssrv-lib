# {{ ansible_managed }}
# Secret values interpolated into docker-compose.yml (${NEXTCLOUD_*}), mode 0600.
#
# Double-quoted with backslash, double-quote and dollar escaped so the compose-go
# dotenv parser treats them literally: an unquoted value is `$`-interpolated (a
# password containing `$name` would be silently rewritten) and single quotes
# cannot hold an embedded `'`.
NEXTCLOUD_POSTGRES_PASSWORD="{{ nextcloud_db_password | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') }}"
NEXTCLOUD_ADMIN_PASSWORD="{{ nextcloud_admin_password | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') }}"
NEXTCLOUD_SERVERINFO_TOKEN="{{ nextcloud_serverinfo_token | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') }}"
