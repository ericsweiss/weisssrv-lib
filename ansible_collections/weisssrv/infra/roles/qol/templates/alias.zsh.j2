# {{ ansible_managed }}
# Overwritten on every deploy — put personal aliases in ~/.local.zsh.
export EDITOR="nvim"

# editing config
alias ez="$EDITOR ~/.zshrc"
alias ea="$EDITOR ~/.alias.zsh"
alias el="$EDITOR ~/.local.zsh"
alias sz='exec zsh'

# bookmarks
alias @tmp='cd ~/tmp'
alias @downloads='cd ~/Downloads'
alias @src='cd ~/src'
alias @repo='cd ~/src/repo'

# directory related
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# applications
alias v='nvim'
alias vim='nvim'

alias kn='kubectl config set-context --current --namespace'
