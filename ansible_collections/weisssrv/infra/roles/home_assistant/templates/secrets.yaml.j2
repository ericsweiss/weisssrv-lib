# Rendered by the weisssrv.infra.home_assistant role — edits made on HAOS are
# overwritten by the next deploy.

# to_json double-quotes each value, so a secret containing ":", "[" or leading
# whitespace stays valid YAML.
oidc_client_id: {{ home_assistant_oidc_client_id | to_json }}
oidc_client_secret: {{ home_assistant_oidc_client_secret | to_json }}
