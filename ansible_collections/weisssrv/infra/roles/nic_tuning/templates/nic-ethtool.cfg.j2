# {{ ansible_managed }}
# Per-interface ethtool overrides for {{ item.interface }}, applied at ifup.

# The iface header is required: ifupdown2 rejects a bare post-up line and
# leaves the whole drop-in inert. Failures log under tag nic-tuning-ifup.
iface {{ item.interface }} inet manual
{% for opt in item.options | default([]) %}
    post-up /sbin/ethtool -K {{ item.interface }} {{ opt.feature }} {{ opt.value }} || logger -t nic-tuning-ifup "FAILED ethtool -K {{ item.interface }} {{ opt.feature }}={{ opt.value }}"
{% endfor %}
