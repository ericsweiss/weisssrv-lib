// {{ ansible_managed }}

loki.source.journal "system" {
  // Forward straight to loki.write with the rules by reference: __journal_*
  // metadata exists only in the source's own relabel pass, so routing entries
  // through loki.relabel as well re-applies them and empties every target_label.
  forward_to    = [loki.write.default.receiver]
  relabel_rules = loki.relabel.journal.rules
  // Loki only accepts out-of-order writes within max_chunk_age/2 of a stream's
  // newest entry; a re-read from further back is pushed and then rejected
  // `too_far_behind`. Keep this inside that window.
  max_age = {{ alloy_host_journal_max_age | to_json }}
  labels = {
    job  = "journal",
    host = "{{ inventory_hostname }}",
  }
}

// Rules holder only; nothing pushes in, hence forward_to = []. Every rule here
// becomes a Loki stream label, so adding one is a cardinality decision: re-check
// max_global_streams_per_user and the ingester memory limit first.
loki.relabel "journal" {
  forward_to = []

  // loki.source.journal stamps its component id over the labels-block job;
  // relabel is the only pass that runs after it.
  rule {
    target_label = "job"
    replacement  = "journal"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
}

loki.write "default" {
  endpoint {
    url = {{ alloy_host_loki_url | to_json }}
{% if alloy_host_loki_user | length > 0 %}
    basic_auth {
      username = {{ alloy_host_loki_user | to_json }}
      password = {{ alloy_host_loki_password | to_json }}
    }
{% endif %}
  }
{% if alloy_host_wal_enabled %}

  // Buffers journald to disk during a Loki/ingress outage and replays on
  // recovery. Written under Alloy's --storage.path (packaged default
  // /var/lib/alloy/data — this role does not override it in CUSTOM_ARGS).
  wal {
    enabled         = true
    max_segment_age = {{ alloy_host_wal_max_segment_age | to_json }}
  }
{% endif %}
}
