# {{ ansible_managed }}

smtpd_banner = $myhostname ESMTP $mail_name (Debian/GNU)
biff = no

# Append .domain is the MUA's job
append_dot_mydomain = no

alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
recipient_delimiter = +

compatibility_level = 3.6

{# Every key of the merged map is rendered, so a site can set any postfix
   parameter through smtp_relay_config. #}
{% for key, value in smtp_relay_effective_config | dictsort %}
{{ key }} = {{ value }}
{% endfor %}
