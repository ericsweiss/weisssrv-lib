# {{ ansible_managed }}
# Fail2ban jail configuration. Manual changes are overwritten on the next run;
# customise via the base_fail2ban_* variables.

[DEFAULT]
# Networks that are never banned
ignoreip = {{ base_fail2ban_ignoreip | join(' ') }}

# Default ban settings
bantime = {{ base_fail2ban_default_bantime }}
findtime = {{ base_fail2ban_default_findtime }}
maxretry = {{ base_fail2ban_default_maxretry }}

# Use systemd backend (preferred on Debian with journald)
backend = systemd

{% if base_is_container | default(false) %}
# LXC container mode: route-based banning (ip route add blackhole) because
# unprivileged containers lack CAP_NET_ADMIN for iptables/nftables.
# Trade-offs are documented in the base role's tasks/fail2ban.yml header.
banaction = route
{% else %}
# Physical/VM Mode: Use iptables for full packet filtering
# iptables-multiport allows per-port banning with full netfilter capabilities.
# nftables is preferred on modern systems but iptables provides broader
# compatibility and works well with the Proxmox firewall stack.
banaction = iptables-multiport
banaction_allports = iptables-allports
{% endif %}

{% if base_fail2ban_email_enabled %}
# Email notifications
destemail = {{ base_fail2ban_email_dest }}
sender = {{ base_fail2ban_email_sender }}
mta = sendmail
action = {{ base_fail2ban_email_action }}
{% else %}
# Email notifications disabled
action = %(action_)s
{% endif %}

# SSH Protection
# Protects against brute-force attacks on SSH (port {{ base_fail2ban_sshd_port }})

[sshd]
enabled = {{ base_fail2ban_sshd_enabled | lower }}
port = {{ base_fail2ban_sshd_port }}
filter = sshd
maxretry = {{ base_fail2ban_sshd_maxretry }}
bantime = {{ base_fail2ban_sshd_bantime }}
findtime = {{ base_fail2ban_sshd_findtime }}
# sshd logs to journal on systemd systems
backend = systemd
# Match aggressive mode for SSH attacks (catches more patterns)
mode = aggressive

{% if base_fail2ban_pveproxy_enabled %}
# Proxmox Web UI (pveproxy) Protection
# Protects against brute-force attacks on Proxmox web interface
# Proxmox 9.x uses journald - daemon.log doesn't exist

[proxmox]
enabled = true
port = {{ base_fail2ban_pveproxy_port }}
filter = proxmox
# Use systemd journal instead of log file (Proxmox 9.x uses journald).
# Authentication failures are logged by pvedaemon (pveproxy only proxies
# the request), so match both units.
backend = systemd
journalmatch = _SYSTEMD_UNIT=pvedaemon.service + _SYSTEMD_UNIT=pveproxy.service
maxretry = {{ base_fail2ban_pveproxy_maxretry }}
bantime = {{ base_fail2ban_pveproxy_bantime }}
findtime = {{ base_fail2ban_pveproxy_findtime }}
{% endif %}

{% if base_fail2ban_recidive_enabled and not (base_is_container | default(false)) %}
# Off on LXC containers because:
#   - The 'route' banaction doesn't support banaction_allports
#   - Duplicate route entries error when multiple jails ban the same IP
#   - The sshd jail's own 1h bantime is sufficient protection there

[recidive]
enabled = true
filter = recidive
logpath = /var/log/fail2ban.log
bantime = {{ base_fail2ban_recidive_bantime }}
findtime = {{ base_fail2ban_recidive_findtime }}
maxretry = {{ base_fail2ban_recidive_maxretry }}
backend = auto
# Ban on all ports for repeat offenders
banaction = iptables-allports
{% endif %}
