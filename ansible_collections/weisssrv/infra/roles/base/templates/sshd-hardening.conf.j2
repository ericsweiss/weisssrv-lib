# {{ ansible_managed }}
# SSH hardening drop-in. The 00- sort prefix wins sshd's first-match-wins
# precedence over a cloud-init drop-in that would set PasswordAuthentication.
Port {{ base_ssh_port }}
PermitRootLogin {{ base_ssh_permit_root_login_effective }}
PasswordAuthentication {{ base_ssh_password_authentication | ternary('yes', 'no') }}
PubkeyAuthentication {{ base_ssh_pubkey_authentication | ternary('yes', 'no') }}
# KbdInteractiveAuthentication replaces the deprecated
# ChallengeResponseAuthentication alias on OpenSSH 9.x (Debian trixie).
KbdInteractiveAuthentication no
UsePAM yes
X11Forwarding no
MaxAuthTries 3
ClientAliveInterval 300
ClientAliveCountMax 2
