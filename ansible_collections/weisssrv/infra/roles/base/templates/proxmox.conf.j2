# {{ ansible_managed }}
# Fail2ban filter for Proxmox VE authentication failures — web UI, API, and
# console/spice/vnc. Proxmox 9.x has no daemon.log, so the jail pairs this with
# backend=systemd + a journalmatch for pveproxy.

[Definition]

# PAM auth-failure lines from pveproxy/pvedaemon, read from the journal.
failregex = ^.*authentication failure;.*rhost=<HOST>.*$

ignoreregex =

datepattern = {^LN-BEG}
