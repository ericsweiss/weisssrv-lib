# {{ ansible_managed }}
# Fail2ban filter for Proxmox VE auth failures (web UI, API, console). Proxmox
# 9.x has no daemon.log, so the jail pairs this with backend=systemd.

[Definition]

# PAM auth-failure lines from pveproxy/pvedaemon, read from the journal.
failregex = ^.*authentication failure;.*rhost=<HOST>.*$

ignoreregex =

datepattern = {^LN-BEG}
