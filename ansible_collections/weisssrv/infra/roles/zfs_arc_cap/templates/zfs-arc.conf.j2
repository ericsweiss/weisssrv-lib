{# Byte-stable: any edit notifies `Rebuild initramfs for zfs arc cap` on every
   consumer host. Narrative belongs in README.md. #}
# {{ ansible_managed }}
# Managed by the zfs_arc_cap Ansible role.

# CRITICAL: zfs_arc_max is a LOAD-TIME module parameter, read when the zfs
# module loads during the initramfs. The role rebuilds the initramfs on every
# change to this file and also writes the running value to
# /sys/module/zfs/parameters/zfs_arc_max so the cap applies without a reboot.
options zfs zfs_arc_max={{ zfs_arc_cap_max_bytes }}
