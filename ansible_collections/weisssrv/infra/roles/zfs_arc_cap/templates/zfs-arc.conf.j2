{# Deployed content (/etc/modprobe.d/zfs.conf — the filename is shared with
   nas_storage on purpose, see the role README), and the writing task notifies
   `Rebuild initramfs for zfs arc cap`. A comment reword here costs every
   existing consumer an initramfs rebuild per host on its next converge, so
   keep this byte-stable and put narrative in README.md. #}
# {{ ansible_managed }}
# Managed by the zfs_arc_cap Ansible role.
#
# zfs_arc_max caps the ZFS ARC in bytes. It is a LOAD-TIME module parameter, so
# it only takes effect at the value present when the zfs module loads — which is
# during the initramfs, where the pools import at early boot.
# The role therefore rebuilds the initramfs whenever this file changes, and also
# writes the running value to /sys/module/zfs/parameters/zfs_arc_max so a changed
# cap applies live without a reboot. Value comes from zfs_arc_cap_max_bytes.
options zfs zfs_arc_max={{ zfs_arc_cap_max_bytes }}
