# {{ ansible_managed }}
[Unit]
Description=Unbound Exporter for Prometheus
After=network.target unbound.service

[Service]
Type=simple
{% set _bind = unbound_exporter_listen_address | default('', true) | trim %}{% set _listen = ('[' ~ _bind ~ ']') if ':' in _bind else _bind %}{#- an IPv6 literal must be bracketed or Go rejects addr:port -#}
ExecStart=/usr/bin/unbound_exporter --unbound.host unix:///run/unbound.ctl --unbound.ca "" --unbound.cert "" --unbound.key "" --web.listen-address={{ _listen }}:{{ unbound_exporter_port }}
Restart=always
RestartSec=5
# Unprivileged + sandboxed: only needs read access to the unbound control
# socket (group membership) and a listening TCP port.
DynamicUser=yes
SupplementaryGroups=unbound
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
