# {{ ansible_managed }}

{% for nameserver in resolv_conf_nameservers %}
nameserver {{ nameserver }}
{% endfor %}

{# `domain` and `search` both drive search-suffix expansion (`search` wins when
   both are present), so both hang off resolv_conf_search_domains: opting out
   with [] has to leave neither line behind. #}
{% if resolv_conf_search_domains %}
domain {{ resolv_conf_search_domains[0] }}
search {{ resolv_conf_search_domains | join(' ') }}
{% endif %}

# DNS options (one line — musl honors only the first `options` line, so a split
# form would silently drop attempts:2 on musl consumers; glibc accepts both)
options timeout:2 attempts:2
