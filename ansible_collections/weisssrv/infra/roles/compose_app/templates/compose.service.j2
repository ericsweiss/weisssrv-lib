# {{ ansible_managed }}
[Unit]
Description={{ compose_app_description }}
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
{% if compose_app_requires_mounts_for | length > 0 %}
# Never start the stack before its data volumes are mounted, or compose writes into the root filesystem.
RequiresMountsFor={{ compose_app_requires_mounts_for | join(' ') }}
{% endif %}

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ compose_app_working_directory }}
# `up -d` recreates only the containers whose definition changed.
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecReload=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
