# {{ ansible_managed }}
# Molecule fixture for the shared host-nginx flow (compose_app/tasks/nginx.yml).
# Proves the flow deploys and enables a site and removes the default vhost.
server {
    listen 80;
    server_name testapp.local;
    ssl_certificate {{ compose_app_nginx_ssl_cert }};
    ssl_certificate_key {{ compose_app_nginx_ssl_key }};
}
