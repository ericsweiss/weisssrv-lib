# {{ ansible_managed }}
[Unit]
Description=AdGuard Home: Network-level blocker
ConditionFileIsExecutable={{ adguard_home_install_path }}/AdGuardHome
# Order after the upstream resolver's unit so AdGuard doesn't SERVFAIL during
# boot. Wants= tolerates hosts without those units.
After={{ (['network-online.target'] + (adguard_home_after_units | default([]))) | join(' ') }}
Wants={{ (['network-online.target'] + (adguard_home_wants_units | default([]))) | join(' ') }}

# systemd honors the start-rate limit only in [Unit]; in [Service] it is
# ignored (logged as a warning). With RestartSec=10 below, allow up to 5
# restarts in a 5-minute window before systemd gives up (crash-loop guard).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User={{ adguard_home_user }}
Group={{ adguard_home_group }}
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

ExecStart={{ adguard_home_install_path }}/AdGuardHome "-s" "run"

NoNewPrivileges=true
{% if adguard_home_use_private_tmp | default(true) %}
PrivateTmp=true
{% else %}
PrivateTmp=false
{% endif %}
ProtectHome=true
{% if adguard_home_use_protect_system | default(true) %}
ProtectSystem=strict
{% else %}
ProtectSystem=false
{% endif %}
ReadWritePaths={{ adguard_home_install_path }}

WorkingDirectory={{ adguard_home_install_path }}

StandardOutput=journal
StandardError=journal

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
