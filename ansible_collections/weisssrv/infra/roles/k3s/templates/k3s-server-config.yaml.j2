{# Byte-stable: any edit notifies `Restart k3s`, a rolling control-plane bounce
   on every consumer node. Gate new content OFF by default. Narrative: README.md. #}
# {{ ansible_managed }}
# K3s server configuration

cluster-cidr: "{{ k3s_cluster_cidr }}"
service-cidr: "{{ k3s_service_cidr }}"
# The apiserver listens on every interface, including any management or VPN
# one. Restricting 6443 to the node and admin ranges is the site firewall's job
# (see the weisssrv.infra.k3s README, "Firewall expectations").
bind-address: "0.0.0.0"

{% if k3s_disable | length > 0 %}
disable:
{% for component in k3s_disable %}
  - {{ component }}
{% endfor %}
{% endif %}

tls-san:
  - "{{ k3s_api_vip }}"
{% for san in k3s_tls_sans | default([]) %}
  - "{{ san }}"
{% endfor %}
  - "{{ inventory_hostname }}"
  - "{{ ansible_host }}"

# Labels and taints applied at registration, so a control-plane taint holds
# from the moment the server joins. server.yml re-asserts them via kubectl.
{% if k3s_labels | length > 0 %}
node-label:
{% for key, value in k3s_labels.items() %}
  - "{{ key }}={{ value }}"
{% endfor %}
{% endif %}

{% if k3s_taints | length > 0 %}
node-taint:
{% for taint in k3s_taints %}
  - "{{ taint.key }}={{ taint.value }}:{{ taint.effect }}"
{% endfor %}
{% endif %}

# CNI backend. wireguard-native encrypts every cross-node pod packet
# (UDP/51820); set to vxlan to roll back. See README.
flannel-backend: "{{ k3s_flannel_backend }}"

{# k3s_join_existing is set by server.yml when a wiped/rebuilt first server   #}
{# finds the API VIP already serving a cluster: it must REJOIN the surviving #}
{# quorum, not bootstrap a new one.                                          #}
{% if (k3s_is_first_server | default(false)) and not (k3s_join_existing | default(false)) %}
# Enable embedded etcd for HA (first server initializes the cluster)
cluster-init: true
{% else %}
# Join existing cluster via VIP
server: "https://{{ k3s_api_vip }}:{{ k3s_api_port }}"
{% endif %}

write-kubeconfig-mode: "0600"

# Lower-privilege token for agent joins, so an agent cannot register a server
# node. Falls back to the server token when unset. See README.
agent-token: "{{ k3s_agent_token }}"

# Encrypt secrets at rest in etcd
# For existing clusters: after enabling, run on a server node:
#   k3s secrets-encrypt reencrypt
secrets-encryption: true

# etcd metrics on :2381 are unauthenticated HTTP on every interface, for a
# kubeEtcd scrape target. Scope :2381 at the site firewall (README). Without
# this the kube-etcd targets stay down and etcdMembersDown/TargetDown fire.
etcd-expose-metrics: true

{% if k3s_kubelet_args | default([]) | length > 0 %}
kubelet-arg:
{% for arg in k3s_kubelet_args %}
  - "{{ arg }}"
{% endfor %}
{% endif %}
{% if k3s_audit_enabled | default(false) | bool %}

# kube-apiserver audit log, rotated by the apiserver on this node's local disk.
# tasks/audit.yml writes the policy file before this config. See README.
kube-apiserver-arg:
  - "audit-log-path={{ k3s_audit_log_path }}"
  - "audit-policy-file={{ k3s_audit_policy_path }}"
  - "audit-log-maxage={{ k3s_audit_maxage }}"
  - "audit-log-maxbackup={{ k3s_audit_maxbackup }}"
  - "audit-log-maxsize={{ k3s_audit_maxsize }}"
{% endif %}
