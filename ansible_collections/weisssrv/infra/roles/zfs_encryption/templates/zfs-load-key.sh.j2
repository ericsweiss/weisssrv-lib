#!/bin/bash
# {{ ansible_managed }}
#
# zfs-load-key.sh <pool> [<item-locator> [field]]
#
{% if zfs_encryption_key_command %}
# Fetches a ZFS pool encryption passphrase from the operator's key command
# (zfs_encryption_key_command) and loads it via `zfs load-key`. Invoked by
# zfs-load-key@<pool>.service. Mounting is left to zfs-mount-encrypted.service
# (role README, "Boot ordering").
#
{% else %}
# Fetches a ZFS pool encryption passphrase from 1Password Connect and loads it
# via `zfs load-key`. Invoked by zfs-load-key@<pool>.service. Mounting is left
# to zfs-mount-encrypted.service (role README, "Boot ordering").
#
# The bearer token at {{ zfs_encryption_token_path }} (0400 root) goes to curl on
# stdin (`-H @-`), never on argv, so it never appears in /proc/<pid>/cmdline.
#
{% endif %}
# The exit codes below are a contract: zfs-load-key@.service lists 1/3/4/7 in
# RestartPreventExitStatus, so renumbering here changes retry behaviour.
#
# Exit codes:
#   0 — key loaded (or already loaded); zfs-mount-encrypted.service handles mounting
#   1 — config / arg / token error
{% if zfs_encryption_key_command %}
#   2 — key command exited non-zero (treated as transient; the unit retries)
#   3 — key command printed nothing (config error; the unit stops)
{% else %}
#   2 — Connect unreachable beyond fetch_timeout
#   3 — vault/item/field not found
{% endif %}
#   4 — `zfs load-key` failed (wrong passphrase, kernel error, etc.)
#   5 — pool not imported after waiting fetch_timeout, does not exist, or its
#       encryption roots could not be enumerated (transient ioctl error — not
#       in RestartPreventExitStatus, so the unit retries)
{% if not zfs_encryption_key_command %}
#   7 — Connect returned 401/403 (auth failure; no point retrying)
{% endif %}

set -euo pipefail

POOL="${1:?pool name required}"
ITEM_TITLE="${ZFS_ENCRYPTION_ITEM:-${2:-}}"
FIELD="${ZFS_ENCRYPTION_FIELD:-${3:-passphrase}}"

[[ -n "$ITEM_TITLE" ]] || { echo "ZFS_ENCRYPTION_ITEM unset; pass title as 2nd arg or via env" >&2; exit 1; }

{% if not zfs_encryption_key_command %}
CONNECT_URL="{{ zfs_encryption_connect_url }}"
# `VAULT_REF` is either a vault NAME (e.g. "Homelab") that we resolve to a
# UUID at runtime, or a literal 26-char UUID we use directly. The Connect
# REST API requires UUID in /v1/vaults/<X>/items paths — the `op` CLI does
# client-side name→UUID resolution; we replicate that here.
VAULT_REF="{{ zfs_encryption_connect_vault }}"
TOKEN_FILE="{{ zfs_encryption_token_path }}"
{% endif %}
FETCH_TIMEOUT="{{ zfs_encryption_fetch_timeout_seconds }}"
RETRY_SLEEP="{{ zfs_encryption_fetch_retry_seconds }}"

log() { logger -t "zfs-load-key[${POOL}]" -s -- "$*"; }

{% if not zfs_encryption_key_command %}
# Connect response bodies land in a /dev/shm temp file, and the item fetch's
# body carries the passphrase. Track the current file and clear it from a single
# EXIT trap so an errexit abort or a signal cannot leave plaintext in tmpfs.
tmp=""
cleanup_tmp() { [[ -n "$tmp" ]] && rm -f "$tmp"; tmp=""; }
trap cleanup_tmp EXIT INT TERM

[[ -r "$TOKEN_FILE" ]] || { log "missing $TOKEN_FILE"; exit 1; }
TOKEN=$(< "$TOKEN_FILE")
AUTH_HEADER="Authorization: Bearer $TOKEN"

# connect_get <relative-path> <out-file>: GET against Connect with the
# bearer token piped on stdin (never argv, so it doesn't appear in
# /proc/<pid>/cmdline during the curl invocation). Writes the body to
# $2, prints the HTTP code on stdout. Network failures yield code 000.
connect_get() {
    local path="$1" out="$2" code
    # curl's -w already prints '000' on a transport failure; capture its rc
    # via `|| code=000` instead of appending a second '000' to that output.
    code=$(printf '%s\n' "$AUTH_HEADER" \
        | curl -sS \
            --max-time 10 \
            -H @- \
            -o "$out" \
            -w '%{http_code}' \
            "${CONNECT_URL}${path}") || code=000
    printf '%s' "$code"
}
{% endif %}

# zfs-import.target normally imports the pool before this unit runs, but a late
# import must be WAITED for, not fast-failed: an instant exit 5 cycles at
# ~RestartSec and burns StartLimitBurst in ~30 min, parking the unit failed
# before the import ever lands. Waiting keeps every ExecStart on the slow path
# the unit's retry budget assumes.
deadline=$(( $(date +%s) + FETCH_TIMEOUT ))
until zpool list -H -o name "$POOL" >/dev/null 2>&1; do
    if [[ $(date +%s) -ge $deadline ]]; then
        log "pool $POOL not imported after ${FETCH_TIMEOUT}s — check zfs_encryption_pools naming and zfs-import.target ordering"
        exit 5
    fi
    sleep_base=$(( RETRY_SLEEP > 1 ? RETRY_SLEEP : 1 ))
    jitter=$(( RANDOM % sleep_base ))
    sleep "$(( sleep_base + jitter ))"
done

# Already loaded? Skip silently — makes the unit safe to re-run.
# A transient `zfs get` blip (e.g. ioctl race during early boot) should
# fall through to the fetch path, not abort under set -euo pipefail.
key_status=$(zfs get -H -o value keystatus "$POOL" 2>/dev/null || echo unknown)
if [[ "$key_status" == "available" ]]; then
    log "key already loaded; nothing to do"
    exit 0
fi

{% if zfs_encryption_key_command %}
# Operator-supplied key command (zfs_encryption_key_command). It prints the
# passphrase on stdout; item/field are passed through as opaque locators for
# whatever backend it talks to. Retry/timeout are the command's own business —
# a non-zero exit is reported as transient (rc 2) so the unit keeps retrying.
export ZFS_ENCRYPTION_POOL="$POOL"
export ZFS_ENCRYPTION_ITEM="$ITEM_TITLE"
export ZFS_ENCRYPTION_FIELD="$FIELD"

if ! PASSPHRASE=$({{ zfs_encryption_key_command }}); then
    log "key command failed for pool $POOL; will retry"
    exit 2
fi

if [[ -z "$PASSPHRASE" ]]; then
    log "key command printed nothing for pool $POOL (item '$ITEM_TITLE', field '$FIELD')"
    exit 3
fi
{% else %}
# Resolve VAULT_REF to a UUID. 1Password Connect REST paths require UUID
# in the {vaultUUID} slot — only the GET /v1/vaults?filter=name eq
# endpoint accepts a name. If VAULT_REF is already a 26-char lowercase
# alphanumeric (the 1P UUID shape), skip the lookup; otherwise resolve.
if [[ "$VAULT_REF" =~ ^[a-z0-9]{26}$ ]]; then
    VAULT="$VAULT_REF"
else
    encoded_vault=$(jq -rn --arg v "$VAULT_REF" '$v | @uri')
    VAULT_PATH="/v1/vaults?filter=name%20eq%20%22${encoded_vault}%22"

    deadline=$(( $(date +%s) + FETCH_TIMEOUT ))
    VAULT=""
    while [[ -z "$VAULT" ]]; do
        if [[ $(date +%s) -ge $deadline ]]; then
            log "timed out resolving vault UUID for '$VAULT_REF' against $CONNECT_URL"
            exit 2
        fi

        tmp=$(mktemp -p /dev/shm)
        http=$(connect_get "$VAULT_PATH" "$tmp")
        body=$(cat "$tmp")
        cleanup_tmp

        case "$http" in
            200)
                VAULT=$(printf '%s' "$body" | jq -r '.[0].id // empty')
                if [[ -z "$VAULT" ]]; then
                    log "Connect returned 200 but no vault named '$VAULT_REF' visible to this token"
                    exit 3
                fi
                ;;
            401|403)
                log "Connect rejected token resolving vault (HTTP $http); refusing to retry"
                exit 7
                ;;
            *)
                log "Connect HTTP $http resolving vault; will retry"
                ;;
        esac

        if [[ -z "$VAULT" ]]; then
            sleep_base=$(( RETRY_SLEEP > 1 ? RETRY_SLEEP : 1 ))
            jitter=$(( RANDOM % sleep_base ))
            sleep "$(( sleep_base + jitter ))"
        fi
    done
    unset body
fi

# Resolve 1P item ID from title (Connect requires ID for the field
# fetch endpoint). Use jq for url-encoding (already required).
encoded=$(jq -rn --arg t "$ITEM_TITLE" '$t | @uri')
LIST_PATH="/v1/vaults/${VAULT}/items?filter=title%20eq%20%22${encoded}%22"

deadline=$(( $(date +%s) + FETCH_TIMEOUT ))
ITEM_ID=""
while [[ -z "$ITEM_ID" ]]; do
    if [[ $(date +%s) -ge $deadline ]]; then
        log "timed out resolving item id for '$ITEM_TITLE' against $CONNECT_URL"
        exit 2
    fi

    tmp=$(mktemp -p /dev/shm)
    http=$(connect_get "$LIST_PATH" "$tmp")
    body=$(cat "$tmp")
    cleanup_tmp

    case "$http" in
        200)
            ITEM_ID=$(printf '%s' "$body" | jq -r '.[0].id // empty')
            # 200 + empty list = the title is not in the vault. Exit 3 rather
            # than looping to exit 2, so a typo doesn't look like an outage.
            if [[ -z "$ITEM_ID" ]]; then
                log "Connect returned 200 but no item titled '$ITEM_TITLE' in vault '$VAULT_REF'"
                exit 3
            fi
            ;;
        401|403)
            log "Connect rejected token (HTTP $http); refusing to retry"
            exit 7
            ;;
        *)
            log "Connect HTTP $http resolving item; will retry"
            ;;
    esac

    if [[ -z "$ITEM_ID" ]]; then
        # Spread retries across hosts so a cold-cluster boot doesn't
        # synchronize traffic against Connect. Floor RETRY_SLEEP at 1
        # so an operator override of 0 doesn't busy-loop with sleep 0.
        sleep_base=$(( RETRY_SLEEP > 1 ? RETRY_SLEEP : 1 ))
        jitter=$(( RANDOM % sleep_base ))
        sleep "$(( sleep_base + jitter ))"
    fi
done

# Fetch the item. Same deadline/retry loop as the lookup above, so a transient
# non-200 (including curl's transport code 000) burns the full FETCH_TIMEOUT
# before exit 2 — fast-failing here would break the unit's retry budget.
deadline=$(( $(date +%s) + FETCH_TIMEOUT ))
body=""
while :; do
    if [[ $(date +%s) -ge $deadline ]]; then
        log "timed out fetching item $ITEM_ID against $CONNECT_URL"
        exit 2
    fi

    tmp=$(mktemp -p /dev/shm)
    http=$(connect_get "/v1/vaults/$VAULT/items/$ITEM_ID" "$tmp")
    body=$(cat "$tmp")
    cleanup_tmp

    case "$http" in
        200)
            break
            ;;
        401|403)
            log "Connect rejected token fetching item $ITEM_ID (HTTP $http)"
            exit 7
            ;;
        *)
            log "Connect HTTP $http fetching item $ITEM_ID; will retry"
            sleep_base=$(( RETRY_SLEEP > 1 ? RETRY_SLEEP : 1 ))
            jitter=$(( RANDOM % sleep_base ))
            sleep "$(( sleep_base + jitter ))"
            ;;
    esac
done

# Match FIELD against .id (stable) or .label (renameable). jq's `first` does the
# truncation internally: a `| head -n1` pipeline would race SIGPIPE under
# `set -o pipefail` and fail before the clean "field missing" branch below.
PASSPHRASE=$(printf '%s' "$body" | jq -r \
    --arg f "$FIELD" \
    'first(.fields[]? | select((.id == $f) or (.label == $f)) | select(.value != null and .value != "") | .value) // empty')

# Scrub the response body now the field is extracted; it holds cleartext.
unset body

if [[ -z "$PASSPHRASE" ]]; then
    # Missing field or empty value — a config error that retrying won't fix.
    log "field '$FIELD' (matching id or label) is missing or empty on item '$ITEM_TITLE'"
    exit 3
fi
{% endif %}

# One encryption root at a time: `zfs load-key -r` reads the passphrase from
# stdin ONCE, so with more than one root it satisfies the first and fails the
# rest with "encryption failure".
#
# Check `zfs get`'s exit status explicitly instead of inferring from awk's
# (empty) output — awk exits 0 on empty input, so a /dev/zfs ioctl race would
# otherwise look like "no encrypted datasets" and exit 0 on a locked pool.
if ! roots_raw="$(zfs get -H -t filesystem,volume -o name,value -r encryptionroot "$POOL")"; then
    log "zfs get encryptionroot failed for $POOL — refusing to report success with the pool possibly locked"
    exit 5
fi
ENC_ROOTS="$(printf '%s\n' "$roots_raw" | awk -F'\t' '$1 == $2 { print $1 }')"
if [ -z "$ENC_ROOTS" ]; then
    log "no encryption roots under $POOL — nothing to unlock"
    exit 0
fi
load_rc=0
n_roots=0
while IFS= read -r root; do
    [ -n "$root" ] || continue
    n_roots=$((n_roots + 1))
    # Guard the keystatus read like the pool-root read above: a transient
    # error must fall through to a load attempt, never be read as "available".
    status="$(zfs get -H -o value keystatus "$root" 2>/dev/null || echo unknown)"
    [ "$status" = "available" ] && continue
    if printf '%s\n' "$PASSPHRASE" | zfs load-key "$root"; then
        log "key loaded for $root"
    else
        log "zfs load-key failed for $root"
        load_rc=4
    fi
done <<< "$ENC_ROOTS"
if [ "$load_rc" -ne 0 ]; then
    exit 4
fi

# Defence in depth: the kernel keeps the raw key (that is how decryption
# works), but nothing needs it in shell scope any more.
unset PASSPHRASE

log "all encryption roots unlocked for $POOL ($n_roots root(s))"
