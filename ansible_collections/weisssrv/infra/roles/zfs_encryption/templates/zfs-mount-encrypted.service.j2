# {{ ansible_managed }}
# Late, retrying mount of the encrypted datasets after zfs-load-key@<pool>. No
# ProtectSystem, PrivateTmp or ProtectHome: they would hide the mounts.

[Unit]
Description=Mount ZFS encrypted datasets after their keys are loaded
Wants=network-online.target
After=zfs-mount.service network-online.target
# Wants= (pull only), deliberately NOT After=: an ordering edge would keep this
# unit queued behind a restarting zfs-load-key@<pool> (Connect down) instead of
# letting its own retry loop mount the pools whose keys ARE loaded.
{% for pool in zfs_encryption_pools %}
Wants=zfs-load-key@{{ pool.name }}.service
{% endfor %}
# No burst limit: the gate exits fast while keys are missing, so any finite
# StartLimitBurst would trip within minutes of a cold-cluster boot.
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
# The until-loop keeps the start job "activating" so After= dependents stay
# QUEUED; a plain oneshot + Restart=on-failure would release them on the first
# failed attempt. Restart=on-failure only backstops the bash wrapper dying.
ExecStart=/bin/bash -c 'until /usr/local/sbin/zfs-mount-encrypted.sh {{ zfs_encryption_pools | map(attribute='name') | join(' ') }}; do sleep 30; done'
TimeoutStartSec=0
Restart=on-failure
RestartSec=30s

# Namespace-safe hardening only (see header note re: mount propagation).
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
