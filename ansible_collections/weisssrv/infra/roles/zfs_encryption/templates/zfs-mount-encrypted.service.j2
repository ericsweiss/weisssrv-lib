# {{ ansible_managed }}
#
# Late, retrying mount of the encrypted datasets once zfs-load-key@<pool> has
# loaded their keys — the single anchor nfsd and the encrypted-storage guests
# order After=. Runs LATE and is never Before= a boot target, so it can delay
# encrypted data but can never hang boot (role README, "Cold-cluster boot").
#
# Deliberately NO ProtectSystem=/PrivateTmp/ProtectHome: those put the service
# in a private mount namespace, so `zfs mount` would mount inside it and the
# host would never see the mounts. Only namespace-safe hardening is kept.

[Unit]
Description=Mount ZFS encrypted datasets after their keys are loaded
Wants=network-online.target
After=zfs-mount.service network-online.target
# Wants= (pull only), deliberately NOT After=: an ordering edge would keep this
# unit queued behind a restarting zfs-load-key@<pool> (Connect down) instead of
# letting its own retry loop mount the pools whose keys ARE loaded.
{% for pool in zfs_encryption_pools %}
Wants=zfs-load-key@{{ pool.name }}.service
{% endfor %}
# No burst limit: the gate exits fast while keys are missing, so any finite
# StartLimitBurst would trip within minutes of a cold-cluster boot.
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
# The until-loop keeps the start job PENDING ("activating", never "failed")
# until the mount succeeds, so After= dependents stay QUEUED. A plain oneshot +
# Restart=on-failure would COMPLETE the start job on the first failed attempt,
# releasing nfs-server / pve-start-encrypted-guests and cascading Requires=
# failures onto the export .mount units, none of which retry.
# TimeoutStartSec=0 lets the loop run as long as an operator hand-unlock takes;
# Restart=on-failure is only a backstop for the bash wrapper itself dying.
ExecStart=/bin/bash -c 'until /usr/local/sbin/zfs-mount-encrypted.sh {{ zfs_encryption_pools | map(attribute='name') | join(' ') }}; do sleep 30; done'
TimeoutStartSec=0
Restart=on-failure
RestartSec=30s

# Namespace-safe hardening only (see header note re: mount propagation).
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
