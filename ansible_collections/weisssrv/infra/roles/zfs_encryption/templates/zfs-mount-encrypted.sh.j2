#!/bin/bash
# {{ ansible_managed }}
#
# zfs-mount-encrypted.sh <pool> [<pool> ...]
#
# Best-effort mount: `zfs mount -a` runs regardless of keystatus (it mounts
# what is unlocked and harmlessly skips the rest, idempotently), so a delayed
# unlock of one pool never blocks an already-unlocked one.
#
# Only the SERVICE going `active` is deferred: any listed pool still locked (or
# not imported, or a zfs ioctl blip) exits non-zero so the unit's
# `until <this script>; do sleep 30; done` loop keeps it `activating` — not
# failed — and its After= dependents stay queued. That is the cold-cluster case
# where Connect comes up after this host.
#
# Exit codes:
#   0 — every listed pool's keys present AND `zfs mount -a` succeeded
#   1 — some listed pool's keys not yet loaded / pool not imported (ready pools
#       were still mounted on this pass); RETRY
#   2 — `zfs mount -a` itself failed; RETRY

set -euo pipefail

log() { logger -t "zfs-mount-encrypted" -s -- "$*"; }

[ "$#" -ge 1 ] || { log "usage: zfs-mount-encrypted.sh <pool> [<pool> ...]"; exit 1; }

pending=0
for pool in "$@"; do
    if ! zpool list -H -o name "$pool" >/dev/null 2>&1; then
        log "pool $pool not imported yet; will retry"
        pending=1
        continue
    fi

    # Capture zfs get's own exit status rather than inferring from (empty)
    # output: a transient ioctl error must trigger a RETRY, never be read as
    # "no encrypted datasets, nothing to wait for". (Same guard as
    # zfs-load-key.sh.)
    if ! roots_raw="$(zfs get -H -t filesystem,volume -o name,value -r encryptionroot "$pool")"; then
        log "zfs get encryptionroot failed for $pool; will retry"
        pending=1
        continue
    fi

    enc_roots="$(printf '%s\n' "$roots_raw" | awk -F'\t' '$1 == $2 { print $1 }')"
    [ -n "$enc_roots" ] || continue   # plaintext pool: nothing to gate on

    while IFS= read -r root; do
        [ -n "$root" ] || continue
        status="$(zfs get -H -o value keystatus "$root" 2>/dev/null || echo unknown)"
        if [ "$status" != "available" ]; then
            log "encryption root $root keystatus=$status; waiting"
            pending=1
        fi
    done <<< "$enc_roots"
done

# Best-effort mount: run `zfs mount -a` NOW, even if some pool is still pending.
# It mounts every dataset whose key IS loaded (the ready pools) and harmlessly
# skips the still-locked ones (verified: exits 0 with locked datasets present,
# e.g. archive/*). So a delayed/failed unlock of one pool does NOT block an
# already-unlocked pool from mounting — only the SERVICE staying `activating`
# (we exit non-zero below) is deferred until every listed pool is ready.
if ! zfs mount -a; then
    log "zfs mount -a failed; will retry"
    exit 2
fi

if [ "$pending" -ne 0 ]; then
    log "mounted the ready pools; some encryption keys not loaded yet, exiting non-zero to retry"
    exit 1
fi

log "all encrypted datasets mounted ($*)"
exit 0
