# {{ ansible_managed }}
# Starts the guest cohort in zfs_encryption_guest_vmids / _ctids after
# zfs-mount-encrypted.service. See the role README, "Guest cohort".

[Unit]
Description=Start Proxmox guests on encrypted ZFS storage after unlock
Wants=zfs-mount-encrypted.service
After=zfs-mount-encrypted.service pve-guests.service
ConditionPathExists=/usr/local/sbin/zfs-start-encrypted-guests.sh
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/zfs-start-encrypted-guests.sh
# Type=oneshot defaults to TimeoutStartSec=infinity, so a hung guest start
# would stay "activating" forever and never be retried.
TimeoutStartSec=5min
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
