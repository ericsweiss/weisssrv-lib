#!/bin/bash
# {{ ansible_managed }}
#
# Starts the Proxmox guests whose disks live on an encrypted pool, gated on
# zfs-mount-encrypted.service being ACTIVE — which only happens once every
# encryption root reports keystatus=available and `zfs mount -a` succeeded, so
# the encrypted zvol device nodes backing the VM disks exist.
#
# Guests WITHOUT encrypted disks are deliberately kept out of the cohort so
# they start on their normal onboot path (e.g. an etcd node whose cluster
# quorum must not wait on this host's unlock).
#
# Already-running guests are skipped. So are guests whose config does not exist
# yet: a VMID/CTID may be wired into inventory before the guest is provisioned,
# and `qm start`/`pct start` on a missing guest would wedge this oneshot in a
# permanent, silent Restart=on-failure loop (StartLimitIntervalSec=0).
#
# Exit codes:
#   0 — storage ready; every configured guest is running or not provisioned yet
#   1 — storage not ready, OR a guest start failed. Non-zero lets
#       Restart=on-failure re-attempt so a transient qm/pct race self-heals;
#       the already-running guard keeps retries idempotent.

set -uo pipefail

log() { logger -t "zfs-start-encrypted-guests" -s -- "$*"; }

VMIDS=({{ zfs_encryption_guest_vmids | default([]) | map('string') | join(' ') }})
CTIDS=({{ zfs_encryption_guest_ctids | default([]) | map('string') | join(' ') }})

# NOTE: bash array-LENGTH syntax is deliberately avoided here — its brace+hash
# sequence is read as a Jinja comment opener during templating. "${arr[*]}"
# expands to "" for an empty array, so -z is an equivalent emptiness test.
if [ -z "${VMIDS[*]}" ] && [ -z "${CTIDS[*]}" ]; then
    log "no encrypted-storage guests configured; nothing to do"
    exit 0
fi

# Gate on the mount anchor: active <=> all keys loaded + datasets mounted
# (so the VM-disk zvol device nodes exist too).
if ! systemctl is-active --quiet zfs-mount-encrypted.service; then
    log "zfs-mount-encrypted.service not active yet; encrypted storage not ready, will retry"
    exit 1
fi

# Let udev finish creating the encrypted zvol device nodes before qm start
# touches them (key-load triggers async /dev/zvol symlink creation).
udevadm settle --timeout=30 || true

start_failed=0

for vm in "${VMIDS[@]}"; do
    if ! qm config "$vm" >/dev/null 2>&1; then
        log "VM $vm not provisioned yet; skipping (will start once it exists)"
        continue
    fi
    if qm status "$vm" 2>/dev/null | grep -q running; then
        log "VM $vm already running"
        continue
    fi
    if qm start "$vm"; then
        log "started VM $vm"
    else
        log "qm start $vm failed; will retry the unit"
        start_failed=1
    fi
done

for ct in "${CTIDS[@]}"; do
    if ! pct config "$ct" >/dev/null 2>&1; then
        log "CT $ct not provisioned yet; skipping (will start once it exists)"
        continue
    fi
    if pct status "$ct" 2>/dev/null | grep -q running; then
        log "CT $ct already running"
        continue
    fi
    if pct start "$ct"; then
        log "started CT $ct"
    else
        log "pct start $ct failed; will retry the unit"
        start_failed=1
    fi
done

# Exit non-zero on any start failure so Restart=on-failure re-attempts the
# laggards (idempotent via the grep-running guard above).
if [ "$start_failed" -ne 0 ]; then
    exit 1
fi

exit 0
