#!/bin/bash
# {{ ansible_managed }}
# Starts the Proxmox guests whose disks live on an encrypted pool, gated on
# zfs-mount-encrypted.service. Exits and skips: README, "Boot ordering".

set -uo pipefail

log() { logger -t "zfs-start-encrypted-guests" -s -- "$*"; }

VMIDS=({{ zfs_encryption_guest_vmids | default([]) | map('string') | join(' ') }})
CTIDS=({{ zfs_encryption_guest_ctids | default([]) | map('string') | join(' ') }})

# NOTE: bash array-LENGTH syntax is deliberately avoided here - its brace+hash
# sequence is read as a Jinja comment opener during templating. "${arr[*]}"
# expands to "" for an empty array, so -z is an equivalent emptiness test.
if [ -z "${VMIDS[*]}" ] && [ -z "${CTIDS[*]}" ]; then
    log "no encrypted-storage guests configured; nothing to do"
    exit 0
fi

# Gate on the mount anchor: active <=> all keys loaded + datasets mounted
# (so the VM-disk zvol device nodes exist too).
if ! systemctl is-active --quiet zfs-mount-encrypted.service; then
    log "zfs-mount-encrypted.service not active yet; encrypted storage not ready, will retry"
    exit 1
fi

# Guest configs live in pmxcfs. Without it every guest below would read as
# "not provisioned" and be skipped silently, so refuse and let the unit retry.
if ! mountpoint -q /etc/pve; then
    log "pmxcfs (/etc/pve) not mounted; cannot enumerate guests, will retry"
    exit 1
fi

# Let udev finish creating the encrypted zvol device nodes before qm start
# touches them (key-load triggers async /dev/zvol symlink creation).
udevadm settle --timeout=30 || true

start_failed=0

# The config path is the provisioning test: a `qm`/`pct` config probe is also
# non-zero on a transient error, which would skip a real guest and still exit 0.
for vm in "${VMIDS[@]}"; do
    if [ ! -f "/etc/pve/qemu-server/${vm}.conf" ]; then
        log "VM $vm not provisioned yet; skipping (will start once it exists)"
        continue
    fi
    if qm status "$vm" 2>/dev/null | grep -q running; then
        log "VM $vm already running"
        continue
    fi
    if qm start "$vm"; then
        log "started VM $vm"
    else
        log "qm start $vm failed; will retry the unit"
        start_failed=1
    fi
done

for ct in "${CTIDS[@]}"; do
    if [ ! -f "/etc/pve/lxc/${ct}.conf" ]; then
        log "CT $ct not provisioned yet; skipping (will start once it exists)"
        continue
    fi
    if pct status "$ct" 2>/dev/null | grep -q running; then
        log "CT $ct already running"
        continue
    fi
    if pct start "$ct"; then
        log "started CT $ct"
    else
        log "pct start $ct failed; will retry the unit"
        start_failed=1
    fi
done

# Non-zero on any start failure so Restart=on-failure re-attempts the laggards.
if [ "$start_failed" -ne 0 ]; then
    exit 1
fi

exit 0
