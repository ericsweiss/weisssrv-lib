# {{ ansible_managed }}

# CRITICAL: never add Before= or RequiredBy=zfs-mount.service — those edges
# close an ordering cycle and put a network-dependent unlock in the early
# local-fs path.

# Loads one pool's ZFS encryption key at boot. Instance name is the pool; its
# key locator comes from /etc/zfs/encryption/pools/<pool>.conf. Ordering and
# retry budget: role README.

[Unit]
Description=Load ZFS encryption key for %i
DefaultDependencies=no
Conflicts=shutdown.target
Wants=network-online.target
After=zfs-import.target network-online.target
Before=shutdown.target
ConditionPathExists=/etc/zfs/encryption/pools/%i.conf
# StartLimit* belong in [Unit] (not [Service]) since systemd 230 — placing
# them in [Service] silently drops them.
StartLimitIntervalSec=3600s
StartLimitBurst=60

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/zfs/encryption/pools/%i.conf
ExecStart=/usr/local/sbin/zfs-load-key.sh %i
Restart=on-failure
RestartSec=30s
# Stop retrying only on operator-config errors (codes: zfs-load-key.sh). rc=2
# (key source unavailable) and rc=5 (pool not imported yet) are absent: both
# resolve on their own during a cold-cluster boot.
RestartPreventExitStatus=1 3 4 7

# Hardening
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run /var/log
NoNewPrivileges=yes
PrivateTmp=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
# glibc's getaddrinfo() opens a NETLINK_ROUTE socket for AI_ADDRCONFIG, which a
# networked key fetch needs at cold boot.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native

[Install]
# The enable symlink lands under /etc/systemd/system, so a zfsutils-linux
# upgrade leaves it intact.
WantedBy=zfs-mount-encrypted.service
