# {{ ansible_managed }}
#
# Loads one pool's ZFS encryption key from 1Password Connect at boot. Instance
# name is the pool name; its 1P item title comes from
# /etc/zfs/encryption/pools/<pool>.conf.
#
# Ordering keeps the unlock OFF the boot-blocking path (README "Cold-cluster
# boot"). The load-bearing edges:
#   - After=zfs-import.target: the pool must be imported first.
#   - After/Wants=network-online.target: Connect runs in k8s. This edge is only
#     legal because the unit is NOT Before=zfs-mount — that combination closed
#     an ordering cycle (zfs-mount -> local-fs -> network-online).
#   - No Before=/RequiredBy=zfs-mount.service: stock zfs-mount still runs early
#     and `zfs mount -a` just skips locked datasets, so boot reaches multi-user
#     (ssh + Tailscale) whether or not the unlock ever succeeds.
#   - WantedBy (not RequiredBy) zfs-mount-encrypted.service: one pool failing
#     to unlock must not fail the anchor, the other pool, or any boot target.
#
# Retry math: every retryable path (pool wait, then three sequential Connect
# lookups — vault, item-id, item-field) burns a full fetch_timeout (default
# 120s) before exiting, so worst case is ~480s + RestartSec — far under
# StartLimitBurst=60 per 3600s. The unit therefore retries forever on those.
# The one fast-fail is exit 5 (the `zfs get encryptionroot` enumeration failure
# in zfs-load-key.sh), which fires right after a successful fetch and so trips
# the burst limit in ~30 min — the intended "misconfiguration eventually
# surfaces as failed" behaviour, not a boot hang. An operator `zfs load-key`
# short-circuits the script on the next ExecStart and the unit goes active.

[Unit]
Description=Load ZFS encryption key for %i from 1Password Connect
DefaultDependencies=no
Conflicts=shutdown.target
Wants=network-online.target
After=zfs-import.target network-online.target
Before=shutdown.target
ConditionPathExists=/etc/zfs/encryption/pools/%i.conf
# StartLimit* belong in [Unit] (not [Service]) since systemd 230 — placing
# them in [Service] silently drops them.
StartLimitIntervalSec=3600s
StartLimitBurst=60

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/zfs/encryption/pools/%i.conf
ExecStart=/usr/local/sbin/zfs-load-key.sh %i
Restart=on-failure
RestartSec=30s
# Operator-config errors that won't fix by retrying:
#   1 — config/arg/token error
#   3 — vault/item/field not found
#   4 — `zfs load-key` failed (wrong passphrase, kernel rejected key) —
#       rotated 1P passphrase that no longer matches the on-pool wrapping
#       key falls here; retrying 60×/hour scrolls journald without ever
#       surfacing the real problem.
#   7 — Connect rejected token (401/403)
# rc=2 (Connect unreachable beyond fetch_timeout) is intentionally absent
# from this list — that's the cold-cluster boot case where Connect just
# isn't up yet, and we DO want the unit to keep retrying.
# rc=5 (pool not imported) is also intentionally absent — pool import
# may genuinely arrive later in the boot sequence.
RestartPreventExitStatus=1 3 4 7

# Hardening
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run /var/log
NoNewPrivileges=yes
PrivateTmp=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
# AF_NETLINK is needed by glibc's getaddrinfo() for AI_ADDRCONFIG (it
# opens a NETLINK_ROUTE socket to inspect routable address families).
# Restricting it on some glibc versions causes curl's DNS resolution of
# the Connect endpoint to fail at cold boot.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native

[Install]
# The enable symlink lands in
# /etc/systemd/system/zfs-mount-encrypted.service.wants/, which is
# operator-managed (under /etc, not /lib), so a zfsutils-linux upgrade leaves
# it intact. The role also sweeps the stale
# zfs-mount.service.requires/zfs-load-key@*.service links from the old
# RequiredBy= form — `systemctl disable` only removes the current link.
WantedBy=zfs-mount-encrypted.service
