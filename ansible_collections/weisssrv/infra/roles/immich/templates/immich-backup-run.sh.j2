#!/usr/bin/env bash
# {{ ansible_managed }}
# Nightly Immich database dump into the backup landing zone, with
# immich_backup_* textfile metrics for freshness alerting.

# No `set -e`: the dump's exit code must be captured and the metric written.
set -uo pipefail

COMPOSE_DIR="{{ immich_compose_dir }}"
BACKUP_DIR="{{ immich_backup_dir }}"
KEEP_DAYS="{{ immich_backup_keep_days }}"
DB_USER="{{ immich_db_username }}"
PROM_DIR="{{ immich_backup_metrics_dir }}"
# 1 when the landing zone is the NFS export (immich_backup_nfs_enabled).
NFS_ENABLED="{{ '1' if (immich_backup_nfs_enabled | bool) else '0' }}"

METRICS_LIB="{{ immich_backup_lib_path }}"
# Hard gate: without the lib, write_prom_metrics is undefined and the run would
# proceed metric-less — refuse instead.
if [ ! -r "$METRICS_LIB" ]; then
  echo "immich-backup: metrics library $METRICS_LIB missing — re-run the immich role" >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$METRICS_LIB"
{% raw %}
PROM_FILE="${PROM_DIR}/immich_backup.prom"
START_TS="$(date +%s)"
DUMP_FILE="${BACKUP_DIR}/immich-$(date +%Y%m%d-%H%M%S).sql.gz"
# Stream to .partial and rename in only after the size check: collectors key on
# the final name.
DUMP_TMP="${DUMP_FILE}.partial"
# Best-effort cleanup; the post-retention .partial sweep covers a SIGKILL.
trap 'rm -f -- "$DUMP_TMP"' EXIT
# Matches the final name only, so a .partial is never sized as a healthy artefact.
ARTIFACT_GLOB="${BACKUP_DIR}/immich-*.sql.gz"

mkdir -p "$PROM_DIR"

require_mounted_landing_zone immich_backup "$BACKUP_DIR" "$NFS_ENABLED" "$PROM_FILE" || exit 1
mkdir -p "$BACKUP_DIR"

# pg_dumpall via the compose `database` service. -T disables the pseudo-TTY
# (required under systemd/cron). Runs as the container's postgres OS user over
# the local socket, so no password is needed.
docker compose --project-directory "$COMPOSE_DIR" exec -T database \
  pg_dumpall --clean --if-exists "--username=${DB_USER}" \
  | gzip > "$DUMP_TMP"
rc=$?

# Publish only a validated dump: rc 0 and at least 1000 bytes, then rename.
size=0
if [ "$rc" -eq 0 ] && [ -f "$DUMP_TMP" ]; then
  size="$(stat -c %s "$DUMP_TMP" 2>/dev/null || echo 0)"
  if [ "$size" -lt 1000 ]; then
    rc=1
  elif ! mv -f -- "$DUMP_TMP" "$DUMP_FILE"; then
    rc=1
  fi
fi

if [ "$rc" -ne 0 ]; then
  size=0
  rm -f -- "$DUMP_TMP"
fi

# Prune only after a success, and sweep .partial files a SIGKILL left behind.
if [ "$rc" -eq 0 ]; then
  find "$BACKUP_DIR" -maxdepth 1 -name 'immich-*.sql.gz' -type f -mtime "+${KEEP_DAYS}" -delete 2>/dev/null || true
  find "$BACKUP_DIR" -maxdepth 1 -name 'immich-*.sql.gz.partial' -type f -mtime +1 -delete 2>/dev/null || true
fi

end_ts="$(date +%s)"
duration=$(( end_ts - START_TS ))
if [ "$rc" -eq 0 ]; then
  write_prom_metrics immich_backup 1 "$duration" "$size" "$PROM_FILE" "$ARTIFACT_GLOB"
else
  write_prom_metrics immich_backup 0 "$duration" "$size" "$PROM_FILE" "$ARTIFACT_GLOB"
fi

exit "$rc"
{% endraw %}
