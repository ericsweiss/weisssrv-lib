#!/usr/bin/env bash
# {{ ansible_managed }}
# Nightly Immich database backup: pg_dumpall from the compose `database`
# service, gzipped into the backup landing zone. Emits node_exporter textfile
# metrics (immich_backup_*) for freshness alerting; the metric-writing logic is
# the shared write_prom_metrics helper, sourced below.
#
# NOT `set -e`: the dump's exit code must be captured and the metric written
# regardless. pipefail so a pg_dumpall failure isn't masked by a succeeding
# gzip. The wrapper preserves the prior success timestamp on failure so
# staleness measures time-since-last-success.
set -uo pipefail

COMPOSE_DIR="{{ immich_compose_dir }}"
BACKUP_DIR="{{ immich_backup_dir }}"
KEEP_DAYS="{{ immich_backup_keep_days }}"
DB_USER="{{ immich_db_username }}"
PROM_DIR="{{ immich_backup_metrics_dir }}"
# 1 when the landing zone is the NFS export (immich_backup_nfs_enabled).
NFS_ENABLED="{{ '1' if (immich_backup_nfs_enabled | bool) else '0' }}"

# Hard gate (no set -e here): without the lib, write_prom_metrics is
# undefined and the run would proceed metric-less — refuse instead.
# shellcheck source=/dev/null
if ! source {{ immich_backup_lib_path }}; then
  echo "immich-backup: missing backup metrics library {{ immich_backup_lib_path }}" >&2
  exit 1
fi
{% raw %}
PROM_FILE="${PROM_DIR}/immich_backup.prom"
START_TS="$(date +%s)"
DUMP_FILE="${BACKUP_DIR}/immich-$(date +%Y%m%d-%H%M%S).sql.gz"
# The dump streams into a .partial name and is renamed into DUMP_FILE only once
# the pipeline AND the size check passed. The FINAL name is what the NAS
# artefact collector and the offsite file walk key on, so it must only ever
# appear complete: writing straight to it publishes an in-progress dump as
# tonight's backup, and a killed run leaves a truncated one there indefinitely.
# `.partial` is excluded by the collector (and by ARTIFACT_GLOB below), and the
# rename is atomic within the same directory.
DUMP_TMP="${DUMP_FILE}.partial"
# Best-effort cleanup on an interrupted run (a SIGKILL cannot fire it — the
# stale-partial sweep after retention covers that).
trap 'rm -f -- "$DUMP_TMP"' EXIT
# Matches the final name only, so an in-progress .partial can never be sized as
# a healthy artefact (see write_prom_metrics).
ARTIFACT_GLOB="${BACKUP_DIR}/immich-*.sql.gz"

mkdir -p "$PROM_DIR"

# Fail closed on an unmounted landing zone: when NFS-backed, BACKUP_DIR is the
# mountpoint; if the mount is missing, writing there would land the dump on the
# root disk's mountpoint dir — silently un-offsited. Refuse, record success=0,
# and exit non-zero BEFORE dumping.
if [ "$NFS_ENABLED" = "1" ] && ! mountpoint -q "$BACKUP_DIR"; then
  echo "immich-backup: BACKUP_DIR ${BACKUP_DIR} is NFS-backed but not mounted — aborting" >&2
  # No ARTIFACT_GLOB on the fail-closed path (see write_prom_metrics).
  write_prom_metrics immich_backup 0 0 0 "$PROM_FILE"
  exit 1
fi
mkdir -p "$BACKUP_DIR"

# pg_dumpall via the compose `database` service. -T disables the pseudo-TTY
# (required under systemd/cron). Runs as the container's postgres OS user over
# the local socket, so no password is needed.
docker compose --project-directory "$COMPOSE_DIR" exec -T database \
  pg_dumpall --clean --if-exists "--username=${DB_USER}" \
  | gzip > "$DUMP_TMP"
rc=$?

# Validate the dump: rc 0 with a plausibly-sized file. A truncated/empty gzip
# (e.g. the container was mid-restart) must NOT report a healthy backup — and
# must never be published under the final name, so the rename is the LAST step
# and only a validated dump reaches it.
size=0
if [ "$rc" -eq 0 ] && [ -f "$DUMP_TMP" ]; then
  size="$(stat -c %s "$DUMP_TMP" 2>/dev/null || echo 0)"
  if [ "$size" -lt 1000 ]; then
    rc=1
  elif ! mv -f -- "$DUMP_TMP" "$DUMP_FILE"; then
    rc=1
  fi
fi

if [ "$rc" -ne 0 ]; then
  # Only the .partial can exist here: DUMP_FILE is created by the rename above,
  # which is the last thing that can fail (and leaves the .partial in place).
  size=0
  rm -f -- "$DUMP_TMP"
fi

# Prune old dumps only after a successful run (never delete the last good copy
# because a fresh run failed).
if [ "$rc" -eq 0 ]; then
  find "$BACKUP_DIR" -name 'immich-*.sql.gz' -type f -mtime "+${KEEP_DAYS}" -delete 2>/dev/null || true
  # Retention matches the FINAL name only, so a SIGKILLed run's .partial would
  # otherwise sit in the landing zone forever.
  find "$BACKUP_DIR" -name 'immich-*.sql.gz.partial' -type f -mtime +1 -delete 2>/dev/null || true
fi

end_ts="$(date +%s)"
duration=$(( end_ts - START_TS ))
if [ "$rc" -eq 0 ]; then
  write_prom_metrics immich_backup 1 "$duration" "$size" "$PROM_FILE" "$ARTIFACT_GLOB"
else
  write_prom_metrics immich_backup 0 "$duration" "$size" "$PROM_FILE" "$ARTIFACT_GLOB"
fi

exit "$rc"
{% endraw %}
