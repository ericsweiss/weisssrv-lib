# {{ ansible_managed }}
# Compose environment for the Immich stack; holds DB_PASSWORD.

UPLOAD_LOCATION={{ immich_upload_location }}
DB_DATA_LOCATION={{ immich_db_data_location }}

TZ={{ immich_timezone }}

# CRITICAL: DB_PASSWORD is double-quoted with backslash, quote and dollar
# escaped; an unquoted value is $-interpolated by the compose-go dotenv parser
# and a password holding `$name` is silently rewritten. See README.
DB_PASSWORD="{{ immich_db_password | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') }}"
DB_USERNAME={{ immich_db_username }}
DB_DATABASE_NAME={{ immich_db_database_name }}
