{# {{ ansible_managed }} — rendered by the immich role (no_log; contains the OIDC client secret). #}
{#
  IMMICH_CONFIG_FILE: a partial override that makes the admin UI settings
  read-only. immich_bootstrap_mode true opens passwordLogin for the one-time
  admin signup; false is SSO-only. See the role README.
#}
{% set bootstrap = immich_bootstrap_mode | bool %}
{% set _quota = immich_oauth_default_storage_quota | string %}
{% set quota = (_quota | int) if (_quota | length > 0) else none %}
{{ {
  "passwordLogin": {
    "enabled": bootstrap
  },
  "oauth": {
    "enabled": (not bootstrap),
    "issuerUrl": immich_oauth_issuer_url,
    "clientId": immich_oauth_client_id,
    "clientSecret": immich_oauth_client_secret,
    "scope": immich_oauth_scope,
    "signingAlgorithm": "RS256",
    "profileSigningAlgorithm": "none",
    "storageLabelClaim": immich_oauth_storage_label_claim,
    "storageQuotaClaim": "immich_quota",
    "defaultStorageQuota": quota,
    "buttonText": immich_oauth_button_text,
    "autoRegister": (immich_oauth_auto_register | bool),
    "autoLaunch": ((immich_oauth_auto_launch | bool) and not bootstrap),
    "mobileOverrideEnabled": false,
    "mobileRedirectUri": ""
  },
  "machineLearning": {
    "enabled": true,
    "urls": immich_ml_urls
  },
  "backup": {
    "database": {
      "enabled": (immich_builtin_db_backup_enabled | bool)
    }
  },
  "server": {
    "externalDomain": immich_external_url
  }
} | to_nice_json }}
