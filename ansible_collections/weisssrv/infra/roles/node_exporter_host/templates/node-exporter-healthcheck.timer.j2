# {{ ansible_managed }}
# Fires node-exporter-healthcheck.service every {{ node_exporter_host_healthcheck_interval }}.
# OnUnitInactiveSec counts from the previous run finishing, so a failed probe re-arms.
[Unit]
Description=Periodically verify prometheus-node-exporter is answering scrapes

[Timer]
OnBootSec={{ node_exporter_host_healthcheck_interval }}
OnUnitInactiveSec={{ node_exporter_host_healthcheck_interval }}
AccuracySec=30s
Unit=node-exporter-healthcheck.service

[Install]
WantedBy=timers.target
