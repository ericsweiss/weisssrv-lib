# {{ ansible_managed }}
# Overrides the packaged unit: port {{ node_exporter_host_port }}, the textfile
# directory, and the systemd collector. Metrics are unauthenticated plain HTTP.

[Service]
{# {% if %} tags carry the next line's text: a blank line inside the \ continuation breaks ExecStart. #}
ExecStart=
ExecStart=/usr/bin/prometheus-node-exporter \
  --web.listen-address={{ _node_exporter_host_listen }}:{{ node_exporter_host_port }} \
  --collector.hwmon \
  --collector.thermal_zone \
{% if node_exporter_host_systemd_collector | bool %}  --collector.systemd \
  --collector.systemd.unit-include={{ node_exporter_host_systemd_unit_include }} \
  --collector.systemd.unit-exclude={{ node_exporter_host_systemd_unit_exclude }} \
  --collector.systemd.enable-restarts-metrics \
{% endif %}{% if node_exporter_host_processes_collector | bool %}  --collector.processes \
{% endif %}  --collector.textfile \
  --collector.textfile.directory={{ node_exporter_host_textfile_dir }}
