# Secrets / local env — never commit these
.env
.env.*
*.env
.tmp/

# Python — build-artifact dirs are anchored to the repo root so `build/` cannot
# match real content like ci/build/.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
/build/
/dist/
# `pip install ./cli` builds here, outside the anchored patterns above.
/cli/build/
/cli/dist/

# CI job artifact: version-check-ci.py's default report.
version-report.json

# Terraform — init/state artifacts. Reusable modules deliberately do NOT commit
# a .terraform.lock.hcl: the lockfile belongs to the consuming root module.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
tfplan

# Editor / OS cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ansible caches (ansible-lint/molecule local runs; CI uses ANSIBLE_HOME=.ansible-home)
.ansible/
.ansible-home/

# ansible-galaxy collection build writes these into the source dir.
ansible_collections/**/MANIFEST.json
ansible_collections/**/FILES.json
