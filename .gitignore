# Secrets / local env — never commit these
.env
.env.*
*.env
.tmp/

# Python — anchor the build-artifact dirs to the repo root so they cannot match
# real content like ci/build/ (an unanchored `build/` gitignored the DinD build
# template `ci/build/docker-build.yml`).
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
/build/
/dist/
# `pip install ./cli` builds here, and the anchored patterns above miss it.
/cli/build/
/cli/dist/

# CI job artifacts — version-check-ci.py's default report (also produced by a
# local run of the wrapper). Unanchored: no real content carries this name.
version-report.json

# Terraform — init/state artifacts. Reusable modules deliberately do NOT commit
# a .terraform.lock.hcl: the lockfile belongs to the consuming root module.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
tfplan

# Editor / OS cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ansible caches (ansible-lint/molecule local runs; CI uses ANSIBLE_HOME=.ansible-home)
.ansible/
.ansible-home/

# ansible-galaxy collection build writes these INTO the source dir when run
# against it; they are packaging output, never repo content.
ansible_collections/**/MANIFEST.json
ansible_collections/**/FILES.json
